---
import '../../styles/global.css';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Contact from '../../components/Contact.astro';
import TestimonialCarousel from '../../components/TestimonialCarousel.astro';
import Lightbox from '../../components/Lightbox.astro';
import circleCheckIcon from 'lucide-static/icons/circle-check.svg?raw';
import languagesIcon from 'lucide-static/icons/languages.svg?raw';
import houseIcon from 'lucide-static/icons/house.svg?raw';
import clockIcon from 'lucide-static/icons/clock.svg?raw';
import phoneIcon from 'lucide-static/icons/phone.svg?raw';

const differentiators = [
	{ text: "Consultas gratuitas en todos los casos de lesiones personales", icon: circleCheckIcon },
	{ text: "Personal bilingüe — atención en español disponible", icon: languagesIcon },
	{ text: "Visitas a domicilio y al hospital disponibles", icon: houseIcon },
	{ text: "Consultas los fines de semana y por las noches", icon: clockIcon },
];

const team = [
	{
		name: "Eric R. Blank",
		title: "Abogado Fundador",
		photo: "/Eric_Blank_01.jpg",
		initials: "ERB",
		bio: "Con más de 26 años de experiencia, Eric comenzó su carrera defendiendo a compañías de seguros antes de dedicar su práctica por completo a las víctimas de accidentes. Hoy usa ese conocimiento interno para luchar por las personas a quienes esas compañías intentan pagar de menos.",
		bioUrl: "https://ericblanklaw.com/es/abogados/eric-blank/",
	},
	{
		name: "Fikisha Miller",
		title: "Abogada",
		photo: null,
		initials: "FM",
		bio: "Fikisha Miller representa a víctimas de accidentes en todo el valle de Las Vegas. Graduada de Howard University y de Tulane Law School, aporta más de 20 años de experiencia y alrededor de 30 juicios con jurado en defensa penal y lesiones personales.",
		bioUrl: "https://ericblanklaw.com/es/abogados/fikisha-miller/",
	},
];
---

<html lang="es">
	<head>
		<BaseHead
			title="Sobre Eric Blank Injury Attorneys | Firma de Lesiones Personales en Las Vegas"
			description="Conozca a los abogados de lesiones personales de Eric Blank Injury Attorneys en Las Vegas. Más de 26 años de experiencia. Ex abogado de defensa de aseguradoras que ahora lucha por las víctimas de accidentes. Llame al (702) 222-2115."
			canonical="https://ericblanklaw.com/es/sobre-nosotros"
			lang="es"
		/>
	</head>
	<body class="overflow-x-clip">
		<Header lang="es" />
		<main>
			<!-- A: page hero -->
			<section class="relative bg-brand-navy text-white">
				<div class="absolute inset-0 bg-cover bg-center" style="background-image:url('/about-hero.jpg')" aria-hidden="true"></div>
				<div class="absolute inset-0 bg-brand-navy/75" aria-hidden="true"></div>
				<div class="relative mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:py-24">
					<p class="text-sm font-semibold tracking-wider text-brand-gold uppercase">
						Sobre Nuestra Firma
					</p>
					<h1 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-5xl">
						Abogados de Lesiones Personales en Las Vegas
					</h1>
					<p class="mx-auto mt-4 max-w-2xl text-base text-pretty text-white/70 sm:text-lg">
						Por más de dos décadas, Eric Blank Injury Attorneys ha luchado por las víctimas
						de accidentes en todo Las Vegas y el Condado de Clark — desde Henderson hasta
						Boulder City, de Pahrump al Condado de Nye. Hemos obtenido veredictos y acuerdos
						significativos para personas gravemente lesionadas por la negligencia de otros, y
						hemos construido una reputación que las compañías de seguros toman en serio.
					</p>
				</div>
			</section>

			<!-- B: firm story -->
			<section class="bg-white">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-28">
					<div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-start lg:gap-16">
						<div>
							<h2 class="text-3xl font-bold tracking-tight text-brand-navy sm:text-4xl">
								Por Qué Hacemos Este Trabajo
							</h2>
							<div class="mt-6 space-y-4 text-base leading-relaxed text-pretty text-gray-600">
								<p>
									Eric Blank no empezó representando a víctimas de accidentes. Pasó la
									primera parte de su carrera del otro lado — trabajando en defensa de
									aseguradoras y como asesor jurídico general de afiliadas locales de
									televisión.
								</p>
								<p>
									Esa experiencia cambió su forma de ejercer el derecho. Sabe exactamente
									cómo las compañías de seguros evalúan los reclamos, dónde buscan
									debilidades y las estrategias que usan para pagarles a las víctimas lo
									menos posible.
								</p>
								<p>
									También sabe algo que la mayoría de los clientes nunca escucha: las
									compañías de seguros toman en cuenta quién lo representa cuando deciden
									si llegar a un acuerdo justo o arrastrar el caso hacia un juicio. La
									firma correcta cambia la ecuación.
								</p>
							</div>
						</div>
						<div class="rounded-2xl border border-brand-navy/15 bg-white p-8">
							<h3 class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
								Lo Que Nos Distingue
							</h3>
							<ul class="mt-5 space-y-4">
								{
									differentiators.map((item) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-6"
												set:html={item.icon}
												aria-hidden="true"
											/>
											<span class="text-base text-gray-700">{item.text}</span>
										</li>
									))
								}
							</ul>
						</div>
					</div>
				</div>
			</section>

			<!-- C: meet the team -->
			<section class="bg-gray-50" aria-labelledby="team-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-28">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Su Equipo Legal
						</p>
						<h2
							id="team-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Los Abogados Que Luchan Por Usted
						</h2>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:mt-16 max-w-3xl mx-auto">
						{
							team.map((member) => (
								<article class="flex flex-col rounded-lg border border-gray-200 bg-white p-6">
									{member.photo ? (
										<img
											src={member.photo}
											alt={member.name}
											width="600"
											height="900"
											loading="lazy"
											class="aspect-[2/3] w-full rounded-lg object-cover object-top"
										/>
									) : (
										<div class="flex aspect-[2/3] w-full items-center justify-center rounded-lg bg-brand-navy">
											<span class="text-4xl font-extrabold tracking-wide text-brand-gold">
												{member.initials}
											</span>
										</div>
									)}
									<h3 class="mt-5 text-xl font-bold text-brand-navy">{member.name}</h3>
									<p class="mt-0.5 text-sm font-semibold tracking-wide text-brand-gold uppercase">
										{member.title}
									</p>
									<p class="mt-3 text-base leading-relaxed text-pretty text-gray-600">
										{member.bio}
									</p>
									<a
										href={member.bioUrl}
										class="mt-auto inline-flex items-center gap-1 pt-5 text-sm font-bold text-brand-navy transition-colors hover:text-brand-gold"
									>
										Lea la Biografía Completa
										<svg
											class="size-4"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
											aria-hidden="true"
										>
											<path d="M5 12h14" />
											<path d="m13 6 6 6-6 6" />
										</svg>
									</a>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<!-- D: CTA -->
			<section class="bg-brand-navy text-white">
				<div class="mx-auto max-w-3xl px-4 py-14 text-center sm:px-6 sm:py-16">
					<h2 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">
						¿Listo para Hablar?
					</h2>
					<p class="mt-3 text-base text-white/70 sm:text-lg">
						Consulta gratuita. Sin honorarios a menos que ganemos.
					</p>
					<a
						href="tel:7022222115"
						class="mt-7 inline-flex items-center gap-3 rounded-lg bg-brand-gold px-8 py-4 text-xl font-extrabold text-brand-navy transition-colors hover:bg-[#d1a63b] sm:text-2xl"
					>
						<span class="[&>svg]:size-6" set:html={phoneIcon} aria-hidden="true" />
						(702) 222-2115
					</a>
					<p class="mt-4 text-sm text-white/60">
						O use el formulario a continuación para{" "}
						<a
							href="#contact"
							class="font-semibold text-white underline decoration-brand-gold decoration-2 underline-offset-4 hover:text-brand-gold"
						>
							solicitar una llamada
						</a>.
					</p>
				</div>
			</section>

			<!-- E: contact form -->
			<!-- Video testimonial carousel -->
			<TestimonialCarousel lang="es" />

			<Contact lang="es" />
		</main>
		<Footer lang="es" />
		<!-- Universal media lightbox (used by the carousel) -->
		<Lightbox />
	</body>
</html>
