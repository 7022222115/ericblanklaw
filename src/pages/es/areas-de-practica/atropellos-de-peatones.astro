---
import '../../../styles/global.css';
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ContactForm from '../../../components/ContactForm.astro';
import TestimonialCarousel from '../../../components/TestimonialCarousel.astro';
import Lightbox from '../../../components/Lightbox.astro';
import { firmNode, attorneyNode } from '../../../data/firm';

import phoneIcon from 'lucide-static/icons/phone.svg?raw';
import shieldIcon from 'lucide-static/icons/shield.svg?raw';
import phoneCallIcon from 'lucide-static/icons/phone-call.svg?raw';
import cameraIcon from 'lucide-static/icons/camera.svg?raw';
import stethoscopeIcon from 'lucide-static/icons/stethoscope.svg?raw';
import banIcon from 'lucide-static/icons/ban.svg?raw';
import scaleIcon from 'lucide-static/icons/scale.svg?raw';
import searchIcon from 'lucide-static/icons/search.svg?raw';
import clipboardListIcon from 'lucide-static/icons/clipboard-list.svg?raw';
import handshakeIcon from 'lucide-static/icons/handshake.svg?raw';
import gavelIcon from 'lucide-static/icons/gavel.svg?raw';
import circleCheckIcon from 'lucide-static/icons/circle-check.svg?raw';
import calendarClockIcon from 'lucide-static/icons/calendar-clock.svg?raw';
import shieldCheckIcon from 'lucide-static/icons/shield-check.svg?raw';
import quoteIcon from 'lucide-static/icons/quote.svg?raw';
import checkCircleIcon from 'lucide-static/icons/check-circle.svg?raw';
import circleDollarSignIcon from 'lucide-static/icons/circle-dollar-sign.svg?raw';
import clockIcon from 'lucide-static/icons/clock.svg?raw';

const title = "Abogado de Atropellos de Peatones en Las Vegas | Eric Blank Injury Attorneys | (702) 222-2115";
const description =
	"¿Atropellado por un auto en Las Vegas? Eric Blank Injury Attorneys ha luchado por peatones lesionados por más de 26 años. Consulta gratuita. Sin honorarios a menos que ganemos. Llame al (702) 222-2115.";

const heroTrust = ["Más de 26 Años", "Millones Recuperados", "Disponibles 24/7", "Consulta Gratuita"];

const stats = [
	{ value: "Millones", label: "Recuperados para Peatones Lesionados" },
	{ value: "Miles", label: "de Casos de Peatones Manejados" },
	{ value: "$0", label: "de Su Bolsillo", note: "Solo honorarios de contingencia" },
	{ value: "24/7", label: "Consulta Gratuita" },
];

const steps = [
	{
		icon: shieldIcon,
		title: "No Se Mueva Si Está Herido",
		text: "Si está gravemente lesionado, quédese donde está — mover a alguien con una posible lesión de columna o pelvis puede empeorarla. Deje que los paramédicos lo evalúen primero. Si puede moverse con seguridad, salga de la calzada.",
	},
	{
		icon: phoneCallIcon,
		title: "Llame al 911",
		text: "Obtenga un informe policial siempre. La Policía Metropolitana responde dentro de Las Vegas; la Patrulla de Carreteras de Nevada, en las autopistas. El informe identifica al conductor, el carril y si usted estaba en un cruce peatonal — cada detalle importa en un caso de atropello.",
	},
	{
		icon: cameraIcon,
		title: "Documente Todo",
		text: "Si puede, fotografíe el vehículo que lo golpeó, su posición, el cruce peatonal o la intersección, las señales y los semáforos, y sus lesiones. Obtenga los datos del seguro y la licencia del conductor, además de los nombres y teléfonos de los testigos.",
	},
	{
		icon: stethoscopeIcon,
		title: "Vea a un Médico",
		text: "Los impactos a peatones producen lesiones graves — lesión cerebral traumática (TBI), sangrado interno, fracturas complejas — que la adrenalina puede ocultar. Hágase una evaluación completa y siga cada recomendación de tratamiento. Los vacíos en el tratamiento son lo primero que las aseguradoras usan en su contra.",
	},
	{
		icon: banIcon,
		title: "No Hable con la Aseguradora del Conductor",
		text: "La aseguradora del conductor llamará en cuestión de días. Le harán preguntas capciosas — ¿Estaba usted en el cruce peatonal? ¿Iba mirando su teléfono? — diseñadas para trasladarle la culpa a usted. Refiéralos a su abogado.",
	},
	{
		icon: scaleIcon,
		title: "Llame Primero a un Abogado",
		text: "Antes de firmar cualquier cosa, dar una declaración grabada o aceptar un acuerdo, hable con un abogado. Las lesiones de peatones suelen ser catastróficas — y las ofertas rápidas casi siempre las subvaloran.",
	},
];

const howWeHelp = [
	{
		icon: searchIcon,
		title: "Investigamos el Accidente",
		text: "Obtenemos los videos de las cámaras de tráfico del Strip, las calles y los negocios cercanos antes de que se sobrescriban, además de fotos de la escena y declaraciones de testigos. El cruce peatonal, el semáforo y las acciones del conductor importan — y los dejamos asegurados.",
	},
	{
		icon: clipboardListIcon,
		title: "Construimos el Expediente Médico",
		text: "Las lesiones de peatones suelen ser graves — lesión cerebral traumática, fracturas, daños internos. Trabajamos con sus médicos para documentar cada lesión, presente y futura, de modo que las aseguradoras no puedan minimizar el daño.",
	},
	{
		icon: handshakeIcon,
		title: "Negociamos con la Aseguradora",
		text: "Eric Blank pasó años del lado de la defensa de las aseguradoras. Sabemos cómo los ajustadores valoran los reclamos de peatones — y cómo intentan rebajarlos. Exigimos la cobertura completa disponible, incluida la de motorista sin seguro / con seguro insuficiente (UM/UIM) de su propia póliza cuando aplica.",
	},
	{
		icon: gavelIcon,
		title: "Llevamos el Caso a Juicio si Hace Falta",
		text: "Las aseguradoras suben sus cifras cuando saben que su abogado se está preparando para ir a juicio. Así preparamos cada caso de atropello.",
	},
];

const economicDamages = [
	"Gastos médicos — tratamiento pasado y futuro",
	"Salarios perdidos y reducción de su capacidad futura de ingresos",
	"Daños materiales a sus pertenencias (teléfono, lentes, ropa)",
	"Gastos de bolsillo — transporte, medicamentos y más",
];

const nonEconomicDamages = [
	"Dolor y sufrimiento",
	"Angustia emocional",
	"Pérdida del disfrute de la vida",
	"Discapacidad o desfiguración permanente",
	"Pérdida de consorcio",
];

const nevadaLaws = [
	{
		icon: calendarClockIcon,
		title: "Plazo de Prescripción",
		text: "Nevada le da 2 años desde la fecha del accidente para presentar una demanda por lesiones de peatón (NRS 11.190). Si pasa ese plazo, su reclamo se pierde — sin importar lo sólido que fuera.",
	},
	{
		icon: scaleIcon,
		title: "Negligencia Comparativa",
		text: "En Nevada, usted no pierde su caso solo por haber tenido parte de la culpa. Siempre que su grado de culpa sea del 50% o menos, aún puede presentar un reclamo, pero su recuperación se reducirá según su porcentaje de culpa. Sin embargo, cuando la otra parte logra llevar su responsabilidad por encima del 50%, la regla de negligencia comparativa modificada de Nevada generalmente le impide recuperar compensación alguna (NRS 41.141).",
	},
	{
		icon: shieldCheckIcon,
		title: "Deber del Conductor y Seguro",
		text: "Los conductores de Nevada deben ceder el paso a los peatones tanto en cruces peatonales marcados como no marcados (NRS 484B.283), y violar ese deber puede conllevar sanciones adicionales cuando un conductor causa un atropello de peatón. Los límites mínimos de responsabilidad del conductor culpable son 25/50/20 — $25,000 por persona, $50,000 por accidente y $20,000 por daños materiales — lo cual generalmente no es suficiente para una lesión grave de peatón. Por eso es crítico tener una sólida cobertura de motorista sin seguro / con seguro insuficiente (UM/UIM) en su propia póliza de auto.",
	},
];

const faqs = [
	{
		q: "¿Los peatones siempre tienen el derecho de paso en Nevada?",
		a: "No siempre — pero en la mayoría de las situaciones que involucran un cruce peatonal, sí. Bajo NRS 484B.283, los conductores deben ceder el paso a los peatones en cruces peatonales marcados y no marcados. Hay límites — un peatón no puede bajarse repentinamente de la acera frente a un vehículo que no puede detenerse — pero el deber legal de estar atento a los peatones y cederles el paso recae directamente en el conductor.",
	},
	{
		q: "¿Qué pasa si yo estaba cruzando fuera de un cruce peatonal?",
		a: "Aún puede recuperar compensación. Nevada usa la negligencia comparativa modificada, así que tener parte de la culpa reduce su recuperación pero no la impide, siempre que su responsabilidad sea del 50% o menos. Los conductores también siguen teniendo un deber de cuidado hacia los peatones fuera de los cruces — no pueden simplemente atropellarlo.",
	},
	{
		q: "¿Cuánto tiempo tengo para presentar un reclamo por atropello de peatón en Nevada?",
		a: "Dos años desde la fecha del accidente, según NRS 11.190. Las acciones por muerte injusta también corren generalmente dos años. No espere — los videos de vigilancia y los recuerdos de los testigos se desvanecen rápido, y los reclamos contra entidades gubernamentales pueden tener plazos de notificación mucho más cortos.",
	},
	{
		q: "¿Qué pasa si el conductor no tiene suficiente seguro?",
		a: "Muchos conductores solo tienen la cobertura mínima de responsabilidad de 25/50/20 de Nevada — que rara vez cubre el costo completo de una lesión grave de peatón. Analizamos cada fuente de recuperación disponible, incluida la cobertura de motorista sin seguro / con seguro insuficiente (UM/UIM) de su propia póliza de auto, que puede aplicar aunque usted iba caminando y no en un auto al momento del accidente. También investigamos pólizas paraguas y cualquier cobertura comercial o del empleador cuando el conductor estaba trabajando al momento del atropello.",
	},
	{
		q: "¿Qué pasa si el conductor estaba trabajando — para una empresa de viajes compartidos, un servicio de entregas o un empleador?",
		a: "Si el conductor estaba en horario de trabajo, el seguro del empleador también puede ser responsable. Los conductores de viajes compartidos y de entregas suelen tener cobertura comercial adicional que aplica mientras trabajan. Perseguimos cada fuente.",
	},
	{
		q: "¿Cuánto cuesta contratar a un abogado de atropellos de peatones?",
		a: "Nuestros honorarios son de contingencia — sin costo inicial y sin cobro por hora. Solo nos pagan si ganamos, y el honorario es un porcentaje de su recuperación, pactado por escrito antes de empezar.",
	},
];

const contactReasons = [
	{ text: "Evaluación de caso gratuita y sin compromiso", icon: checkCircleIcon },
	{ text: "Sin honorarios a menos que ganemos su caso", icon: circleDollarSignIcon },
	{ text: "Disponibles 24/7 — noches, fines de semana y días festivos", icon: clockIcon },
];

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		firmNode,
		{
			"@type": "LegalService",
			"@id": "https://ericblanklaw.com/es/areas-de-practica/atropellos-de-peatones#service",
			name: "Eric Blank Injury Attorneys — Representación en Atropellos de Peatones",
			serviceType: "Servicios Legales de Atropellos de Peatones",
			url: "https://ericblanklaw.com/es/areas-de-practica/atropellos-de-peatones",
			image: "https://ericblanklaw.com/Eric_Blank_Injury_Attorneys_Logo.png",
			priceRange: "Honorarios de Contingencia — Sin Honorarios a Menos Que Ganemos",
			inLanguage: "es",
			provider: { "@id": "https://ericblanklaw.com/#legalservice" },
			employee: { "@id": "https://ericblanklaw.com/#attorney" },
		},
		attorneyNode,
		{
			"@type": "FAQPage",
			"@id": "https://ericblanklaw.com/es/areas-de-practica/atropellos-de-peatones#faq",
			inLanguage: "es",
			mainEntity: faqs.map((faq) => ({
				"@type": "Question",
				name: faq.q,
				acceptedAnswer: { "@type": "Answer", text: faq.a },
			})),
		},
	],
};
---

<html lang="es">
	<head>
		<BaseHead
			title={title}
			description={description}
			canonical="https://ericblanklaw.com/es/areas-de-practica/atropellos-de-peatones"
			lang="es"
		/>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body class="overflow-x-clip">
		<Header lang="es" />
		<main>
			<!-- SECTION 1 — Hero -->
			<section class="relative bg-brand-navy text-white">
				<div class="absolute inset-0 bg-cover bg-center" style="background-image:url('/pedestrian-accidents-hero.jpeg')" aria-hidden="true"></div>
				<div class="absolute inset-0 bg-brand-navy/75" aria-hidden="true"></div>
				<div class="relative mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:py-24">
					<p class="text-sm font-semibold tracking-wider text-brand-gold uppercase">
						Atropellos de Peatones en Las Vegas
					</p>
					<h1 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-5xl">
						Abogado de Atropellos de Peatones en Las Vegas
					</h1>
					<p class="mx-auto mt-4 max-w-2xl text-base text-pretty text-white/70 sm:text-lg">
						El Strip de Las Vegas es uno de los tramos de calle con más peatones del país, e
						incluso fuera del corredor de los casinos, caminar en este valle significa
						compartir el espacio con conductores cansados, distraídos o que no conocen la
						zona. Cuando un conductor no cede el paso, la persona a pie paga el precio — a
						menudo de forma catastrófica. Por más de 26 años, Eric Blank Injury Attorneys ha
						enfrentado a las compañías de seguros en nombre de peatones lesionados. Consulta
						gratuita, y sin honorarios a menos que ganemos.
					</p>
					<div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
						<a
							href="#contact"
							class="inline-flex w-full items-center justify-center rounded-md bg-brand-gold px-8 py-4 text-base font-bold text-brand-navy transition-colors hover:bg-[#d1a63b] sm:w-auto sm:text-lg"
						>
							Evaluación Gratuita de su Caso
						</a>
						<a
							href="tel:7022222115"
							class="inline-flex w-full items-center justify-center gap-2 rounded-md border border-white/30 px-8 py-4 text-base font-semibold text-white transition-colors hover:border-white hover:bg-white/10 sm:w-auto sm:text-lg"
						>
							<span class="[&>svg]:size-5" set:html={phoneIcon} aria-hidden="true" />
							(702) 222-2115
						</a>
					</div>
					<ul class="mx-auto mt-8 flex max-w-xl flex-wrap items-center justify-center gap-y-1 text-xs font-medium text-white/60 sm:text-sm">
						{
							heroTrust.map((item, index) => (
								<li
									class:list={[
										index > 0 &&
											"before:mx-2 before:text-brand-gold before:content-['•'] sm:before:mx-3",
									]}
								>
									{item}
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<!-- SECTION 2 — Trust strip -->
			<section class="border-b border-gray-200 bg-white">
				<div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
					<dl class="grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-4">
						{
							stats.map((stat) => (
								<div class="text-center">
									<dd class="text-3xl font-extrabold text-brand-navy sm:text-4xl">
										{stat.value}
									</dd>
									<dt class="mt-1 text-sm font-semibold text-gray-600">{stat.label}</dt>
									{stat.note && <p class="mt-0.5 text-xs text-gray-500">{stat.note}</p>}
								</div>
							))
						}
					</dl>
				</div>
			</section>

			<!-- SECTION 3 — What to do after a crash -->
			<section class="bg-white" aria-labelledby="steps-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Primeros Pasos
						</p>
						<h2
							id="steps-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Qué Hacer Después de un Atropello de Peatón en Las Vegas
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							Las primeras horas después de un accidente definen todo su reclamo. Así puede
							protegerse usted y proteger su caso.
						</p>
					</div>
					<ol class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3">
						{
							steps.map((step, index) => (
								<li class="rounded-lg border border-gray-200 bg-white p-6">
									<div class="flex items-center gap-3">
										<span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-navy text-sm font-bold text-brand-gold">
											{index + 1}
										</span>
										<span
											class="text-brand-navy [&>svg]:size-7"
											set:html={step.icon}
											aria-hidden="true"
										/>
									</div>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{step.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{step.text}
									</p>
								</li>
							))
						}
					</ol>
				</div>
			</section>

			<!-- SECTION 4 — How we help -->
			<section class="bg-gray-50" aria-labelledby="help-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Nuestro Enfoque
						</p>
						<h2
							id="help-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Cómo Eric Blank Injury Attorneys Maneja los Casos de Atropellos de Peatones
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							Eric Blank pasó los primeros años de su carrera defendiendo a compañías de
							seguros. Aplicamos ese conocimiento interno a cada reclamo de peatón — la
							misma ventaja que usamos en toda nuestra{" "}
							<a
								href="/es/areas-de-practica"
								class="font-semibold text-brand-navy underline decoration-brand-gold decoration-2 underline-offset-2 transition-colors hover:decoration-brand-navy"
							>
								práctica de lesiones personales
							</a>.
						</p>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
						{
							howWeHelp.map((item) => (
								<div class="rounded-lg border border-gray-200 bg-white p-6">
									<span
										class="block text-brand-navy [&>svg]:size-10"
										set:html={item.icon}
										aria-hidden="true"
									/>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{item.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{item.text}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- SECTION 5 — What you can recover -->
			<section class="bg-white" aria-labelledby="damages-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Daños y Perjuicios
						</p>
						<h2
							id="damages-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Lo Que las Víctimas de Atropellos Pueden Recuperar en Nevada
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							La ley de Nevada permite a las víctimas de lesiones recuperar daños
							compensatorios — tanto las pérdidas económicas concretas como el costo humano
							del accidente. En casos poco comunes de conducta especialmente imprudente,
							también pueden aplicarse daños punitivos.
						</p>
					</div>
					<div class="mx-auto mt-12 grid max-w-4xl grid-cols-1 gap-6 md:grid-cols-2 lg:mt-16">
						<div class="rounded-lg border border-gray-200 bg-white p-8">
							<h3 class="text-xl font-bold text-brand-navy">Daños Económicos</h3>
							<ul class="mt-5 space-y-3">
								{
									economicDamages.map((item) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-5"
												set:html={circleCheckIcon}
												aria-hidden="true"
											/>
											<span class="text-base text-gray-700">{item}</span>
										</li>
									))
								}
							</ul>
						</div>
						<div class="rounded-lg border border-gray-200 bg-white p-8">
							<h3 class="text-xl font-bold text-brand-navy">Daños No Económicos</h3>
							<ul class="mt-5 space-y-3">
								{
									nonEconomicDamages.map((item) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-5"
												set:html={circleCheckIcon}
												aria-hidden="true"
											/>
											<span class="text-base text-gray-700">{item}</span>
										</li>
									))
								}
							</ul>
						</div>
					</div>
					<p class="mx-auto mt-8 max-w-2xl text-center text-sm text-pretty text-gray-500">
						Nevada limita los daños en casos de negligencia médica pero <strong>no</strong> en
						los reclamos generales de lesiones personales. La cantidad que puede recuperar
						depende de los detalles de su caso — una{" "}
						<a
							href="/es/contacto"
							class="font-semibold text-brand-navy underline decoration-brand-gold decoration-2 underline-offset-2 transition-colors hover:decoration-brand-navy"
						>
							consulta gratuita
						</a>{" "}
						es la mejor manera de obtener una respuesta real.
					</p>
				</div>
			</section>

			<!-- SECTION 6 — Nevada law -->
			<section class="bg-gray-50" aria-labelledby="law-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Ley de Nevada
						</p>
						<h2
							id="law-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Leyes Clave de Nevada Sobre Atropellos de Peatones
						</h2>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3 lg:mt-16">
						{
							nevadaLaws.map((law) => (
								<div class="rounded-lg border border-gray-200 bg-white p-6">
									<span
										class="block text-brand-navy [&>svg]:size-10"
										set:html={law.icon}
										aria-hidden="true"
									/>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{law.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{law.text}
									</p>
								</div>
							))
						}
					</div>
					<p class="mx-auto mt-8 max-w-2xl text-center text-sm text-pretty text-gray-500">
						Esta es información general, no asesoramiento legal para su caso específico. Hable
						con un abogado sobre los hechos de su accidente.
					</p>
				</div>
			</section>

			<!-- SECTION 7 — FAQ -->
			<section class="bg-white" aria-labelledby="faq-heading">
				<div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
					<div class="text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Preguntas Frecuentes
						</p>
						<h2
							id="faq-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Preguntas Comunes Sobre Atropellos de Peatones
						</h2>
					</div>
					<div class="mt-10 space-y-8 lg:mt-12">
						{
							faqs.map((faq) => (
								<div>
									<h3 class="text-lg font-bold text-brand-navy sm:text-xl">{faq.q}</h3>
									<p class="mt-2 text-base leading-relaxed text-pretty text-gray-600">
										{faq.a}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- SECTION 8 — Featured testimonial -->
			<section class="bg-gray-50">
				<div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20">
					<figure>
						<span
							aria-hidden="true"
							class="mx-auto block w-fit text-brand-navy/60 [&>svg]:size-10"
							set:html={quoteIcon}
						/>
						<blockquote class="mt-5 text-xl font-medium text-balance text-brand-navy sm:text-2xl">
							I had terrible injuries as a result of the accident I had and hiring Eric
							Blank to be on my side during this difficult process was the best thing I did.
						</blockquote>
						<figcaption class="mt-5 text-base font-bold text-brand-navy">— Tami</figcaption>
					</figure>
					<p class="mt-3 text-xs text-gray-500">Reseña original en inglés.</p>
					<a
						href="/es/resenas"
						class="mt-6 inline-block text-sm font-semibold text-brand-navy transition-colors hover:text-brand-gold"
					>
						Lea más reseñas de clientes →
					</a>
				</div>
			</section>

			<!-- Video testimonial carousel -->
			<TestimonialCarousel lang="es" />

			<!-- SECTION 9 — Final CTA + contact form -->
			<section
				id="contact"
				class="scroll-mt-24 bg-brand-navy text-white"
				aria-labelledby="cta-heading"
			>
				<div class="mx-auto max-w-[1200px] px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<h2
							id="cta-heading"
							class="text-3xl font-bold tracking-tight text-balance sm:text-4xl"
						>
							Solicite su Evaluación Gratuita de Caso
						</h2>
						<p class="mt-3 text-base text-pretty text-white/70 sm:text-lg">
							Es gratis, confidencial y sin compromiso.
						</p>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-start lg:gap-16">
						<div>
							<p class="text-sm font-semibold tracking-wider text-brand-gold uppercase">
								Por Qué Llamar Ahora
							</p>
							<h3 class="mt-3 text-xl font-bold sm:text-2xl">
								Tres Razones Para Contactarnos Hoy
							</h3>
							<ul class="mt-6 space-y-4">
								{
									contactReasons.map((reason) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-6"
												set:html={reason.icon}
												aria-hidden="true"
											/>
											<span class="text-base text-white/90 sm:text-lg">{reason.text}</span>
										</li>
									))
								}
							</ul>
							<p class="mt-6 max-w-md text-base text-pretty text-white/70">
								Los reclamos por atropellos de peatones en Nevada tienen plazos estrictos — y
								los videos de las cámaras de tráfico del Strip y las calles suelen marcar la
								diferencia. Cuanto antes nos contacte, más podremos hacer.
							</p>
						</div>
						<ContactForm lang="es" />
					</div>
				</div>
			</section>
		</main>
		<Footer lang="es" />
		<!-- Universal media lightbox (used by the carousel) -->
		<Lightbox />
	</body>
</html>
