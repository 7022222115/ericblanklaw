---
import '../../../styles/global.css';
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ContactForm from '../../../components/ContactForm.astro';
import TestimonialCarousel from '../../../components/TestimonialCarousel.astro';
import Lightbox from '../../../components/Lightbox.astro';
import { firmNode, attorneyNode } from '../../../data/firm';

import phoneIcon from 'lucide-static/icons/phone.svg?raw';
import shieldIcon from 'lucide-static/icons/shield.svg?raw';
import phoneCallIcon from 'lucide-static/icons/phone-call.svg?raw';
import cameraIcon from 'lucide-static/icons/camera.svg?raw';
import stethoscopeIcon from 'lucide-static/icons/stethoscope.svg?raw';
import banIcon from 'lucide-static/icons/ban.svg?raw';
import scaleIcon from 'lucide-static/icons/scale.svg?raw';
import searchIcon from 'lucide-static/icons/search.svg?raw';
import clipboardListIcon from 'lucide-static/icons/clipboard-list.svg?raw';
import handshakeIcon from 'lucide-static/icons/handshake.svg?raw';
import gavelIcon from 'lucide-static/icons/gavel.svg?raw';
import circleCheckIcon from 'lucide-static/icons/circle-check.svg?raw';
import calendarClockIcon from 'lucide-static/icons/calendar-clock.svg?raw';
import shieldCheckIcon from 'lucide-static/icons/shield-check.svg?raw';
import quoteIcon from 'lucide-static/icons/quote.svg?raw';
import checkCircleIcon from 'lucide-static/icons/check-circle.svg?raw';
import circleDollarSignIcon from 'lucide-static/icons/circle-dollar-sign.svg?raw';
import clockIcon from 'lucide-static/icons/clock.svg?raw';

const title = "Abogado de Accidentes por Conductor Ebrio en Las Vegas | Eric Blank Injury Attorneys | (702) 222-2115";
const description =
	"¿Golpeado por un conductor ebrio en Las Vegas? Eric Blank Injury Attorneys ha enfrentado a las aseguradoras por más de 26 años para lograr la recuperación completa de las víctimas de choques por DUI. Consulta gratuita. Sin honorarios a menos que ganemos. Llame al (702) 222-2115.";

const heroTrust = ["Más de 26 Años", "Millones Recuperados", "Disponibles 24/7", "Consulta Gratuita"];

const stats = [
	{ value: "Millones", label: "Recuperados para Víctimas de Accidentes" },
	{ value: "Miles", label: "de Casos de Lesiones Manejados" },
	{ value: "$0", label: "de Su Bolsillo", note: "Solo honorarios de contingencia" },
	{ value: "24/7", label: "Consulta Gratuita" },
];

const steps = [
	{
		icon: shieldIcon,
		title: "Póngase a Salvo",
		text: "Si puede moverse, salga del tráfico junto con su vehículo. Luego revise si usted y sus pasajeros tienen lesiones antes de hacer cualquier otra cosa.",
	},
	{
		icon: phoneCallIcon,
		title: "Llame al 911",
		text: "Reporte el choque — y dígale al operador si sospecha que el otro conductor está bajo los efectos del alcohol o las drogas. Eso activa una investigación por DUI, y el arresto y la evidencia de alcohol en sangre (BAC) resultantes se convierten en pruebas poderosas para su reclamo civil. En las calles responde la Policía Metropolitana; en las autopistas, la Patrulla de Carreteras de Nevada.",
	},
	{
		icon: cameraIcon,
		title: "Documente Todo",
		text: "Fotografíe los vehículos, la escena y cualquier lesión visible. Anote cualquier señal de que el otro conductor estaba bajo los efectos del alcohol, y recopile los nombres y teléfonos de los testigos que vieron cómo conducía.",
	},
	{
		icon: stethoscopeIcon,
		title: "Vea a un Médico",
		text: "Hágase revisar aunque se sienta bien — la adrenalina oculta las lesiones, y las lesiones de tejidos blandos y cerebrales suelen aparecer días después. Un vacío en el tratamiento es lo primero que las aseguradoras usan en su contra.",
	},
	{
		icon: banIcon,
		title: "No Hable con la Aseguradora del Otro",
		text: "La compañía de seguros del conductor ebrio llamará rápido y sonará amable. No están de su lado. No dé una declaración grabada ni acepte una oferta rápida — refiéralos a su abogado.",
	},
	{
		icon: scaleIcon,
		title: "Llame Primero a un Abogado",
		text: "Antes de firmar cualquier cosa o aceptar un acuerdo, hable con un abogado. Una vez que acepta una oferta, no puede reabrir el reclamo — aunque sus lesiones resulten peores de lo que pensaba.",
	},
];

const howWeHelp = [
	{
		icon: searchIcon,
		title: "Usamos el Caso Penal a Su Favor",
		text: "Reunimos el informe policial, los resultados de alcohol en sangre (BAC) y los registros del arresto de la causa penal por DUI y los usamos para construir su reclamo civil. No se requiere una condena para que usted recupere compensación — pero fortalece su caso.",
	},
	{
		icon: clipboardListIcon,
		title: "Construimos el Expediente Médico",
		text: "Trabajamos directamente con sus médicos para documentar cada lesión, presente y futura, de modo que el costo completo del accidente quede por escrito — no adivinado.",
	},
	{
		icon: handshakeIcon,
		title: "Encontramos Cada Fuente de Recuperación",
		text: "Más allá del conductor, analizamos si un empleador es responsable cuando el conductor estaba trabajando, y cada póliza de seguro que pueda aplicar — incluida su propia cobertura de motorista sin seguro / con seguro insuficiente.",
	},
	{
		icon: gavelIcon,
		title: "Llevamos el Caso a Juicio si Hace Falta",
		text: "Las aseguradoras negocian más en serio cuando saben que su abogado las llevará a juicio. Preparamos cada caso como si fuera a presentarse ante un jurado — y la conducta de un conductor ebrio puede abrir la puerta a daños punitivos.",
	},
];

const economicDamages = [
	"Gastos médicos — tratamiento pasado y futuro",
	"Salarios perdidos y reducción de su capacidad futura de ingresos",
	"Daños materiales a su vehículo",
	"Gastos de bolsillo — transporte, medicamentos y más",
];

const nonEconomicDamages = [
	"Dolor y sufrimiento",
	"Angustia emocional",
	"Pérdida del disfrute de la vida",
	"Discapacidad o desfiguración permanente",
	"Pérdida de consorcio",
];

const nevadaLaws = [
	{
		icon: calendarClockIcon,
		title: "Plazo de Prescripción",
		text: "Nevada le da 2 años desde la fecha del accidente para presentar una demanda por lesiones causadas por un conductor ebrio (NRS 11.190). La causa penal por DUI contra el conductor es independiente y sigue su propio calendario — su plazo civil sigue vigente, así que no espere a que termine el caso penal.",
	},
	{
		icon: scaleIcon,
		title: "Negligencia Comparativa",
		text: "En Nevada, usted no pierde su caso solo por haber tenido parte de la culpa. Siempre que su grado de culpa sea del 50% o menos, aún puede presentar un reclamo, pero su recuperación se reducirá según su porcentaje de culpa. Sin embargo, cuando la otra parte logra llevar su responsabilidad por encima del 50%, la regla de negligencia comparativa modificada de Nevada generalmente le impide recuperar compensación alguna (NRS 41.141). En la mayoría de los choques por DUI, la culpa recae claramente en el conductor ebrio.",
	},
	{
		icon: gavelIcon,
		title: "Daños Punitivos",
		text: "Debido a que conducir ebrio es una conducta imprudente, Nevada tiene una ley específica de daños punitivos para los casos de lesiones por DUI (NRS 42.010) — daños destinados a castigar al conductor, más allá de la compensación por sus pérdidas. A diferencia de la mayoría de los daños punitivos en Nevada, los daños punitivos por DUI no están sujetos al límite legal habitual — el tope en dólares que la ley de Nevada normalmente impone a los daños punitivos. Esta es una manera importante en que un caso de conducción ebria puede diferir de un reclamo por accidente ordinario.",
	},
	{
		icon: banIcon,
		title: "¿Puede Demandar al Bar? (Ley 'Dram Shop')",
		text: "A diferencia de muchos estados, Nevada generalmente no permite demandar a un bar, casino o restaurante por servirle alcohol a un adulto que luego causa un choque por DUI — la ley coloca la responsabilidad en quien bebe (NRS 41.1305). Existe una excepción limitada cuando se sirve alcohol a sabiendas a una persona menor de 21 años. Si alguien más allá del conductor puede ser responsabilizado depende de los hechos, y vale la pena revisarlo con un abogado.",
	},
];

const faqs = [
	{
		q: "¿Cuánto cuesta contratar a un abogado de accidentes por conductor ebrio?",
		a: "Nuestros honorarios son de contingencia — sin costo inicial y sin cobro por hora. Solo nos pagan si ganamos su caso, y el honorario es un porcentaje de su acuerdo, pactado por escrito antes de empezar.",
	},
	{
		q: "¿Tengo que esperar a que termine la causa penal del conductor?",
		a: "No. Su reclamo civil por lesiones es independiente de la causa penal por DUI y tiene su propio plazo de dos años. A menudo usamos evidencia del caso penal para fortalecer el suyo, pero no tiene que esperar una condena para buscar compensación.",
	},
	{
		q: "¿Puedo demandar al bar o casino que le sirvió alcohol al conductor?",
		a: "Generalmente no. La ley de Nevada (NRS 41.1305) protege en general a los establecimientos que sirven alcohol a adultos, colocando la responsabilidad en quien bebe. La principal excepción es cuando se sirvió alcohol a sabiendas a una persona menor de 21 años. Podemos revisar si algún tercero comparte responsabilidad en su caso.",
	},
	{
		q: "¿Qué son los daños punitivos?",
		a: "Son daños destinados a castigar una conducta especialmente imprudente, como conducir ebrio, además de la compensación por sus pérdidas. No todos los casos califican, pero los choques por DUI son una de las situaciones en las que pueden aplicarse.",
	},
	{
		q: "¿Qué pasa si el conductor ebrio no tenía seguro, o no tenía suficiente?",
		a: "Es posible que aún pueda recuperar compensación a través de su propia cobertura de motorista sin seguro / con seguro insuficiente. Revisaremos cada póliza que pueda aplicar a su accidente.",
	},
	{
		q: "¿Debo aceptar la oferta de acuerdo de la compañía de seguros?",
		a: "Si resultó lesionado en un choque por conductor ebrio, no se apresure a firmar un acuerdo o una liberación de responsabilidad antes de hablar con un abogado. Los acuerdos generalmente se consideran definitivos, lo que significa que quizá no pueda reabrir su caso ni pedir compensación adicional después si su dolor aumenta, necesita más tratamiento o aparecen nuevos problemas.",
	},
];

const contactReasons = [
	{ text: "Evaluación de caso gratuita y sin compromiso", icon: checkCircleIcon },
	{ text: "Sin honorarios a menos que ganemos su caso", icon: circleDollarSignIcon },
	{ text: "Disponibles 24/7 — noches, fines de semana y días festivos", icon: clockIcon },
];

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		firmNode,
		{
			"@type": "LegalService",
			"@id": "https://ericblanklaw.com/es/areas-de-practica/accidentes-por-conductor-ebrio#service",
			name: "Eric Blank Injury Attorneys — Representación en Accidentes por Conductor Ebrio",
			serviceType: "Servicios Legales de Accidentes por Conductor Ebrio",
			url: "https://ericblanklaw.com/es/areas-de-practica/accidentes-por-conductor-ebrio",
			image: "https://ericblanklaw.com/Eric_Blank_Injury_Attorneys_Logo.png",
			priceRange: "Honorarios de Contingencia — Sin Honorarios a Menos Que Ganemos",
			inLanguage: "es",
			provider: { "@id": "https://ericblanklaw.com/#legalservice" },
			employee: { "@id": "https://ericblanklaw.com/#attorney" },
		},
		attorneyNode,
		{
			"@type": "FAQPage",
			"@id": "https://ericblanklaw.com/es/areas-de-practica/accidentes-por-conductor-ebrio#faq",
			inLanguage: "es",
			mainEntity: faqs.map((faq) => ({
				"@type": "Question",
				name: faq.q,
				acceptedAnswer: { "@type": "Answer", text: faq.a },
			})),
		},
	],
};
---

<html lang="es">
	<head>
		<BaseHead
			title={title}
			description={description}
			canonical="https://ericblanklaw.com/es/areas-de-practica/accidentes-por-conductor-ebrio"
			lang="es"
		/>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body class="overflow-x-clip">
		<Header lang="es" />
		<main>
			<!-- SECTION 1 — Hero -->
			<section class="relative bg-brand-navy text-white">
				<div class="absolute inset-0 bg-cover bg-center" style="background-image:url('/dui-accidents-hero.jpeg')" aria-hidden="true"></div>
				<div class="absolute inset-0 bg-brand-navy/75" aria-hidden="true"></div>
				<div class="relative mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:py-24">
					<p class="text-sm font-semibold tracking-wider text-brand-gold uppercase">
						Accidentes por Conductor Ebrio en Las Vegas
					</p>
					<h1 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-5xl">
						Abogado de Accidentes por Conductor Ebrio en Las Vegas
					</h1>
					<p class="mx-auto mt-4 max-w-2xl text-base text-pretty text-white/70 sm:text-lg">
						Un conductor ebrio tomó una decisión — y usted es quien está pagando por ella. En
						una ciudad de 24 horas construida sobre la vida nocturna, los choques por DUI son
						un peligro constante en el Strip, en la I-15 y en las calles de todo el valle. La
						buena noticia: cuando un conductor ebrio causa sus lesiones, la culpa suele ser
						clara, y la ley de Nevada le da opciones sólidas para recuperar compensación. Por
						más de 26 años, Eric Blank Injury Attorneys ha hecho que los conductores ebrios
						respondan por sus actos. Consulta gratuita, y sin honorarios a menos que ganemos.
					</p>
					<div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
						<a
							href="#contact"
							class="inline-flex w-full items-center justify-center rounded-md bg-brand-gold px-8 py-4 text-base font-bold text-brand-navy transition-colors hover:bg-[#d1a63b] sm:w-auto sm:text-lg"
						>
							Evaluación Gratuita de su Caso
						</a>
						<a
							href="tel:7022222115"
							class="inline-flex w-full items-center justify-center gap-2 rounded-md border border-white/30 px-8 py-4 text-base font-semibold text-white transition-colors hover:border-white hover:bg-white/10 sm:w-auto sm:text-lg"
						>
							<span class="[&>svg]:size-5" set:html={phoneIcon} aria-hidden="true" />
							(702) 222-2115
						</a>
					</div>
					<ul class="mx-auto mt-8 flex max-w-xl flex-wrap items-center justify-center gap-y-1 text-xs font-medium text-white/60 sm:text-sm">
						{
							heroTrust.map((item, index) => (
								<li
									class:list={[
										index > 0 &&
											"before:mx-2 before:text-brand-gold before:content-['•'] sm:before:mx-3",
									]}
								>
									{item}
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<!-- SECTION 2 — Trust strip -->
			<section class="border-b border-gray-200 bg-white">
				<div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
					<dl class="grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-4">
						{
							stats.map((stat) => (
								<div class="text-center">
									<dd class="text-3xl font-extrabold text-brand-navy sm:text-4xl">
										{stat.value}
									</dd>
									<dt class="mt-1 text-sm font-semibold text-gray-600">{stat.label}</dt>
									{stat.note && <p class="mt-0.5 text-xs text-gray-500">{stat.note}</p>}
								</div>
							))
						}
					</dl>
				</div>
			</section>

			<!-- SECTION 3 — What to do after a crash -->
			<section class="bg-white" aria-labelledby="steps-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Primeros Pasos
						</p>
						<h2
							id="steps-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Qué Hacer Después de un Choque con un Conductor Ebrio en Las Vegas
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							Las primeras horas después de un choque definen todo su reclamo. Así puede
							protegerse usted y proteger su caso.
						</p>
					</div>
					<ol class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3">
						{
							steps.map((step, index) => (
								<li class="rounded-lg border border-gray-200 bg-white p-6">
									<div class="flex items-center gap-3">
										<span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-navy text-sm font-bold text-brand-gold">
											{index + 1}
										</span>
										<span
											class="text-brand-navy [&>svg]:size-7"
											set:html={step.icon}
											aria-hidden="true"
										/>
									</div>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{step.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{step.text}
									</p>
								</li>
							))
						}
					</ol>
				</div>
			</section>

			<!-- SECTION 4 — How we help -->
			<section class="bg-gray-50" aria-labelledby="help-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Nuestro Enfoque
						</p>
						<h2
							id="help-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Cómo Eric Blank Injury Attorneys Maneja los Casos de Conductores Ebrios
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							Eric Blank pasó los primeros años de su carrera defendiendo a compañías de
							seguros. Aplicamos ese conocimiento interno a cada reclamo por conducción
							ebria — la misma ventaja que usamos en toda nuestra{" "}
							<a
								href="/es/areas-de-practica"
								class="font-semibold text-brand-navy underline decoration-brand-gold decoration-2 underline-offset-2 transition-colors hover:decoration-brand-navy"
							>
								práctica de lesiones personales
							</a>.
						</p>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
						{
							howWeHelp.map((item) => (
								<div class="rounded-lg border border-gray-200 bg-white p-6">
									<span
										class="block text-brand-navy [&>svg]:size-10"
										set:html={item.icon}
										aria-hidden="true"
									/>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{item.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{item.text}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- SECTION 5 — What you can recover -->
			<section class="bg-white" aria-labelledby="damages-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Daños y Perjuicios
						</p>
						<h2
							id="damages-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Lo Que las Víctimas de Accidentes por Conductor Ebrio Pueden Recuperar en Nevada
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							La ley de Nevada permite a las víctimas de lesiones recuperar daños
							compensatorios — tanto las pérdidas económicas concretas como el costo humano
							del accidente. En casos poco comunes de conducta especialmente imprudente,
							también pueden aplicarse daños punitivos.
						</p>
					</div>
					<div class="mx-auto mt-12 grid max-w-4xl grid-cols-1 gap-6 md:grid-cols-2 lg:mt-16">
						<div class="rounded-lg border border-gray-200 bg-white p-8">
							<h3 class="text-xl font-bold text-brand-navy">Daños Económicos</h3>
							<ul class="mt-5 space-y-3">
								{
									economicDamages.map((item) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-5"
												set:html={circleCheckIcon}
												aria-hidden="true"
											/>
											<span class="text-base text-gray-700">{item}</span>
										</li>
									))
								}
							</ul>
						</div>
						<div class="rounded-lg border border-gray-200 bg-white p-8">
							<h3 class="text-xl font-bold text-brand-navy">Daños No Económicos</h3>
							<ul class="mt-5 space-y-3">
								{
									nonEconomicDamages.map((item) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-5"
												set:html={circleCheckIcon}
												aria-hidden="true"
											/>
											<span class="text-base text-gray-700">{item}</span>
										</li>
									))
								}
							</ul>
						</div>
					</div>
					<p class="mx-auto mt-8 max-w-2xl text-center text-sm text-pretty text-gray-500">
						Nevada limita los daños en casos de negligencia médica pero no en los reclamos
						generales de lesiones personales. Los casos de DUI tienen una dimensión adicional:
						debido a que conducir ebrio es una conducta imprudente, la víctima también puede
						buscar daños punitivos — dinero destinado a castigar al conductor, además de la
						compensación por sus pérdidas. Una{" "}
						<a
							href="/es/contacto"
							class="font-semibold text-brand-navy underline decoration-brand-gold decoration-2 underline-offset-2 transition-colors hover:decoration-brand-navy"
						>
							consulta gratuita
						</a>{" "}
						es la mejor manera de entender cuánto puede valer su caso.
					</p>
				</div>
			</section>

			<!-- SECTION 6 — Nevada law -->
			<section class="bg-gray-50" aria-labelledby="law-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Ley de Nevada
						</p>
						<h2
							id="law-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Leyes Clave de Nevada Sobre Conductores Ebrios
						</h2>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4 lg:mt-16">
						{
							nevadaLaws.map((law) => (
								<div class="rounded-lg border border-gray-200 bg-white p-6">
									<span
										class="block text-brand-navy [&>svg]:size-10"
										set:html={law.icon}
										aria-hidden="true"
									/>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{law.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{law.text}
									</p>
								</div>
							))
						}
					</div>
					<p class="mx-auto mt-8 max-w-2xl text-center text-sm text-pretty text-gray-500">
						Esta es información general, no asesoramiento legal para su caso específico. Hable
						con un abogado sobre los hechos de su accidente.
					</p>
				</div>
			</section>

			<!-- SECTION 7 — FAQ -->
			<section class="bg-white" aria-labelledby="faq-heading">
				<div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
					<div class="text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Preguntas Frecuentes
						</p>
						<h2
							id="faq-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Preguntas Comunes Sobre Accidentes por Conductor Ebrio
						</h2>
					</div>
					<div class="mt-10 space-y-8 lg:mt-12">
						{
							faqs.map((faq) => (
								<div>
									<h3 class="text-lg font-bold text-brand-navy sm:text-xl">{faq.q}</h3>
									<p class="mt-2 text-base leading-relaxed text-pretty text-gray-600">
										{faq.a}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- SECTION 8 — Featured testimonial -->
			<section class="bg-gray-50">
				<div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20">
					<figure>
						<span
							aria-hidden="true"
							class="mx-auto block w-fit text-brand-navy/60 [&>svg]:size-10"
							set:html={quoteIcon}
						/>
						<blockquote class="mt-5 text-xl font-medium text-balance text-brand-navy sm:text-2xl">
							I had terrible injuries as a result of the accident I had and hiring Eric
							Blank to be on my side during this difficult process was the best thing I did.
						</blockquote>
						<figcaption class="mt-5 text-base font-bold text-brand-navy">— Tami</figcaption>
					</figure>
					<p class="mt-3 text-xs text-gray-500">Reseña original en inglés.</p>
					<a
						href="/es/resenas"
						class="mt-6 inline-block text-sm font-semibold text-brand-navy transition-colors hover:text-brand-gold"
					>
						Lea más reseñas de clientes →
					</a>
				</div>
			</section>

			<!-- Video testimonial carousel -->
			<TestimonialCarousel lang="es" />

			<!-- SECTION 9 — Final CTA + contact form -->
			<section
				id="contact"
				class="scroll-mt-24 bg-brand-navy text-white"
				aria-labelledby="cta-heading"
			>
				<div class="mx-auto max-w-[1200px] px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<h2
							id="cta-heading"
							class="text-3xl font-bold tracking-tight text-balance sm:text-4xl"
						>
							Solicite su Evaluación Gratuita de Caso
						</h2>
						<p class="mt-3 text-base text-pretty text-white/70 sm:text-lg">
							Es gratis, confidencial y sin compromiso.
						</p>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-start lg:gap-16">
						<div>
							<p class="text-sm font-semibold tracking-wider text-brand-gold uppercase">
								Por Qué Llamar Ahora
							</p>
							<h3 class="mt-3 text-xl font-bold sm:text-2xl">
								Tres Razones Para Contactarnos Hoy
							</h3>
							<ul class="mt-6 space-y-4">
								{
									contactReasons.map((reason) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-6"
												set:html={reason.icon}
												aria-hidden="true"
											/>
											<span class="text-base text-white/90 sm:text-lg">{reason.text}</span>
										</li>
									))
								}
							</ul>
							<p class="mt-6 max-w-md text-base text-pretty text-white/70">
								La mayoría de los reclamos por conductores ebrios en Nevada tienen plazos
								estrictos — y la evidencia que los gana desaparece rápido. Cuanto antes nos
								contacte, más podremos hacer.
							</p>
						</div>
						<ContactForm lang="es" />
					</div>
				</div>
			</section>
		</main>
		<Footer lang="es" />
		<!-- Universal media lightbox (used by the carousel) -->
		<Lightbox />
	</body>
</html>
