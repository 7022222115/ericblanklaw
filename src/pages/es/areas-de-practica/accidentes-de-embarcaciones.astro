---
import '../../../styles/global.css';
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ContactForm from '../../../components/ContactForm.astro';
import TestimonialCarousel from '../../../components/TestimonialCarousel.astro';
import Lightbox from '../../../components/Lightbox.astro';
import { firmNode, attorneyNode } from '../../../data/firm';

import phoneIcon from 'lucide-static/icons/phone.svg?raw';
import shieldIcon from 'lucide-static/icons/shield.svg?raw';
import phoneCallIcon from 'lucide-static/icons/phone-call.svg?raw';
import cameraIcon from 'lucide-static/icons/camera.svg?raw';
import stethoscopeIcon from 'lucide-static/icons/stethoscope.svg?raw';
import banIcon from 'lucide-static/icons/ban.svg?raw';
import scaleIcon from 'lucide-static/icons/scale.svg?raw';
import searchIcon from 'lucide-static/icons/search.svg?raw';
import clipboardListIcon from 'lucide-static/icons/clipboard-list.svg?raw';
import handshakeIcon from 'lucide-static/icons/handshake.svg?raw';
import gavelIcon from 'lucide-static/icons/gavel.svg?raw';
import circleCheckIcon from 'lucide-static/icons/circle-check.svg?raw';
import calendarClockIcon from 'lucide-static/icons/calendar-clock.svg?raw';
import shieldCheckIcon from 'lucide-static/icons/shield-check.svg?raw';
import quoteIcon from 'lucide-static/icons/quote.svg?raw';
import checkCircleIcon from 'lucide-static/icons/check-circle.svg?raw';
import circleDollarSignIcon from 'lucide-static/icons/circle-dollar-sign.svg?raw';
import clockIcon from 'lucide-static/icons/clock.svg?raw';
import fileTextIcon from 'lucide-static/icons/file-text.svg?raw';
import anchorIcon from 'lucide-static/icons/anchor.svg?raw';

const title = "Abogado de Accidentes de Embarcaciones en Las Vegas | Eric Blank Injury Attorneys | (702) 222-2115";
const description =
	"¿Lesionado en un accidente de embarcación en el Lago Mead o el Lago Tahoe? Eric Blank Injury Attorneys ha enfrentado a las aseguradoras por más de 26 años. Consulta gratuita. Sin honorarios a menos que ganemos. Llame al (702) 222-2115.";

const heroTrust = ["Más de 26 Años", "Millones Recuperados", "Disponibles 24/7", "Consulta Gratuita"];

const stats = [
	{ value: "Millones", label: "Recuperados para Víctimas de Accidentes" },
	{ value: "Miles", label: "de Casos de Lesiones Manejados" },
	{ value: "$0", label: "de Su Bolsillo", note: "Solo honorarios de contingencia" },
	{ value: "24/7", label: "Consulta Gratuita" },
];

const steps = [
	{
		icon: shieldIcon,
		title: "Póngase a Salvo",
		text: "Salga del agua junto con los demás y suban a una embarcación estable o a la orilla. Verifique que todos estén presentes — en un accidente de embarcación, las personas pueden caer por la borda y perderse de vista rápidamente.",
	},
	{
		icon: phoneCallIcon,
		title: "Pida Ayuda",
		text: "Envíe un SOS, haga señas a otros navegantes o pida auxilio. Reporte el accidente al Departamento de Vida Silvestre de Nevada (NDOW), a la patrulla marina o a la Guardia Costera de EE. UU. Un informe oficial se convierte en evidencia clave.",
	},
	{
		icon: cameraIcon,
		title: "Documente Todo",
		text: "Fotografíe las embarcaciones, los daños, las condiciones del agua y del clima, y cualquier lesión. Obtenga el nombre del operador, el registro de la embarcación y los datos del seguro — además de los nombres y teléfonos de todos a bordo y de cualquier testigo.",
	},
	{
		icon: stethoscopeIcon,
		title: "Vea a un Médico",
		text: "Hágase revisar aunque se sienta bien. La adrenalina oculta las lesiones, y los casi ahogamientos y las lesiones de cabeza pueden empeorar rápido. Un vacío en el tratamiento es lo primero que las aseguradoras usan en su contra.",
	},
	{
		icon: banIcon,
		title: "No Dé una Declaración",
		text: "La aseguradora del dueño de la embarcación querrá una declaración grabada y puede ofrecer un acuerdo rápido. No están de su lado — no dé una declaración ni acepte una oferta. Refiéralos a su abogado.",
	},
	{
		icon: scaleIcon,
		title: "Llame Rápido a un Abogado",
		text: "Los casos de embarcaciones pueden regirse por la ley de Nevada o por la ley marítima federal, y la evidencia — el estado de la embarcación, los recuerdos de los testigos — se desvanece rápido. Cuanto antes intervenga un abogado, más se puede preservar.",
	},
];

const howWeHelp = [
	{
		icon: searchIcon,
		title: "Investigamos el Accidente",
		text: "Actuamos rápido para preservar la evidencia de la embarcación, los informes del NDOW y de la Guardia Costera, los registros de mantenimiento y las declaraciones de testigos antes de que desaparezcan o los recuerdos se borren.",
	},
	{
		icon: clipboardListIcon,
		title: "Identificamos a Cada Parte Responsable",
		text: "Un caso de embarcación puede involucrar al operador, al dueño de la embarcación, a una compañía de renta o de chárter, o al fabricante de una embarcación o pieza defectuosa. Identificamos a todos los responsables.",
	},
	{
		icon: handshakeIcon,
		title: "Negociamos con la Aseguradora",
		text: "Eric Blank pasó años del lado de la defensa de las aseguradoras. Sabemos cómo se valoran estos reclamos — y cómo se subvaloran — y lo usamos para exigir un acuerdo justo.",
	},
	{
		icon: gavelIcon,
		title: "Llevamos el Caso a Juicio si Hace Falta",
		text: "Las aseguradoras negocian más en serio cuando saben que su abogado las llevará a juicio. Preparamos cada caso como si fuera a presentarse ante un jurado.",
	},
];

const economicDamages = [
	"Gastos médicos — tratamiento pasado y futuro",
	"Salarios perdidos y reducción de su capacidad futura de ingresos",
	"Daños materiales a su vehículo",
	"Gastos de bolsillo — transporte, medicamentos y más",
];

const nonEconomicDamages = [
	"Dolor y sufrimiento",
	"Angustia emocional",
	"Pérdida del disfrute de la vida",
	"Discapacidad o desfiguración permanente",
	"Pérdida de consorcio",
];

const nevadaLaws = [
	{
		icon: calendarClockIcon,
		title: "Plazo de Prescripción",
		text: "Nevada le da 2 años desde la fecha del accidente para presentar una demanda por lesiones en un accidente de embarcación (NRS 11.190). Si pasa ese plazo, su reclamo se pierde — sin importar lo sólido que fuera. Si aplica la ley marítima federal, pueden entrar en juego plazos diferentes — una razón más para hablar con un abogado pronto.",
	},
	{
		icon: scaleIcon,
		title: "Negligencia Comparativa",
		text: "En Nevada, usted no pierde su caso solo por haber tenido parte de la culpa. Siempre que su grado de culpa sea del 50% o menos, aún puede presentar un reclamo, pero su recuperación se reducirá según su porcentaje de culpa. Sin embargo, cuando la otra parte logra llevar su responsabilidad por encima del 50%, la regla de negligencia comparativa modificada de Nevada generalmente le impide recuperar compensación alguna (NRS 41.141).",
	},
	{
		icon: fileTextIcon,
		title: "Reporte Obligatorio de Accidentes",
		text: "Según la Ley de Embarcaciones de Nevada, el operador de una embarcación o moto acuática involucrado en un accidente que causa la muerte, lesiones graves o daños materiales superiores a $2,000 debe presentar un informe oficial del accidente ante el estado (NRS 488.550). No detenerse, no ayudar a los lesionados, no proporcionar su información o no presentar el informe requerido puede usarse como evidencia contundente de negligencia en un reclamo por accidente de embarcación en Nevada.",
	},
	{
		icon: anchorIcon,
		title: "Ley Estatal o Ley Marítima Federal",
		text: "Debido a que lagos como el Mead y el Tahoe son aguas navegables, un accidente de embarcación allí puede tramitarse bajo la ley de Nevada o bajo la ley marítima (de almirantazgo) federal. Cuál aplica depende de los hechos, y puede afectar sus plazos, sus daños y si su caso corresponde a un tribunal estatal o federal. Esto es una de las cosas que hace que los casos de embarcaciones sean diferentes de los reclamos ordinarios por accidentes.",
	},
];

const faqs = [
	{
		q: "¿Cuánto cuesta contratar a un abogado de accidentes de embarcaciones?",
		a: "Nuestros honorarios son de contingencia — sin costo inicial y sin cobro por hora. Solo nos pagan si ganamos su caso, y el honorario es un porcentaje de su acuerdo, pactado por escrito antes de empezar.",
	},
	{
		q: "¿A quién puedo demandar después de un accidente de embarcación?",
		a: "Según los hechos: al operador de la embarcación, al dueño, a una compañía de renta o de chárter, o al fabricante de una embarcación o pieza defectuosa. Identificamos a cada parte responsable para que el valor completo de su reclamo esté sobre la mesa.",
	},
	{
		q: "¿Qué pasa si el accidente ocurrió en el Lago Mead?",
		a: "El Lago Mead es una vía navegable, así que su caso puede regirse por la ley de Nevada o por la ley marítima federal. Esa elección puede afectar sus plazos y su recuperación, por lo que vale la pena hablar con un abogado que maneje ambas.",
	},
	{
		q: "¿Cuánto tiempo tengo para presentar un reclamo por accidente de embarcación en Nevada?",
		a: "Generalmente dos años desde la fecha del accidente según NRS 11.190. Si aplica la ley marítima federal, el plazo puede ser distinto — así que no espere para recibir asesoría.",
	},
	{
		q: "¿Debo hablar con la compañía de seguros del dueño de la embarcación?",
		a: "No. No están de su lado, y cualquier cosa que diga puede usarse para reducir o negar su reclamo. Refiéralos cortésmente a su abogado y deje que nosotros manejemos esa conversación.",
	},
	{
		q: "¿Debo aceptar la oferta de acuerdo de la compañía de seguros?",
		a: "Si resultó lesionado en un accidente de embarcación, no se apresure a firmar un acuerdo o una liberación de responsabilidad antes de hablar con un abogado. Los acuerdos generalmente se consideran definitivos, lo que significa que quizá no pueda reabrir su caso ni pedir compensación adicional después si su dolor aumenta, necesita más tratamiento o aparecen nuevos problemas.",
	},
];

const contactReasons = [
	{ text: "Evaluación de caso gratuita y sin compromiso", icon: checkCircleIcon },
	{ text: "Sin honorarios a menos que ganemos su caso", icon: circleDollarSignIcon },
	{ text: "Disponibles 24/7 — noches, fines de semana y días festivos", icon: clockIcon },
];

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		firmNode,
		{
			"@type": "LegalService",
			"@id": "https://ericblanklaw.com/es/areas-de-practica/accidentes-de-embarcaciones#service",
			name: "Eric Blank Injury Attorneys — Representación en Accidentes de Embarcaciones",
			serviceType: "Servicios Legales de Accidentes de Embarcaciones",
			url: "https://ericblanklaw.com/es/areas-de-practica/accidentes-de-embarcaciones",
			image: "https://ericblanklaw.com/Eric_Blank_Injury_Attorneys_Logo.png",
			priceRange: "Honorarios de Contingencia — Sin Honorarios a Menos Que Ganemos",
			inLanguage: "es",
			provider: { "@id": "https://ericblanklaw.com/#legalservice" },
			employee: { "@id": "https://ericblanklaw.com/#attorney" },
		},
		attorneyNode,
		{
			"@type": "FAQPage",
			"@id": "https://ericblanklaw.com/es/areas-de-practica/accidentes-de-embarcaciones#faq",
			inLanguage: "es",
			mainEntity: faqs.map((faq) => ({
				"@type": "Question",
				name: faq.q,
				acceptedAnswer: { "@type": "Answer", text: faq.a },
			})),
		},
	],
};
---

<html lang="es">
	<head>
		<BaseHead
			title={title}
			description={description}
			canonical="https://ericblanklaw.com/es/areas-de-practica/accidentes-de-embarcaciones"
			lang="es"
		/>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body class="overflow-x-clip">
		<Header lang="es" />
		<main>
			<!-- SECTION 1 — Hero -->
			<section class="relative bg-brand-navy text-white">
				<div class="absolute inset-0 bg-cover bg-center" style="background-image:url('/boating-accidents-hero.jpeg')" aria-hidden="true"></div>
				<div class="absolute inset-0 bg-brand-navy/75" aria-hidden="true"></div>
				<div class="relative mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:py-24">
					<p class="text-sm font-semibold tracking-wider text-brand-gold uppercase">
						Accidentes de Embarcaciones en Nevada
					</p>
					<h1 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-5xl">
						Abogado de Accidentes de Embarcaciones en Las Vegas
					</h1>
					<p class="mx-auto mt-4 max-w-2xl text-base text-pretty text-white/70 sm:text-lg">
						El Lago Mead, el Lago Tahoe y el Río Colorado atraen a miles de navegantes cada
						temporada — y Nevada figura constantemente entre los estados más peligrosos para
						la navegación. Cuando un día en el agua termina en una lesión grave, la compañía
						de seguros del dueño de la embarcación actúa rápido para limitar lo que paga.
						Por más de 26 años, Eric Blank Injury Attorneys ha luchado para que las víctimas
						de accidentes obtengan la recuperación que merecen. Consulta gratuita, y sin
						honorarios a menos que ganemos.
					</p>
					<div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
						<a
							href="#contact"
							class="inline-flex w-full items-center justify-center rounded-md bg-brand-gold px-8 py-4 text-base font-bold text-brand-navy transition-colors hover:bg-[#d1a63b] sm:w-auto sm:text-lg"
						>
							Evaluación Gratuita de su Caso
						</a>
						<a
							href="tel:7022222115"
							class="inline-flex w-full items-center justify-center gap-2 rounded-md border border-white/30 px-8 py-4 text-base font-semibold text-white transition-colors hover:border-white hover:bg-white/10 sm:w-auto sm:text-lg"
						>
							<span class="[&>svg]:size-5" set:html={phoneIcon} aria-hidden="true" />
							(702) 222-2115
						</a>
					</div>
					<ul class="mx-auto mt-8 flex max-w-xl flex-wrap items-center justify-center gap-y-1 text-xs font-medium text-white/60 sm:text-sm">
						{
							heroTrust.map((item, index) => (
								<li
									class:list={[
										index > 0 &&
											"before:mx-2 before:text-brand-gold before:content-['•'] sm:before:mx-3",
									]}
								>
									{item}
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<!-- SECTION 2 — Trust strip -->
			<section class="border-b border-gray-200 bg-white">
				<div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
					<dl class="grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-4">
						{
							stats.map((stat) => (
								<div class="text-center">
									<dd class="text-3xl font-extrabold text-brand-navy sm:text-4xl">
										{stat.value}
									</dd>
									<dt class="mt-1 text-sm font-semibold text-gray-600">{stat.label}</dt>
									{stat.note && <p class="mt-0.5 text-xs text-gray-500">{stat.note}</p>}
								</div>
							))
						}
					</dl>
				</div>
			</section>

			<!-- SECTION 3 — What to do after a crash -->
			<section class="bg-white" aria-labelledby="steps-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Primeros Pasos
						</p>
						<h2
							id="steps-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Qué Hacer Después de un Accidente de Embarcación en Nevada
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							Las primeras horas después de un choque definen todo su reclamo. Así puede
							protegerse usted y proteger su caso.
						</p>
					</div>
					<ol class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3">
						{
							steps.map((step, index) => (
								<li class="rounded-lg border border-gray-200 bg-white p-6">
									<div class="flex items-center gap-3">
										<span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-navy text-sm font-bold text-brand-gold">
											{index + 1}
										</span>
										<span
											class="text-brand-navy [&>svg]:size-7"
											set:html={step.icon}
											aria-hidden="true"
										/>
									</div>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{step.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{step.text}
									</p>
								</li>
							))
						}
					</ol>
				</div>
			</section>

			<!-- SECTION 4 — How we help -->
			<section class="bg-gray-50" aria-labelledby="help-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Nuestro Enfoque
						</p>
						<h2
							id="help-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Cómo Eric Blank Injury Attorneys Maneja los Casos de Accidentes de Embarcaciones
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							Eric Blank pasó los primeros años de su carrera defendiendo a compañías de
							seguros. Aplicamos ese conocimiento interno a cada caso de embarcación — la
							misma ventaja que usamos en toda nuestra{" "}
							<a
								href="/es/areas-de-practica"
								class="font-semibold text-brand-navy underline decoration-brand-gold decoration-2 underline-offset-2 transition-colors hover:decoration-brand-navy"
							>
								práctica de lesiones personales
							</a>.
						</p>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
						{
							howWeHelp.map((item) => (
								<div class="rounded-lg border border-gray-200 bg-white p-6">
									<span
										class="block text-brand-navy [&>svg]:size-10"
										set:html={item.icon}
										aria-hidden="true"
									/>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{item.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{item.text}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- SECTION 5 — What you can recover -->
			<section class="bg-white" aria-labelledby="damages-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Daños y Perjuicios
						</p>
						<h2
							id="damages-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Lo Que las Víctimas de Accidentes de Embarcaciones Pueden Recuperar en Nevada
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							La ley de Nevada permite a las víctimas de accidentes recuperar daños
							compensatorios — tanto las pérdidas económicas concretas como el costo humano
							del accidente. En casos poco comunes de conducta especialmente imprudente,
							también pueden aplicarse daños punitivos.
						</p>
					</div>
					<div class="mx-auto mt-12 grid max-w-4xl grid-cols-1 gap-6 md:grid-cols-2 lg:mt-16">
						<div class="rounded-lg border border-gray-200 bg-white p-8">
							<h3 class="text-xl font-bold text-brand-navy">Daños Económicos</h3>
							<ul class="mt-5 space-y-3">
								{
									economicDamages.map((item) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-5"
												set:html={circleCheckIcon}
												aria-hidden="true"
											/>
											<span class="text-base text-gray-700">{item}</span>
										</li>
									))
								}
							</ul>
						</div>
						<div class="rounded-lg border border-gray-200 bg-white p-8">
							<h3 class="text-xl font-bold text-brand-navy">Daños No Económicos</h3>
							<ul class="mt-5 space-y-3">
								{
									nonEconomicDamages.map((item) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-5"
												set:html={circleCheckIcon}
												aria-hidden="true"
											/>
											<span class="text-base text-gray-700">{item}</span>
										</li>
									))
								}
							</ul>
						</div>
					</div>
					<p class="mx-auto mt-8 max-w-2xl text-center text-sm text-pretty text-gray-500">
						Nevada limita los daños en casos de negligencia médica pero no en los reclamos
						generales de lesiones personales. Los casos de embarcaciones pueden ser
						especialmente complejos porque el mismo accidente puede regirse por la ley de
						Nevada o por la ley marítima federal — lo cual puede afectar lo que usted
						recupera y dónde se escucha su caso. Una{" "}
						<a
							href="/es/contacto"
							class="font-semibold text-brand-navy underline decoration-brand-gold decoration-2 underline-offset-2 transition-colors hover:decoration-brand-navy"
						>
							consulta gratuita
						</a>{" "}
						es la mejor manera de entender cómo se aplican las reglas a su accidente.
					</p>
				</div>
			</section>

			<!-- SECTION 6 — Nevada law -->
			<section class="bg-gray-50" aria-labelledby="law-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Ley de Nevada
						</p>
						<h2
							id="law-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Leyes Clave de Nevada Sobre Accidentes de Embarcaciones
						</h2>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4 lg:mt-16">
						{
							nevadaLaws.map((law) => (
								<div class="rounded-lg border border-gray-200 bg-white p-6">
									<span
										class="block text-brand-navy [&>svg]:size-10"
										set:html={law.icon}
										aria-hidden="true"
									/>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{law.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{law.text}
									</p>
								</div>
							))
						}
					</div>
					<p class="mx-auto mt-8 max-w-2xl text-center text-sm text-pretty text-gray-500">
						Esta es información general, no asesoramiento legal para su caso específico. Hable
						con un abogado sobre los hechos de su accidente.
					</p>
				</div>
			</section>

			<!-- SECTION 7 — FAQ -->
			<section class="bg-white" aria-labelledby="faq-heading">
				<div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
					<div class="text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Preguntas Frecuentes
						</p>
						<h2
							id="faq-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Preguntas Comunes Sobre Accidentes de Embarcaciones
						</h2>
					</div>
					<div class="mt-10 space-y-8 lg:mt-12">
						{
							faqs.map((faq) => (
								<div>
									<h3 class="text-lg font-bold text-brand-navy sm:text-xl">{faq.q}</h3>
									<p class="mt-2 text-base leading-relaxed text-pretty text-gray-600">
										{faq.a}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- SECTION 8 — Featured testimonial -->
			<section class="bg-gray-50">
				<div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20">
					<figure>
						<span
							aria-hidden="true"
							class="mx-auto block w-fit text-brand-navy/60 [&>svg]:size-10"
							set:html={quoteIcon}
						/>
						<blockquote class="mt-5 text-xl font-medium text-balance text-brand-navy sm:text-2xl">
							I had terrible injuries as a result of the accident I had and hiring Eric
							Blank to be on my side during this difficult process was the best thing I did.
						</blockquote>
						<figcaption class="mt-5 text-base font-bold text-brand-navy">— Tami</figcaption>
					</figure>
					<p class="mt-3 text-xs text-gray-500">Reseña original en inglés.</p>
					<a
						href="/es/resenas"
						class="mt-6 inline-block text-sm font-semibold text-brand-navy transition-colors hover:text-brand-gold"
					>
						Lea más reseñas de clientes →
					</a>
				</div>
			</section>

			<!-- Video testimonial carousel -->
			<TestimonialCarousel lang="es" />

			<!-- SECTION 9 — Final CTA + contact form -->
			<section
				id="contact"
				class="scroll-mt-24 bg-brand-navy text-white"
				aria-labelledby="cta-heading"
			>
				<div class="mx-auto max-w-[1200px] px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<h2
							id="cta-heading"
							class="text-3xl font-bold tracking-tight text-balance sm:text-4xl"
						>
							Solicite su Evaluación Gratuita de Caso
						</h2>
						<p class="mt-3 text-base text-pretty text-white/70 sm:text-lg">
							Es gratis, confidencial y sin compromiso.
						</p>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-start lg:gap-16">
						<div>
							<p class="text-sm font-semibold tracking-wider text-brand-gold uppercase">
								Por Qué Llamar Ahora
							</p>
							<h3 class="mt-3 text-xl font-bold sm:text-2xl">
								Tres Razones Para Contactarnos Hoy
							</h3>
							<ul class="mt-6 space-y-4">
								{
									contactReasons.map((reason) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-6"
												set:html={reason.icon}
												aria-hidden="true"
											/>
											<span class="text-base text-white/90 sm:text-lg">{reason.text}</span>
										</li>
									))
								}
							</ul>
							<p class="mt-6 max-w-md text-base text-pretty text-white/70">
								La mayoría de los reclamos por accidentes de embarcaciones en Nevada tienen
								plazos estrictos — y la evidencia que los gana desaparece rápido. Cuanto
								antes nos contacte, más podremos hacer.
							</p>
						</div>
						<ContactForm lang="es" />
					</div>
				</div>
			</section>
		</main>
		<Footer lang="es" />
		<!-- Universal media lightbox (used by the carousel) -->
		<Lightbox />
	</body>
</html>
