---
import '../../../styles/global.css';
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ContactForm from '../../../components/ContactForm.astro';
import TestimonialCarousel from '../../../components/TestimonialCarousel.astro';
import Lightbox from '../../../components/Lightbox.astro';
import { firmNode, attorneyNode } from '../../../data/firm';

import phoneIcon from 'lucide-static/icons/phone.svg?raw';
import shieldIcon from 'lucide-static/icons/shield.svg?raw';
import phoneCallIcon from 'lucide-static/icons/phone-call.svg?raw';
import cameraIcon from 'lucide-static/icons/camera.svg?raw';
import stethoscopeIcon from 'lucide-static/icons/stethoscope.svg?raw';
import banIcon from 'lucide-static/icons/ban.svg?raw';
import scaleIcon from 'lucide-static/icons/scale.svg?raw';
import searchIcon from 'lucide-static/icons/search.svg?raw';
import clipboardListIcon from 'lucide-static/icons/clipboard-list.svg?raw';
import handshakeIcon from 'lucide-static/icons/handshake.svg?raw';
import gavelIcon from 'lucide-static/icons/gavel.svg?raw';
import circleCheckIcon from 'lucide-static/icons/circle-check.svg?raw';
import calendarClockIcon from 'lucide-static/icons/calendar-clock.svg?raw';
import shieldCheckIcon from 'lucide-static/icons/shield-check.svg?raw';
import quoteIcon from 'lucide-static/icons/quote.svg?raw';
import checkCircleIcon from 'lucide-static/icons/check-circle.svg?raw';
import circleDollarSignIcon from 'lucide-static/icons/circle-dollar-sign.svg?raw';
import clockIcon from 'lucide-static/icons/clock.svg?raw';
import fileTextIcon from 'lucide-static/icons/file-text.svg?raw';

const title = "Abogado de Litigios Masivos y Productos Peligrosos en Las Vegas | Eric Blank Injury Attorneys | (702) 222-2115";
const description =
	"¿Lesionado por un medicamento defectuoso, un dispositivo médico o un producto peligroso? Eric Blank Injury Attorneys ayuda a las víctimas de Nevada a buscar compensación individual en litigios masivos. Consulta gratuita. Sin honorarios a menos que ganemos. Llame al (702) 222-2115.";

const heroTrust = ["Más de 26 Años", "Millones Recuperados", "Disponibles 24/7", "Consulta Gratuita"];

const stats = [
	{ value: "Millones", label: "Recuperados para Víctimas de Accidentes" },
	{ value: "Miles", label: "de Casos de Lesiones Manejados" },
	{ value: "$0", label: "de Su Bolsillo", note: "Solo honorarios de contingencia" },
	{ value: "24/7", label: "Consulta Gratuita" },
];

const steps = [
	{
		icon: shieldIcon,
		title: "Conserve el Producto y los Registros",
		text: "Guarde el medicamento, el dispositivo, el empaque, los recibos y cualquier registro médico que conecte su lesión con el producto. Esta evidencia vincula su daño con el demandado.",
	},
	{
		icon: stethoscopeIcon,
		title: "Documente Su Lesión",
		text: "Hágase una evaluación médica completa. En los casos de litigio masivo, el expediente médico que prueba su lesión específica y su causa es el núcleo de su reclamo individual.",
	},
	{
		icon: calendarClockIcon,
		title: "No Asuma Que Es Demasiado Tarde",
		text: "Estas lesiones a menudo aparecen años después de la exposición. La regla del descubrimiento de Nevada puede darle más tiempo del que cree — pero los plazos son estrictos, así que actúe rápido.",
	},
	{
		icon: scaleIcon,
		title: "Hable con un Abogado Antes de Unirse a Nada",
		text: "Los anuncios de 'acuerdos' en internet y los servicios de presentación de reclamos no son despachos de abogados. Hable con un abogado que pueda evaluar su caso individual antes de inscribirse en nada.",
	},
];

const howWeHelp = [
	{
		icon: searchIcon,
		title: "Evaluamos Su Reclamo Individual",
		text: "Litigio masivo significa muchos casos, pero el suyo sigue siendo propio. Evaluamos si su lesión, su exposición y su cronología encajan en un litigio activo.",
	},
	{
		icon: handshakeIcon,
		title: "Lo Conectamos con el Litigio Coordinado",
		text: "Cuando ya existe un litigio multidistrital (MDL) o un procedimiento coordinado, posicionamos su reclamo para beneficiarse del descubrimiento de pruebas compartido y del trabajo ya establecido.",
	},
	{
		icon: fileTextIcon,
		title: "Construimos Sus Daños Específicos",
		text: "Su compensación depende de sus propias lesiones, costos y pérdidas — no de un promedio de grupo. Documentamos el panorama completo.",
	},
	{
		icon: gavelIcon,
		title: "Enfrentamos a Demandados con Grandes Recursos",
		text: "Los fabricantes de medicamentos y dispositivos tienen equipos legales de gran alcance. Nosotros tenemos los recursos y la experiencia para hacerles frente.",
	},
];

const economicDamages = [
	"Gastos médicos (pasados y futuros)",
	"Salarios perdidos y capacidad de ingresos",
	"Costos continuos de cuidado y tratamiento",
	"Gastos de bolsillo",
];

const nonEconomicDamages = [
	"Dolor y sufrimiento",
	"Discapacidad o desfiguración permanente",
	"Pérdida del disfrute de la vida",
	"Angustia emocional",
];

const nevadaLaws = [
	{
		icon: scaleIcon,
		title: "Litigio Masivo vs. Demanda Colectiva",
		text: "No son lo mismo. En un litigio masivo, cada persona lesionada conserva un reclamo individual, pero los casos a menudo se coordinan por eficiencia. En una demanda colectiva, muchas personas se agrupan en un solo caso y comparten un resultado común. Los casos de lesiones graves a menudo proceden como litigios masivos porque las lesiones, los daños y las necesidades médicas de cada persona son diferentes.",
	},
	{
		icon: shieldCheckIcon,
		title: "Sigue Siendo un Reclamo de Lesiones de Nevada",
		text: "Un litigio masivo es una forma de organizar los casos, no un área del derecho aparte. En esencia, su reclamo se basa en los principios de lesiones personales y responsabilidad del producto de Nevada — incluida la responsabilidad estricta por productos defectuosos, establecida a través de la jurisprudencia de Nevada.",
	},
	{
		icon: calendarClockIcon,
		title: "La Regla del Descubrimiento Puede Extender Su Plazo",
		text: "El plazo general de Nevada para lesiones personales es de dos años (NRS 11.190). Pero las lesiones por medicamentos, dispositivos y químicos a menudo aparecen mucho después de la exposición. Los tribunales de Nevada aplican una 'regla del descubrimiento' que puede iniciar el conteo cuando usted descubre — o razonablemente debió haber descubierto — que un producto causó su daño. Si aplica o no depende de los hechos, así que no asuma nada en ningún sentido.",
	},
	{
		icon: clockIcon,
		title: "Ningún Plazo Merece Adivinarse",
		text: "Debido a que los tiempos en estos casos dependen de cuándo apareció su lesión y de lo que usted sabía, la única jugada segura es una evaluación temprana del caso. Esperar puede costarle de forma permanente el derecho a recuperar compensación.",
	},
];

const faqs = [
	{
		q: "¿Qué es un litigio masivo?",
		a: "Un litigio masivo es lo que ocurre cuando un producto, medicamento o dispositivo peligroso daña a muchas personas. En lugar de una sola demanda combinada, cada persona lesionada puede presentar su propio reclamo individual, a menudo coordinado con otros para compartir evidencia y avanzar con mayor eficiencia.",
	},
	{
		q: "¿Es lo mismo que una demanda colectiva?",
		a: "No. En una demanda colectiva, todos se agrupan en un solo caso con un solo resultado. En un litigio masivo, su caso sigue siendo suyo — sus lesiones, sus daños, su resultado. La mayoría de los casos de productos con lesiones graves proceden como litigios masivos por esa razón.",
	},
	{
		q: "¿Cómo sé si tengo un caso?",
		a: "Depende del producto, de su lesión específica y de cuándo estuvo expuesto y resultó dañado. La manera más rápida de averiguarlo es una evaluación gratuita y confidencial en la que analizamos su situación individual.",
	},
	{
		q: "¿Es demasiado tarde si estuve expuesto hace años?",
		a: "Quizá no. Muchas de estas lesiones no aparecen durante años, y la regla del descubrimiento de Nevada a veces puede iniciar el plazo cuando se descubre el daño en lugar de cuando ocurrió la exposición. Depende de los hechos — hable con nosotros antes de asumir que perdió su oportunidad.",
	},
	{
		q: "¿Cuánto cuesta contratarlos?",
		a: "Nada por adelantado. Trabajamos con honorarios de contingencia — sin honorarios a menos que recuperemos compensación para usted.",
	},
	{
		q: "¿Tendré que ir a juicio?",
		a: "Muchos reclamos de litigio masivo se resuelven mediante acuerdo, pero no todos. Preparamos cada caso como si pudiera ir a juicio, lo que lo coloca en la posición más fuerte, se resuelva o no por acuerdo.",
	},
];

const contactReasons = [
	{ text: "Evaluación de caso gratuita y sin compromiso", icon: checkCircleIcon },
	{ text: "Sin honorarios a menos que ganemos su caso", icon: circleDollarSignIcon },
	{ text: "Disponibles 24/7 — noches, fines de semana y días festivos", icon: clockIcon },
];

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		firmNode,
		{
			"@type": "LegalService",
			"@id": "https://ericblanklaw.com/es/areas-de-practica/litigios-masivos#service",
			name: "Eric Blank Injury Attorneys — Representación en Litigios Masivos y Productos Peligrosos",
			serviceType: "Servicios Legales de Litigios Masivos y Productos Peligrosos",
			url: "https://ericblanklaw.com/es/areas-de-practica/litigios-masivos",
			image: "https://ericblanklaw.com/Eric_Blank_Injury_Attorneys_Logo.png",
			priceRange: "Honorarios de Contingencia — Sin Honorarios a Menos Que Ganemos",
			inLanguage: "es",
			provider: { "@id": "https://ericblanklaw.com/#legalservice" },
			employee: { "@id": "https://ericblanklaw.com/#attorney" },
		},
		attorneyNode,
		{
			"@type": "FAQPage",
			"@id": "https://ericblanklaw.com/es/areas-de-practica/litigios-masivos#faq",
			inLanguage: "es",
			mainEntity: faqs.map((faq) => ({
				"@type": "Question",
				name: faq.q,
				acceptedAnswer: { "@type": "Answer", text: faq.a },
			})),
		},
	],
};
---

<html lang="es">
	<head>
		<BaseHead
			title={title}
			description={description}
			canonical="https://ericblanklaw.com/es/areas-de-practica/litigios-masivos"
			lang="es"
		/>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body class="overflow-x-clip">
		<Header lang="es" />
		<main>
			<!-- SECTION 1 — Hero -->
			<section class="relative bg-brand-navy text-white">
				<div class="absolute inset-0 bg-cover bg-center" style="background-image:url('/mass-tort-hero.jpeg')" aria-hidden="true"></div>
				<div class="absolute inset-0 bg-brand-navy/75" aria-hidden="true"></div>
				<div class="relative mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:py-24">
					<p class="text-sm font-semibold tracking-wider text-brand-gold uppercase">
						Litigios Masivos y Productos Peligrosos
					</p>
					<h1 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-5xl">
						¿Dañado por un Medicamento, Dispositivo o Producto Defectuoso?
					</h1>
					<p class="mx-auto mt-4 max-w-2xl text-base text-pretty text-white/70 sm:text-lg">
						No tiene que enfrentar al fabricante solo. Cuando un producto peligroso causa daño a
						muchas personas, ayudamos a las víctimas de Nevada a buscar compensación mediante
						reclamos individuales y litigios coordinados.
					</p>
					<div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
						<a
							href="#contact"
							class="inline-flex w-full items-center justify-center rounded-md bg-brand-gold px-8 py-4 text-base font-bold text-brand-navy transition-colors hover:bg-[#d1a63b] sm:w-auto sm:text-lg"
						>
							Evaluación Gratuita de su Caso
						</a>
						<a
							href="tel:7022222115"
							class="inline-flex w-full items-center justify-center gap-2 rounded-md border border-white/30 px-8 py-4 text-base font-semibold text-white transition-colors hover:border-white hover:bg-white/10 sm:w-auto sm:text-lg"
						>
							<span class="[&>svg]:size-5" set:html={phoneIcon} aria-hidden="true" />
							(702) 222-2115
						</a>
					</div>
					<ul class="mx-auto mt-8 flex max-w-xl flex-wrap items-center justify-center gap-y-1 text-xs font-medium text-white/60 sm:text-sm">
						{
							heroTrust.map((item, index) => (
								<li
									class:list={[
										index > 0 &&
											"before:mx-2 before:text-brand-gold before:content-['•'] sm:before:mx-3",
									]}
								>
									{item}
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<!-- SECTION 2 — Trust strip -->
			<section class="border-b border-gray-200 bg-white">
				<div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
					<dl class="grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-4">
						{
							stats.map((stat) => (
								<div class="text-center">
									<dd class="text-3xl font-extrabold text-brand-navy sm:text-4xl">
										{stat.value}
									</dd>
									<dt class="mt-1 text-sm font-semibold text-gray-600">{stat.label}</dt>
									{stat.note && <p class="mt-0.5 text-xs text-gray-500">{stat.note}</p>}
								</div>
							))
						}
					</dl>
				</div>
			</section>

			<!-- SECTION 3 — First steps -->
			<section class="bg-white" aria-labelledby="steps-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Primeros Pasos
						</p>
						<h2
							id="steps-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Qué Hacer Si Ha Sido Dañado por un Producto Peligroso
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							Estos casos se construyen sobre la evidencia y los tiempos. Así puede proteger
							su salud y su reclamo.
						</p>
					</div>
					<ol class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3">
						{
							steps.map((step, index) => (
								<li class="rounded-lg border border-gray-200 bg-white p-6">
									<div class="flex items-center gap-3">
										<span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-navy text-sm font-bold text-brand-gold">
											{index + 1}
										</span>
										<span
											class="text-brand-navy [&>svg]:size-7"
											set:html={step.icon}
											aria-hidden="true"
										/>
									</div>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{step.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{step.text}
									</p>
								</li>
							))
						}
					</ol>
				</div>
			</section>

			<!-- SECTION 4 — How we help -->
			<section class="bg-gray-50" aria-labelledby="help-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Nuestro Enfoque
						</p>
						<h2
							id="help-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Cómo Eric Blank Injury Attorneys Maneja los Casos de Litigio Masivo
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							Eric Blank pasó los primeros años de su carrera defendiendo a compañías de
							seguros. Aplicamos ese conocimiento interno a cada caso de litigio masivo —
							la misma ventaja que usamos en toda nuestra{" "}
							<a
								href="/es/areas-de-practica"
								class="font-semibold text-brand-navy underline decoration-brand-gold decoration-2 underline-offset-2 transition-colors hover:decoration-brand-navy"
							>
								práctica de lesiones personales
							</a>.
						</p>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
						{
							howWeHelp.map((item) => (
								<div class="rounded-lg border border-gray-200 bg-white p-6">
									<span
										class="block text-brand-navy [&>svg]:size-10"
										set:html={item.icon}
										aria-hidden="true"
									/>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{item.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{item.text}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- SECTION 5 — What you can recover -->
			<section class="bg-white" aria-labelledby="damages-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Daños y Perjuicios
						</p>
						<h2
							id="damages-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Lo Que las Víctimas de Litigios Masivos Pueden Recuperar en Nevada
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							La ley de Nevada permite a las víctimas de lesiones recuperar daños
							compensatorios — tanto las pérdidas económicas concretas como el costo humano
							de la lesión. En casos poco comunes de conducta especialmente imprudente,
							también pueden aplicarse daños punitivos.
						</p>
					</div>
					<div class="mx-auto mt-12 grid max-w-4xl grid-cols-1 gap-6 md:grid-cols-2 lg:mt-16">
						<div class="rounded-lg border border-gray-200 bg-white p-8">
							<h3 class="text-xl font-bold text-brand-navy">Daños Económicos</h3>
							<ul class="mt-5 space-y-3">
								{
									economicDamages.map((item) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-5"
												set:html={circleCheckIcon}
												aria-hidden="true"
											/>
											<span class="text-base text-gray-700">{item}</span>
										</li>
									))
								}
							</ul>
						</div>
						<div class="rounded-lg border border-gray-200 bg-white p-8">
							<h3 class="text-xl font-bold text-brand-navy">Daños No Económicos</h3>
							<ul class="mt-5 space-y-3">
								{
									nonEconomicDamages.map((item) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-5"
												set:html={circleCheckIcon}
												aria-hidden="true"
											/>
											<span class="text-base text-gray-700">{item}</span>
										</li>
									))
								}
							</ul>
						</div>
					</div>
					<p class="mx-auto mt-8 max-w-2xl text-center text-sm text-pretty text-gray-500">
						Cada reclamo de litigio masivo es individual, y lo que usted puede recuperar
						depende de sus propias lesiones, costos y pérdidas. Una{" "}
						<a
							href="/es/contacto"
							class="font-semibold text-brand-navy underline decoration-brand-gold decoration-2 underline-offset-2 transition-colors hover:decoration-brand-navy"
						>
							consulta gratuita
						</a>{" "}
						es la mejor manera de entender cuánto puede valer su caso específico.
					</p>
				</div>
			</section>

			<!-- SECTION 6 — Nevada law -->
			<section class="bg-gray-50" aria-labelledby="law-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Ley de Nevada
						</p>
						<h2
							id="law-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Leyes Clave de Nevada Sobre Litigios Masivos
						</h2>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4 lg:mt-16">
						{
							nevadaLaws.map((law) => (
								<div class="rounded-lg border border-gray-200 bg-white p-6">
									<span
										class="block text-brand-navy [&>svg]:size-10"
										set:html={law.icon}
										aria-hidden="true"
									/>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{law.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{law.text}
									</p>
								</div>
							))
						}
					</div>
					<p class="mx-auto mt-8 max-w-2xl text-center text-sm text-pretty text-gray-500">
						Esta es información general, no asesoramiento legal para su caso específico. Hable
						con un abogado sobre los hechos de su accidente.
					</p>
				</div>
			</section>

			<!-- SECTION 7 — FAQ -->
			<section class="bg-white" aria-labelledby="faq-heading">
				<div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
					<div class="text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Preguntas Frecuentes
						</p>
						<h2
							id="faq-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Preguntas Comunes Sobre Litigios Masivos
						</h2>
					</div>
					<div class="mt-10 space-y-8 lg:mt-12">
						{
							faqs.map((faq) => (
								<div>
									<h3 class="text-lg font-bold text-brand-navy sm:text-xl">{faq.q}</h3>
									<p class="mt-2 text-base leading-relaxed text-pretty text-gray-600">
										{faq.a}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- SECTION 8 — Featured testimonial -->
			<section class="bg-gray-50">
				<div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20">
					<figure>
						<span
							aria-hidden="true"
							class="mx-auto block w-fit text-brand-navy/60 [&>svg]:size-10"
							set:html={quoteIcon}
						/>
						<blockquote class="mt-5 text-xl font-medium text-balance text-brand-navy sm:text-2xl">
							I had terrible injuries as a result of the accident I had and hiring Eric
							Blank to be on my side during this difficult process was the best thing I did.
						</blockquote>
						<figcaption class="mt-5 text-base font-bold text-brand-navy">— Tami</figcaption>
					</figure>
					<p class="mt-3 text-xs text-gray-500">Reseña original en inglés.</p>
					<a
						href="/es/resenas"
						class="mt-6 inline-block text-sm font-semibold text-brand-navy transition-colors hover:text-brand-gold"
					>
						Lea más reseñas de clientes →
					</a>
				</div>
			</section>

			<!-- Video testimonial carousel -->
			<TestimonialCarousel lang="es" />

			<!-- SECTION 9 — Final CTA + contact form -->
			<section
				id="contact"
				class="scroll-mt-24 bg-brand-navy text-white"
				aria-labelledby="cta-heading"
			>
				<div class="mx-auto max-w-[1200px] px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<h2
							id="cta-heading"
							class="text-3xl font-bold tracking-tight text-balance sm:text-4xl"
						>
							¿Lesionado por un Producto Que Debió Ser Seguro?
						</h2>
						<p class="mt-3 text-base text-pretty text-white/70 sm:text-lg">
							No tiene que enfrentar solo al equipo legal de un fabricante. Averigüe dónde
							está parado su reclamo individual — gratis y confidencial.
						</p>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-start lg:gap-16">
						<div>
							<p class="text-sm font-semibold tracking-wider text-brand-gold uppercase">
								Por Qué Llamar Ahora
							</p>
							<h3 class="mt-3 text-xl font-bold sm:text-2xl">
								Tres Razones Para Contactarnos Hoy
							</h3>
							<ul class="mt-6 space-y-4">
								{
									contactReasons.map((reason) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-6"
												set:html={reason.icon}
												aria-hidden="true"
											/>
											<span class="text-base text-white/90 sm:text-lg">{reason.text}</span>
										</li>
									))
								}
							</ul>
							<p class="mt-6 max-w-md text-base text-pretty text-white/70">
								La mayoría de los reclamos por lesiones causadas por productos tienen plazos
								estrictos — y la evidencia que los gana desaparece rápido. Cuanto antes nos
								contacte, más podremos hacer.
							</p>
						</div>
						<ContactForm lang="es" />
					</div>
				</div>
			</section>
		</main>
		<Footer lang="es" />
		<!-- Universal media lightbox (used by the carousel) -->
		<Lightbox />
	</body>
</html>
