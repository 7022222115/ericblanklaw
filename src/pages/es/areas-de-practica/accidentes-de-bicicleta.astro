---
import '../../../styles/global.css';
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ContactForm from '../../../components/ContactForm.astro';
import TestimonialCarousel from '../../../components/TestimonialCarousel.astro';
import Lightbox from '../../../components/Lightbox.astro';
import { firmNode, attorneyNode } from '../../../data/firm';

import phoneIcon from 'lucide-static/icons/phone.svg?raw';
import shieldIcon from 'lucide-static/icons/shield.svg?raw';
import phoneCallIcon from 'lucide-static/icons/phone-call.svg?raw';
import cameraIcon from 'lucide-static/icons/camera.svg?raw';
import stethoscopeIcon from 'lucide-static/icons/stethoscope.svg?raw';
import banIcon from 'lucide-static/icons/ban.svg?raw';
import scaleIcon from 'lucide-static/icons/scale.svg?raw';
import searchIcon from 'lucide-static/icons/search.svg?raw';
import clipboardListIcon from 'lucide-static/icons/clipboard-list.svg?raw';
import handshakeIcon from 'lucide-static/icons/handshake.svg?raw';
import gavelIcon from 'lucide-static/icons/gavel.svg?raw';
import circleCheckIcon from 'lucide-static/icons/circle-check.svg?raw';
import calendarClockIcon from 'lucide-static/icons/calendar-clock.svg?raw';
import shieldCheckIcon from 'lucide-static/icons/shield-check.svg?raw';
import quoteIcon from 'lucide-static/icons/quote.svg?raw';
import checkCircleIcon from 'lucide-static/icons/check-circle.svg?raw';
import circleDollarSignIcon from 'lucide-static/icons/circle-dollar-sign.svg?raw';
import clockIcon from 'lucide-static/icons/clock.svg?raw';

const title = "Abogado de Accidentes de Bicicleta en Las Vegas | Eric Blank Injury Attorneys | (702) 222-2115";
const description =
	"¿Lesionado en un accidente de bicicleta en Las Vegas? Eric Blank Injury Attorneys ha representado a ciclistas lesionados por más de 26 años. Consulta gratuita. Sin honorarios a menos que ganemos. Llame al (702) 222-2115.";

const heroTrust = ["Más de 26 Años", "Millones Recuperados", "Disponibles 24/7", "Consulta Gratuita"];

const stats = [
	{ value: "Millones", label: "Recuperados para Ciclistas Lesionados" },
	{ value: "Miles", label: "de Casos de Bicicleta Manejados" },
	{ value: "$0", label: "de Su Bolsillo", note: "Solo honorarios de contingencia" },
	{ value: "24/7", label: "Consulta Gratuita" },
];

const steps = [
	{
		icon: shieldIcon,
		title: "Póngase a Salvo",
		text: "Si puede moverse, salga del tráfico junto con su bicicleta. Si sospecha una lesión de cuello o espalda, quédese quieto y deje que los paramédicos lo evalúen primero. No mueva la bicicleta si puede evitarlo — su posición es evidencia.",
	},
	{
		icon: phoneCallIcon,
		title: "Llame al 911",
		text: "Obtenga un informe policial siempre. A veces los conductores intentan irse o trasladar la culpa al ciclista, y el informe del oficial que responde es la base de su caso.",
	},
	{
		icon: cameraIcon,
		title: "Documente Todo",
		text: "Fotografíe el vehículo, el camino, cualquier escombro, su bicicleta (especialmente los daños) y sus lesiones. Obtenga los datos del seguro, la licencia y la placa del conductor, además de los nombres y teléfonos de cada testigo.",
	},
	{
		icon: stethoscopeIcon,
		title: "Vea a un Médico",
		text: "Incluso con casco, los ciclistas sufren con frecuencia lesiones de cabeza, cuello e internas que aparecen después. Hágase evaluar de inmediato y siga cada recomendación de tratamiento — los vacíos en la atención son la forma en que las aseguradoras recortan su reclamo.",
	},
	{
		icon: banIcon,
		title: "No Hable con la Aseguradora del Otro",
		text: "La aseguradora del conductor llamará rápido. A menudo intentan sugerir que usted iba fuera del carril, que no llevaba luz o que estaba 'estorbando'. No entre en esa conversación — deje que su abogado se encargue de ellos.",
	},
	{
		icon: scaleIcon,
		title: "Llame Primero a un Abogado",
		text: "Antes de firmar cualquier cosa o aceptar una oferta, hable con un abogado. Los conductores suelen tener límites de póliza bajos — encontrar cobertura adicional (UM/UIM, pólizas paraguas, pólizas del empleador) requiere trabajo, pero puede marcar la diferencia en los casos graves de ciclismo.",
	},
];

const howWeHelp = [
	{
		icon: searchIcon,
		title: "Investigamos el Accidente",
		text: "Actuamos rápido con los videos de cámaras de tráfico, la evidencia de la escena y las declaraciones de testigos. También examinamos las acciones del conductor frente a la ley de ciclismo de Nevada — incluida la regla de los 3 pies al rebasar — para asegurar la responsabilidad antes de que la historia cambie.",
	},
	{
		icon: clipboardListIcon,
		title: "Construimos el Expediente Médico",
		text: "Las lesiones de ciclismo tienen capas: trauma de cabeza y cuello, daño interno, fracturas, tejidos blandos. Trabajamos con sus médicos para que el panorama médico completo, incluida la atención futura, quede documentado.",
	},
	{
		icon: handshakeIcon,
		title: "Negociamos con la Aseguradora",
		text: "La experiencia de Eric Blank en la defensa de aseguradoras nos dice dónde intentará recortar el ajustador. Exigimos la cobertura total disponible y combinamos pólizas donde la ley de Nevada lo permite.",
	},
	{
		icon: gavelIcon,
		title: "Llevamos el Caso a Juicio si Hace Falta",
		text: "Cuando un caso necesita un jurado, estamos listos. Las aseguradoras llegan a acuerdos más altos cuando saben que la amenaza de juicio es creíble.",
	},
];

const economicDamages = [
	"Gastos médicos — tratamiento pasado y futuro",
	"Salarios perdidos y reducción de su capacidad futura de ingresos",
	"Daños materiales a su bicicleta y equipo",
	"Gastos de bolsillo — transporte, medicamentos y más",
];

const nonEconomicDamages = [
	"Dolor y sufrimiento",
	"Angustia emocional",
	"Pérdida del disfrute de la vida",
	"Discapacidad o desfiguración permanente",
	"Pérdida de consorcio",
];

const nevadaLaws = [
	{
		icon: calendarClockIcon,
		title: "Plazo de Prescripción",
		text: "Nevada le da 2 años desde la fecha del accidente para presentar una demanda por accidente de bicicleta (NRS 11.190). Si pasa ese plazo, su reclamo se pierde — sin importar lo sólido que fuera.",
	},
	{
		icon: scaleIcon,
		title: "Negligencia Comparativa",
		text: "En Nevada, usted no pierde su caso solo por haber tenido parte de la culpa. Siempre que su grado de culpa sea del 50% o menos, aún puede presentar un reclamo, pero su recuperación se reducirá según su porcentaje de culpa. Sin embargo, cuando la otra parte logra llevar su responsabilidad por encima del 50%, la regla de negligencia comparativa modificada de Nevada generalmente le impide recuperar compensación alguna (NRS 41.141).",
	},
	{
		icon: shieldCheckIcon,
		title: "Derechos del Ciclista y Regla de los 3 Pies",
		text: "La ley de Nevada otorga a los ciclistas, en general, los mismos derechos y responsabilidades que a los conductores, y los automovilistas deben dejar al menos tres pies de distancia al rebasar una bicicleta según el Capítulo 484B de las NRS. Los límites mínimos de responsabilidad del conductor culpable son 25/50/20 — $25,000 por persona, $50,000 por accidente y $20,000 por daños materiales — lo cual suele ser insuficiente para lesiones graves de ciclismo, por lo que es esencial contar con una buena cobertura de motorista sin seguro / con seguro insuficiente (UM/UIM) en su propia póliza de auto.",
	},
];

const faqs = [
	{
		q: "¿Los ciclistas tienen los mismos derechos que los autos en Nevada?",
		a: "Sí. Según la ley de ciclismo de Nevada (Capítulo 484B de las NRS), las personas que circulan en bicicleta, bicicleta eléctrica o scooter eléctrico por las vías públicas tienen, en general, los mismos derechos y responsabilidades que los conductores de vehículos de motor. Eso significa que un conductor que atropella a un ciclista tiene el mismo deber de cuidado que uno que choca con otro auto.",
	},
	{
		q: "¿Qué es la regla de los 3 pies al rebasar?",
		a: "La ley de Nevada (Capítulo 484B de las NRS) exige que los conductores dejen al menos 3 pies de distancia al rebasar a un ciclista en el camino. Cuando es posible, el conductor debe pasarse al carril izquierdo adyacente. La violación de esta regla suele ser una pieza clave de evidencia de responsabilidad en nuestros casos de ciclismo.",
	},
	{
		q: "¿Nevada tiene una ley de casco para ciclistas?",
		a: "Nevada no tiene una ley estatal de casco de bicicleta para ciclistas de ninguna edad, pero usar un casco bien ajustado sigue siendo una de las formas más importantes de reducir el riesgo de lesiones graves de cabeza. La cobertura mínima de responsabilidad del conductor en un choque entre bicicleta y auto en Nevada es de 25/50/20 — $25,000 por persona, $50,000 por accidente y $20,000 por daños materiales — lo cual suele quedarse muy corto cuando un ciclista es atropellado. Una buena cobertura de motorista sin seguro y con seguro insuficiente en su propia póliza de auto puede ser crítica para compensar ese déficit y protegerse plenamente después de un accidente de bicicleta.",
	},
	{
		q: "¿Cuánto tiempo tengo para presentar un reclamo por accidente de bicicleta en Nevada?",
		a: "Dos años desde la fecha del accidente, según NRS 11.190. No espere — la evidencia y los testigos se desvanecen rápido, y los reclamos que involucran a entidades de gobierno (una intersección mal diseñada, por ejemplo) pueden tener plazos de notificación mucho más cortos.",
	},
	{
		q: "¿Qué pasa si el conductor no tiene suficiente seguro?",
		a: "Muchos conductores solo tienen la cobertura mínima de 25/50/20 de Nevada, que suele quedarse corta para lesiones graves de ciclismo. Revisamos la cobertura de motorista sin seguro / con seguro insuficiente de su propia póliza de auto (que puede aplicar aunque usted no iba en un auto), las pólizas paraguas y cualquier cobertura del empleador o comercial si el conductor estaba trabajando.",
	},
	{
		q: "¿Cuánto cuesta contratar a un abogado de accidentes de bicicleta?",
		a: "Nuestros honorarios son de contingencia — sin costo inicial y sin cobro por hora. Solo nos pagan si ganamos, y el honorario es un porcentaje de su recuperación, pactado por escrito antes de empezar.",
	},
];

const contactReasons = [
	{ text: "Evaluación de caso gratuita y sin compromiso", icon: checkCircleIcon },
	{ text: "Sin honorarios a menos que ganemos su caso", icon: circleDollarSignIcon },
	{ text: "Disponibles 24/7 — noches, fines de semana y días festivos", icon: clockIcon },
];

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		firmNode,
		{
			"@type": "LegalService",
			"@id": "https://ericblanklaw.com/es/areas-de-practica/accidentes-de-bicicleta#service",
			name: "Eric Blank Injury Attorneys — Representación en Accidentes de Bicicleta",
			serviceType: "Servicios Legales de Accidentes de Bicicleta",
			url: "https://ericblanklaw.com/es/areas-de-practica/accidentes-de-bicicleta",
			image: "https://ericblanklaw.com/Eric_Blank_Injury_Attorneys_Logo.png",
			priceRange: "Honorarios de Contingencia — Sin Honorarios a Menos Que Ganemos",
			inLanguage: "es",
			provider: { "@id": "https://ericblanklaw.com/#legalservice" },
			employee: { "@id": "https://ericblanklaw.com/#attorney" },
		},
		attorneyNode,
		{
			"@type": "FAQPage",
			"@id": "https://ericblanklaw.com/es/areas-de-practica/accidentes-de-bicicleta#faq",
			inLanguage: "es",
			mainEntity: faqs.map((faq) => ({
				"@type": "Question",
				name: faq.q,
				acceptedAnswer: { "@type": "Answer", text: faq.a },
			})),
		},
	],
};
---

<html lang="es">
	<head>
		<BaseHead
			title={title}
			description={description}
			canonical="https://ericblanklaw.com/es/areas-de-practica/accidentes-de-bicicleta"
			lang="es"
		/>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body class="overflow-x-clip">
		<Header lang="es" />
		<main>
			<!-- SECTION 1 — Hero -->
			<section class="relative bg-brand-navy text-white">
				<div class="absolute inset-0 bg-cover bg-center" style="background-image:url('/bicycle-accidents-hero.jpeg')" aria-hidden="true"></div>
				<div class="absolute inset-0 bg-brand-navy/75" aria-hidden="true"></div>
				<div class="relative mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:py-24">
					<p class="text-sm font-semibold tracking-wider text-brand-gold uppercase">
						Accidentes de Bicicleta en Las Vegas
					</p>
					<h1 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-5xl">
						Abogado de Accidentes de Bicicleta en Las Vegas
					</h1>
					<p class="mx-auto mt-4 max-w-2xl text-base text-pretty text-white/70 sm:text-lg">
						Andar en bicicleta en Las Vegas — ya sea para ir al trabajo por el centro,
						recorrer el circuito de Red Rock o entrenar hacia el Lago Mead — significa
						compartir el camino con conductores que con demasiada frecuencia no miran. La
						ley de Nevada da a los ciclistas el mismo derecho al camino que a cualquier
						vehículo, pero las consecuencias de un choque no se parecen en nada. Por más de
						22 años, Eric Blank Injury Attorneys ha representado a ciclistas lesionados
						frente a los conductores y aseguradoras que causaron el daño. Consulta
						gratuita, y sin honorarios a menos que ganemos.
					</p>
					<div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
						<a
							href="#contact"
							class="inline-flex w-full items-center justify-center rounded-md bg-brand-gold px-8 py-4 text-base font-bold text-brand-navy transition-colors hover:bg-[#d1a63b] sm:w-auto sm:text-lg"
						>
							Evaluación Gratuita de su Caso
						</a>
						<a
							href="tel:7022222115"
							class="inline-flex w-full items-center justify-center gap-2 rounded-md border border-white/30 px-8 py-4 text-base font-semibold text-white transition-colors hover:border-white hover:bg-white/10 sm:w-auto sm:text-lg"
						>
							<span class="[&>svg]:size-5" set:html={phoneIcon} aria-hidden="true" />
							(702) 222-2115
						</a>
					</div>
					<ul class="mx-auto mt-8 flex max-w-xl flex-wrap items-center justify-center gap-y-1 text-xs font-medium text-white/60 sm:text-sm">
						{
							heroTrust.map((item, index) => (
								<li
									class:list={[
										index > 0 &&
											"before:mx-2 before:text-brand-gold before:content-['•'] sm:before:mx-3",
									]}
								>
									{item}
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<!-- SECTION 2 — Trust strip -->
			<section class="border-b border-gray-200 bg-white">
				<div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
					<dl class="grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-4">
						{
							stats.map((stat) => (
								<div class="text-center">
									<dd class="text-3xl font-extrabold text-brand-navy sm:text-4xl">
										{stat.value}
									</dd>
									<dt class="mt-1 text-sm font-semibold text-gray-600">{stat.label}</dt>
									{stat.note && <p class="mt-0.5 text-xs text-gray-500">{stat.note}</p>}
								</div>
							))
						}
					</dl>
				</div>
			</section>

			<!-- SECTION 3 — What to do after a crash -->
			<section class="bg-white" aria-labelledby="steps-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Primeros Pasos
						</p>
						<h2
							id="steps-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Qué Hacer Después de un Accidente de Bicicleta en Las Vegas
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							Las primeras horas después de un choque definen todo su reclamo. Así puede
							protegerse usted y proteger su caso.
						</p>
					</div>
					<ol class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3">
						{
							steps.map((step, index) => (
								<li class="rounded-lg border border-gray-200 bg-white p-6">
									<div class="flex items-center gap-3">
										<span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-navy text-sm font-bold text-brand-gold">
											{index + 1}
										</span>
										<span
											class="text-brand-navy [&>svg]:size-7"
											set:html={step.icon}
											aria-hidden="true"
										/>
									</div>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{step.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{step.text}
									</p>
								</li>
							))
						}
					</ol>
				</div>
			</section>

			<!-- SECTION 4 — How we help -->
			<section class="bg-gray-50" aria-labelledby="help-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Nuestro Enfoque
						</p>
						<h2
							id="help-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Cómo Eric Blank Injury Attorneys Maneja los Casos de Accidentes de Bicicleta
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							Eric Blank pasó los primeros años de su carrera defendiendo a compañías de
							seguros. Aplicamos ese conocimiento interno a cada reclamo de ciclismo — la
							misma ventaja que usamos en toda nuestra{" "}
							<a
								href="/es/areas-de-practica"
								class="font-semibold text-brand-navy underline decoration-brand-gold decoration-2 underline-offset-2 transition-colors hover:decoration-brand-navy"
							>
								práctica de lesiones personales
							</a>.
						</p>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
						{
							howWeHelp.map((item) => (
								<div class="rounded-lg border border-gray-200 bg-white p-6">
									<span
										class="block text-brand-navy [&>svg]:size-10"
										set:html={item.icon}
										aria-hidden="true"
									/>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{item.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{item.text}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- SECTION 5 — What you can recover -->
			<section class="bg-white" aria-labelledby="damages-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Daños y Perjuicios
						</p>
						<h2
							id="damages-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Lo Que los Ciclistas Pueden Recuperar en Nevada
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							La ley de Nevada permite a las víctimas de accidentes recuperar daños
							compensatorios — tanto las pérdidas económicas concretas como el costo humano
							del accidente. En casos poco comunes de conducta especialmente imprudente,
							también pueden aplicarse daños punitivos.
						</p>
					</div>
					<div class="mx-auto mt-12 grid max-w-4xl grid-cols-1 gap-6 md:grid-cols-2 lg:mt-16">
						<div class="rounded-lg border border-gray-200 bg-white p-8">
							<h3 class="text-xl font-bold text-brand-navy">Daños Económicos</h3>
							<ul class="mt-5 space-y-3">
								{
									economicDamages.map((item) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-5"
												set:html={circleCheckIcon}
												aria-hidden="true"
											/>
											<span class="text-base text-gray-700">{item}</span>
										</li>
									))
								}
							</ul>
						</div>
						<div class="rounded-lg border border-gray-200 bg-white p-8">
							<h3 class="text-xl font-bold text-brand-navy">Daños No Económicos</h3>
							<ul class="mt-5 space-y-3">
								{
									nonEconomicDamages.map((item) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-5"
												set:html={circleCheckIcon}
												aria-hidden="true"
											/>
											<span class="text-base text-gray-700">{item}</span>
										</li>
									))
								}
							</ul>
						</div>
					</div>
					<p class="mx-auto mt-8 max-w-2xl text-center text-sm text-pretty text-gray-500">
						Nevada limita los daños en casos de negligencia médica pero <strong>no</strong> en
						los reclamos generales de lesiones personales. La cantidad que puede recuperar
						depende de los detalles de su caso — una{" "}
						<a
							href="/es/contacto"
							class="font-semibold text-brand-navy underline decoration-brand-gold decoration-2 underline-offset-2 transition-colors hover:decoration-brand-navy"
						>
							consulta gratuita
						</a>{" "}
						es la mejor manera de obtener una respuesta real.
					</p>
				</div>
			</section>

			<!-- SECTION 6 — Nevada law -->
			<section class="bg-gray-50" aria-labelledby="law-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Ley de Nevada
						</p>
						<h2
							id="law-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Leyes Clave de Nevada Sobre Accidentes de Bicicleta
						</h2>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3 lg:mt-16">
						{
							nevadaLaws.map((law) => (
								<div class="rounded-lg border border-gray-200 bg-white p-6">
									<span
										class="block text-brand-navy [&>svg]:size-10"
										set:html={law.icon}
										aria-hidden="true"
									/>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{law.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{law.text}
									</p>
								</div>
							))
						}
					</div>
					<p class="mx-auto mt-8 max-w-2xl text-center text-sm text-pretty text-gray-500">
						Esta es información general, no asesoramiento legal para su caso específico. Hable
						con un abogado sobre los hechos de su accidente.
					</p>
				</div>
			</section>

			<!-- SECTION 7 — FAQ -->
			<section class="bg-white" aria-labelledby="faq-heading">
				<div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
					<div class="text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Preguntas Frecuentes
						</p>
						<h2
							id="faq-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Preguntas Comunes Sobre Accidentes de Bicicleta
						</h2>
					</div>
					<div class="mt-10 space-y-8 lg:mt-12">
						{
							faqs.map((faq) => (
								<div>
									<h3 class="text-lg font-bold text-brand-navy sm:text-xl">{faq.q}</h3>
									<p class="mt-2 text-base leading-relaxed text-pretty text-gray-600">
										{faq.a}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- SECTION 8 — Featured testimonial -->
			<section class="bg-gray-50">
				<div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20">
					<figure>
						<span
							aria-hidden="true"
							class="mx-auto block w-fit text-brand-navy/60 [&>svg]:size-10"
							set:html={quoteIcon}
						/>
						<blockquote class="mt-5 text-xl font-medium text-balance text-brand-navy sm:text-2xl">
							I had terrible injuries as a result of the accident I had and hiring Eric
							Blank to be on my side during this difficult process was the best thing I did.
						</blockquote>
						<figcaption class="mt-5 text-base font-bold text-brand-navy">— Tami</figcaption>
					</figure>
					<p class="mt-3 text-xs text-gray-500">Reseña original en inglés.</p>
					<a
						href="/es/resenas"
						class="mt-6 inline-block text-sm font-semibold text-brand-navy transition-colors hover:text-brand-gold"
					>
						Lea más reseñas de clientes →
					</a>
				</div>
			</section>

			<!-- Video testimonial carousel -->
			<TestimonialCarousel lang="es" />

			<!-- SECTION 9 — Final CTA + contact form -->
			<section
				id="contact"
				class="scroll-mt-24 bg-brand-navy text-white"
				aria-labelledby="cta-heading"
			>
				<div class="mx-auto max-w-[1200px] px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<h2
							id="cta-heading"
							class="text-3xl font-bold tracking-tight text-balance sm:text-4xl"
						>
							Solicite su Evaluación Gratuita de Caso
						</h2>
						<p class="mt-3 text-base text-pretty text-white/70 sm:text-lg">
							Es gratis, confidencial y sin compromiso.
						</p>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-start lg:gap-16">
						<div>
							<p class="text-sm font-semibold tracking-wider text-brand-gold uppercase">
								Por Qué Llamar Ahora
							</p>
							<h3 class="mt-3 text-xl font-bold sm:text-2xl">
								Tres Razones Para Contactarnos Hoy
							</h3>
							<ul class="mt-6 space-y-4">
								{
									contactReasons.map((reason) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-6"
												set:html={reason.icon}
												aria-hidden="true"
											/>
											<span class="text-base text-white/90 sm:text-lg">{reason.text}</span>
										</li>
									))
								}
							</ul>
							<p class="mt-6 max-w-md text-base text-pretty text-white/70">
								Los reclamos por accidentes de bicicleta en Nevada tienen plazos estrictos
								— y la evidencia que los gana desaparece rápido. Cuanto antes nos contacte,
								más podremos hacer.
							</p>
						</div>
						<ContactForm lang="es" />
					</div>
				</div>
			</section>
		</main>
		<Footer lang="es" />
		<!-- Universal media lightbox (used by the carousel) -->
		<Lightbox />
	</body>
</html>
