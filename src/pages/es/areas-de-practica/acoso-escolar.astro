---
import '../../../styles/global.css';
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ContactForm from '../../../components/ContactForm.astro';
import TestimonialCarousel from '../../../components/TestimonialCarousel.astro';
import Lightbox from '../../../components/Lightbox.astro';
import { firmNode, attorneyNode } from '../../../data/firm';

import phoneIcon from 'lucide-static/icons/phone.svg?raw';
import shieldIcon from 'lucide-static/icons/shield.svg?raw';
import phoneCallIcon from 'lucide-static/icons/phone-call.svg?raw';
import cameraIcon from 'lucide-static/icons/camera.svg?raw';
import stethoscopeIcon from 'lucide-static/icons/stethoscope.svg?raw';
import banIcon from 'lucide-static/icons/ban.svg?raw';
import scaleIcon from 'lucide-static/icons/scale.svg?raw';
import searchIcon from 'lucide-static/icons/search.svg?raw';
import clipboardListIcon from 'lucide-static/icons/clipboard-list.svg?raw';
import handshakeIcon from 'lucide-static/icons/handshake.svg?raw';
import gavelIcon from 'lucide-static/icons/gavel.svg?raw';
import circleCheckIcon from 'lucide-static/icons/circle-check.svg?raw';
import calendarClockIcon from 'lucide-static/icons/calendar-clock.svg?raw';
import shieldCheckIcon from 'lucide-static/icons/shield-check.svg?raw';
import quoteIcon from 'lucide-static/icons/quote.svg?raw';
import checkCircleIcon from 'lucide-static/icons/check-circle.svg?raw';
import circleDollarSignIcon from 'lucide-static/icons/circle-dollar-sign.svg?raw';
import clockIcon from 'lucide-static/icons/clock.svg?raw';
import fileTextIcon from 'lucide-static/icons/file-text.svg?raw';
import landmarkIcon from 'lucide-static/icons/landmark.svg?raw';

const title = "Abogado de Acoso Escolar y Seguridad Estudiantil en Las Vegas | Eric Blank Injury Attorneys | (702) 222-2115";
const description =
	"Cuando una escuela de Nevada no protege a un niño del acoso escolar, las familias tienen opciones. Eric Blank Injury Attorneys ofrece una conversación gratuita y confidencial sobre su situación. Llame al (702) 222-2115.";

const heroTrust = ["Más de 26 Años", "Millones Recuperados", "Disponibles 24/7", "Consulta Gratuita"];

const stats = [
	{ value: "Millones", label: "Recuperados para Víctimas de Accidentes" },
	{ value: "Miles", label: "de Casos de Lesiones Manejados" },
	{ value: "$0", label: "de Su Bolsillo", note: "Solo honorarios de contingencia" },
	{ value: "24/7", label: "Consulta Gratuita" },
];

const steps = [
	{
		icon: shieldIcon,
		title: "Asegúrese Primero de Que Su Hijo Esté a Salvo",
		text: "Antes de cualquier paso legal, enfóquese en la seguridad y el bienestar inmediatos de su hijo. La atención médica y el apoyo emocional vienen primero.",
	},
	{
		icon: clipboardListIcon,
		title: "Documente Todo",
		text: "Guarde mensajes, fotos, capturas de pantalla, registros médicos y de consejería, y las fechas de cualquier incidente. Anote a quién se lo informó en la escuela y cuándo.",
	},
	{
		icon: fileTextIcon,
		title: "Repórtelo por Escrito",
		text: "Las escuelas de Nevada tienen el deber de investigar el acoso escolar reportado. Reportarlo por escrito — y quedarse con una copia — crea un registro de que la escuela estaba al tanto.",
	},
	{
		icon: scaleIcon,
		title: "Hable con Alguien Que Pueda Explicarle Sus Opciones",
		text: "Los casos que involucran escuelas tienen reglas y plazos específicos, especialmente cuando se trata de un distrito escolar público. Una conversación temprana le ayuda a entender su situación.",
	},
];

const howWeHelp = [
	{
		icon: handshakeIcon,
		title: "Primero Escuchamos",
		text: "La situación de cada familia es diferente. Empezamos por entender qué le pasó a su hijo y qué necesita usted.",
	},
	{
		icon: searchIcon,
		title: "Investigamos lo Que la Escuela Sabía",
		text: "Examinamos si la escuela fue notificada, si siguió sus propias políticas y si cumplió con su deber legal de actuar.",
	},
	{
		icon: clipboardListIcon,
		title: "Le Explicamos Sus Opciones Realistas",
		text: "Somos honestos sobre lo que implica un reclamo contra una escuela o un distrito — incluidos los límites — para que pueda tomar una decisión informada.",
	},
	{
		icon: shieldIcon,
		title: "Acompañamos a Su Familia",
		text: "Si avanzamos juntos, nos encargamos de la parte legal para que usted pueda enfocarse en su hijo.",
	},
];

const economicDamages = [
	"Costos médicos y de consejería",
	"Gastos de terapia y tratamiento",
	"Costos de cambiar de escuela o programa",
	"Gastos de bolsillo relacionados",
];

const nonEconomicDamages = [
	"Dolor físico",
	"Daño emocional y psicológico",
	"Pérdida del disfrute de la escuela y de las actividades de la infancia",
];

const nevadaLaws = [
	{
		icon: shieldCheckIcon,
		title: "Las Escuelas Tienen el Deber Legal de Actuar",
		text: "La ley de Nevada (NRS 388.121 a 388.1395) prohíbe el acoso y el ciberacoso en las escuelas públicas y exige que el personal escolar lo reporte y lo investigue. Cuando una escuela es informada sobre un caso de acoso escolar pero no responde, puede haber incumplido el deber que la ley le impone.",
	},
	{
		icon: scaleIcon,
		title: "Los Padres Tienen Derecho a Exigir Acción",
		text: "La ley de Nevada reconoce específicamente la facultad de un padre o tutor de solicitar a un tribunal que obligue a una escuela a cumplir con su deber de brindar un entorno seguro — y establece que este recurso está disponible además de otras opciones legales que también pueden aplicar.",
	},
	{
		icon: landmarkIcon,
		title: "Los Reclamos Contra Escuelas Públicas Tienen Reglas Especiales",
		text: "Un distrito escolar público de Nevada es una entidad gubernamental. Eso implica requisitos específicos de notificación y un límite a los daños recuperables de un organismo gubernamental (actualmente $200,000 por reclamante, según NRS 41.035). Estas reglas hacen que la orientación legal temprana sea especialmente importante.",
	},
	{
		icon: calendarClockIcon,
		title: "Los Plazos Aplican — y Pueden Ser Cortos",
		text: "El plazo general de Nevada para lesiones personales es de dos años (NRS 11.190), pero los reclamos que involucran a una entidad gubernamental pueden tener sus propios pasos de notificación más tempranos. Como hay un menor involucrado, algunos plazos pueden funcionar de manera diferente. El paso más seguro es preguntar temprano.",
	},
];

const faqs = [
	{
		q: "¿Puedo demandar a una escuela por acoso escolar en Nevada?",
		a: "Posiblemente. Las escuelas de Nevada tienen el deber legal de ayudar a mantener seguros a los estudiantes y de responder al acoso escolar reportado. Que exista un reclamo depende de lo que la escuela sabía, de lo que hizo o dejó de hacer, y de cómo resultó dañado su hijo. La respuesta honesta es que depende de los hechos — por eso es necesaria una conversación con un abogado para aclarar las opciones.",
	},
	{
		q: "¿Qué pasa si la escuela es una escuela pública?",
		a: "Los distritos escolares públicos son entidades gubernamentales, lo que añade reglas especiales: requisitos de notificación y un límite a los daños que se pueden recuperar. No significa que usted no tenga opciones — significa que el camino es específico, y que recibir orientación temprano importa.",
	},
	{
		q: "¿Qué debo hacer ahora mismo?",
		a: "Asegúrese de que su hijo esté a salvo y apoyado, documente lo que ha pasado y reporte el acoso escolar a la escuela por escrito. Guarde copias de todo.",
	},
	{
		q: "¿Tendrá mi hijo que testificar o revivirlo?",
		a: "Manejamos estos casos con cuidado y con un enfoque en el bienestar de su hijo. En muchas situaciones, hay maneras de hacer avanzar un caso minimizando la participación de su hijo y protegiéndolo de estrés innecesario. Hablaremos con usted honestamente sobre el proceso y sobre qué esperar.",
	},
	{
		q: "¿Cuánto cuesta hablar con ustedes?",
		a: "Nada. La consulta es gratuita y confidencial, y si trabajamos juntos, no hay honorarios a menos que recuperemos compensación para usted.",
	},
	{
		q: "¿Es demasiado tarde si esto pasó hace tiempo?",
		a: "No necesariamente. Aunque el daño haya ocurrido hace algún tiempo, aún pueden aplicar plazos importantes, y en los casos que involucran a una escuela pueden llegar rápido. Cuanto antes pregunte, mejor oportunidad tiene de proteger sus opciones.",
	},
];

const contactReasons = [
	{ text: "Una conversación gratuita y confidencial", icon: checkCircleIcon },
	{ text: "Sin honorarios a menos que recuperemos para usted", icon: circleDollarSignIcon },
	{ text: "Avanzamos al ritmo adecuado para su familia", icon: clockIcon },
];

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		firmNode,
		{
			"@type": "LegalService",
			"@id": "https://ericblanklaw.com/es/areas-de-practica/acoso-escolar#service",
			name: "Eric Blank Injury Attorneys — Representación en Acoso Escolar y Seguridad Estudiantil",
			serviceType: "Servicios Legales de Acoso Escolar y Seguridad Estudiantil",
			url: "https://ericblanklaw.com/es/areas-de-practica/acoso-escolar",
			image: "https://ericblanklaw.com/Eric_Blank_Injury_Attorneys_Logo.png",
			priceRange: "Honorarios de Contingencia — Sin Honorarios a Menos Que Ganemos",
			inLanguage: "es",
			provider: { "@id": "https://ericblanklaw.com/#legalservice" },
			employee: { "@id": "https://ericblanklaw.com/#attorney" },
		},
		attorneyNode,
		{
			"@type": "FAQPage",
			"@id": "https://ericblanklaw.com/es/areas-de-practica/acoso-escolar#faq",
			inLanguage: "es",
			mainEntity: faqs.map((faq) => ({
				"@type": "Question",
				name: faq.q,
				acceptedAnswer: { "@type": "Answer", text: faq.a },
			})),
		},
	],
};
---

<html lang="es">
	<head>
		<BaseHead
			title={title}
			description={description}
			canonical="https://ericblanklaw.com/es/areas-de-practica/acoso-escolar"
			lang="es"
		/>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body class="overflow-x-clip">
		<Header lang="es" />
		<main>
			<!-- SECTION 1 — Hero -->
			<section class="relative bg-brand-navy text-white">
				<div class="absolute inset-0 bg-cover bg-center" style="background-image:url('/school-bullying-hero.jpeg')" aria-hidden="true"></div>
				<div class="absolute inset-0 bg-brand-navy/75" aria-hidden="true"></div>
				<div class="relative mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:py-24">
					<p class="text-sm font-semibold tracking-wider text-brand-gold uppercase">
						Acoso Escolar y Seguridad Estudiantil
					</p>
					<h1 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-5xl">
						Cuando una Escuela No Protege a un Niño
					</h1>
					<p class="mx-auto mt-4 max-w-2xl text-base text-pretty text-white/70 sm:text-lg">
						La ley de Nevada exige que las escuelas brinden un entorno de aprendizaje seguro y
						que actúen cuando se reporta acoso escolar. Cuando una escuela ignora las señales
						de advertencia y un niño resulta dañado, las familias tienen opciones. Estamos
						aquí para hablarlas con usted.
					</p>
					<div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
						<a
							href="#contact"
							class="inline-flex w-full items-center justify-center rounded-md bg-brand-gold px-8 py-4 text-base font-bold text-brand-navy transition-colors hover:bg-[#d1a63b] sm:w-auto sm:text-lg"
						>
							Hable con Nuestro Equipo
						</a>
						<a
							href="tel:7022222115"
							class="inline-flex w-full items-center justify-center gap-2 rounded-md border border-white/30 px-8 py-4 text-base font-semibold text-white transition-colors hover:border-white hover:bg-white/10 sm:w-auto sm:text-lg"
						>
							<span class="[&>svg]:size-5" set:html={phoneIcon} aria-hidden="true" />
							(702) 222-2115
						</a>
					</div>
					<ul class="mx-auto mt-8 flex max-w-xl flex-wrap items-center justify-center gap-y-1 text-xs font-medium text-white/60 sm:text-sm">
						{
							heroTrust.map((item, index) => (
								<li
									class:list={[
										index > 0 &&
											"before:mx-2 before:text-brand-gold before:content-['•'] sm:before:mx-3",
									]}
								>
									{item}
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<!-- SECTION 2 — Trust strip -->
			<section class="border-b border-gray-200 bg-white">
				<div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
					<dl class="grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-4">
						{
							stats.map((stat) => (
								<div class="text-center">
									<dd class="text-3xl font-extrabold text-brand-navy sm:text-4xl">
										{stat.value}
									</dd>
									<dt class="mt-1 text-sm font-semibold text-gray-600">{stat.label}</dt>
									{stat.note && <p class="mt-0.5 text-xs text-gray-500">{stat.note}</p>}
								</div>
							))
						}
					</dl>
				</div>
			</section>

			<!-- SECTION 3 — First steps -->
			<section class="bg-white" aria-labelledby="steps-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Primeros Pasos
						</p>
						<h2
							id="steps-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Si Su Hijo Sufre Acoso Escolar, Aquí Puede Empezar
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							Estos primeros pasos protegen a su hijo y preservan lo que importa si usted
							decide explorar sus opciones.
						</p>
					</div>
					<ol class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3">
						{
							steps.map((step, index) => (
								<li class="rounded-lg border border-gray-200 bg-white p-6">
									<div class="flex items-center gap-3">
										<span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-navy text-sm font-bold text-brand-gold">
											{index + 1}
										</span>
										<span
											class="text-brand-navy [&>svg]:size-7"
											set:html={step.icon}
											aria-hidden="true"
										/>
									</div>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{step.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{step.text}
									</p>
								</li>
							))
						}
					</ol>
				</div>
			</section>

			<!-- SECTION 4 — How we help -->
			<section class="bg-gray-50" aria-labelledby="help-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Nuestro Enfoque
						</p>
						<h2
							id="help-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Cómo Eric Blank Injury Attorneys Puede Ayudar
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							Abordamos estos casos con cuidado por la familia y por el niño que está en el
							centro de ellos — parte de cómo manejamos nuestra más amplia{" "}
							<a
								href="/es/areas-de-practica"
								class="font-semibold text-brand-navy underline decoration-brand-gold decoration-2 underline-offset-2 transition-colors hover:decoration-brand-navy"
							>
								práctica de lesiones personales
							</a>.
						</p>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
						{
							howWeHelp.map((item) => (
								<div class="rounded-lg border border-gray-200 bg-white p-6">
									<span
										class="block text-brand-navy [&>svg]:size-10"
										set:html={item.icon}
										aria-hidden="true"
									/>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{item.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{item.text}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- SECTION 5 — What you can recover -->
			<section class="bg-white" aria-labelledby="damages-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Daños y Perjuicios
						</p>
						<h2
							id="damages-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Lo Que las Familias Podrían Recuperar
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							Cuando la falta de acción de una escuela daña a un niño, la ley de Nevada puede
							permitir a una familia recuperar tanto los costos económicos concretos como el
							costo humano de lo que el niño ha vivido.
						</p>
					</div>
					<div class="mx-auto mt-12 grid max-w-4xl grid-cols-1 gap-6 md:grid-cols-2 lg:mt-16">
						<div class="rounded-lg border border-gray-200 bg-white p-8">
							<h3 class="text-xl font-bold text-brand-navy">Daños Económicos</h3>
							<ul class="mt-5 space-y-3">
								{
									economicDamages.map((item) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-5"
												set:html={circleCheckIcon}
												aria-hidden="true"
											/>
											<span class="text-base text-gray-700">{item}</span>
										</li>
									))
								}
							</ul>
						</div>
						<div class="rounded-lg border border-gray-200 bg-white p-8">
							<h3 class="text-xl font-bold text-brand-navy">Daños No Económicos</h3>
							<ul class="mt-5 space-y-3">
								{
									nonEconomicDamages.map((item) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-5"
												set:html={circleCheckIcon}
												aria-hidden="true"
											/>
											<span class="text-base text-gray-700">{item}</span>
										</li>
									))
								}
							</ul>
						</div>
					</div>
					<p class="mx-auto mt-8 max-w-2xl text-center text-sm text-pretty text-gray-500">
						La situación de cada familia es diferente, y lo que un reclamo puede implicar
						depende de los hechos específicos. Una{" "}
						<a
							href="/es/contacto"
							class="font-semibold text-brand-navy underline decoration-brand-gold decoration-2 underline-offset-2 transition-colors hover:decoration-brand-navy"
						>
							conversación gratuita y confidencial
						</a>{" "}
						es la mejor manera de entender sus opciones.
					</p>
				</div>
			</section>

			<!-- SECTION 6 — Nevada law -->
			<section class="bg-gray-50" aria-labelledby="law-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Ley de Nevada
						</p>
						<h2
							id="law-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Leyes Clave de Nevada Sobre Seguridad Estudiantil
						</h2>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4 lg:mt-16">
						{
							nevadaLaws.map((law) => (
								<div class="rounded-lg border border-gray-200 bg-white p-6">
									<span
										class="block text-brand-navy [&>svg]:size-10"
										set:html={law.icon}
										aria-hidden="true"
									/>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{law.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{law.text}
									</p>
								</div>
							))
						}
					</div>
					<p class="mx-auto mt-8 max-w-2xl text-center text-sm text-pretty text-gray-500">
						Esta es información general, no asesoramiento legal para su caso específico. Hable
						con un abogado sobre los hechos de su situación.
					</p>
				</div>
			</section>

			<!-- SECTION 7 — FAQ -->
			<section class="bg-white" aria-labelledby="faq-heading">
				<div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
					<div class="text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Preguntas Frecuentes
						</p>
						<h2
							id="faq-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Preguntas Comunes de las Familias
						</h2>
					</div>
					<div class="mt-10 space-y-8 lg:mt-12">
						{
							faqs.map((faq) => (
								<div>
									<h3 class="text-lg font-bold text-brand-navy sm:text-xl">{faq.q}</h3>
									<p class="mt-2 text-base leading-relaxed text-pretty text-gray-600">
										{faq.a}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- SECTION 8 — Featured testimonial -->
			<section class="bg-gray-50">
				<div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20">
					<figure>
						<span
							aria-hidden="true"
							class="mx-auto block w-fit text-brand-navy/60 [&>svg]:size-10"
							set:html={quoteIcon}
						/>
						<blockquote class="mt-5 text-xl font-medium text-balance text-brand-navy sm:text-2xl">
							I had terrible injuries as a result of the accident I had and hiring Eric
							Blank to be on my side during this difficult process was the best thing I did.
						</blockquote>
						<figcaption class="mt-5 text-base font-bold text-brand-navy">— Tami</figcaption>
					</figure>
					<p class="mt-3 text-xs text-gray-500">Reseña original en inglés.</p>
					<a
						href="/es/resenas"
						class="mt-6 inline-block text-sm font-semibold text-brand-navy transition-colors hover:text-brand-gold"
					>
						Lea más reseñas de clientes →
					</a>
				</div>
			</section>

			<!-- Video testimonial carousel -->
			<TestimonialCarousel lang="es" />

			<!-- SECTION 9 — Final CTA + contact form -->
			<section
				id="contact"
				class="scroll-mt-24 bg-brand-navy text-white"
				aria-labelledby="cta-heading"
			>
				<div class="mx-auto max-w-[1200px] px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<h2
							id="cta-heading"
							class="text-3xl font-bold tracking-tight text-balance sm:text-4xl"
						>
							Si Su Hijo Fue Dañado y la Escuela Debió Haber Actuado
						</h2>
						<p class="mt-3 text-base text-pretty text-white/70 sm:text-lg">
							No tiene que resolver esto solo. Hable con nuestro equipo — gratis,
							confidencial y a su ritmo.
						</p>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-start lg:gap-16">
						<div>
							<p class="text-sm font-semibold tracking-wider text-brand-gold uppercase">
								Qué Esperar
							</p>
							<h3 class="mt-3 text-xl font-bold sm:text-2xl">
								Una Conversación, No un Compromiso
							</h3>
							<ul class="mt-6 space-y-4">
								{
									contactReasons.map((reason) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-6"
												set:html={reason.icon}
												aria-hidden="true"
											/>
											<span class="text-base text-white/90 sm:text-lg">{reason.text}</span>
										</li>
									))
								}
							</ul>
							<p class="mt-6 max-w-md text-base text-pretty text-white/70">
								Los casos que involucran escuelas tienen reglas y plazos específicos, y el
								bienestar de su hijo es lo primero. Contactarnos simplemente le ayuda a
								entender sus opciones — sin presión y sin compromiso.
							</p>
						</div>
						<ContactForm lang="es" />
					</div>
				</div>
			</section>
		</main>
		<Footer lang="es" />
		<!-- Universal media lightbox (used by the carousel) -->
		<Lightbox />
	</body>
</html>
