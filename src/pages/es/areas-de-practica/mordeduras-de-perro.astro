---
import '../../../styles/global.css';
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ContactForm from '../../../components/ContactForm.astro';
import TestimonialCarousel from '../../../components/TestimonialCarousel.astro';
import Lightbox from '../../../components/Lightbox.astro';
import { firmNode, attorneyNode } from '../../../data/firm';

import phoneIcon from 'lucide-static/icons/phone.svg?raw';
import shieldIcon from 'lucide-static/icons/shield.svg?raw';
import phoneCallIcon from 'lucide-static/icons/phone-call.svg?raw';
import cameraIcon from 'lucide-static/icons/camera.svg?raw';
import stethoscopeIcon from 'lucide-static/icons/stethoscope.svg?raw';
import banIcon from 'lucide-static/icons/ban.svg?raw';
import scaleIcon from 'lucide-static/icons/scale.svg?raw';
import searchIcon from 'lucide-static/icons/search.svg?raw';
import clipboardListIcon from 'lucide-static/icons/clipboard-list.svg?raw';
import handshakeIcon from 'lucide-static/icons/handshake.svg?raw';
import gavelIcon from 'lucide-static/icons/gavel.svg?raw';
import circleCheckIcon from 'lucide-static/icons/circle-check.svg?raw';
import calendarClockIcon from 'lucide-static/icons/calendar-clock.svg?raw';
import shieldCheckIcon from 'lucide-static/icons/shield-check.svg?raw';
import quoteIcon from 'lucide-static/icons/quote.svg?raw';
import checkCircleIcon from 'lucide-static/icons/check-circle.svg?raw';
import circleDollarSignIcon from 'lucide-static/icons/circle-dollar-sign.svg?raw';
import clockIcon from 'lucide-static/icons/clock.svg?raw';

const title = "Abogado de Mordeduras de Perro en Las Vegas | Eric Blank Injury Attorneys | (702) 222-2115";
const description =
	"¿Mordido por un perro en Las Vegas? Eric Blank Injury Attorneys conoce el marco de negligencia de Nevada para mordeduras de perro y cómo probar la responsabilidad del dueño. Consulta gratuita. Sin honorarios a menos que ganemos. Llame al (702) 222-2115.";

const heroTrust = ["Más de 26 Años", "Millones Recuperados", "Disponibles 24/7", "Consulta Gratuita"];

const stats = [
	{ value: "Millones", label: "Recuperados para Víctimas de Mordeduras" },
	{ value: "Miles", label: "de Casos de Mordeduras de Perro Manejados" },
	{ value: "$0", label: "de Su Bolsillo", note: "Solo honorarios de contingencia" },
	{ value: "24/7", label: "Consulta Gratuita" },
];

const steps = [
	{
		icon: shieldIcon,
		title: "Póngase a Salvo",
		text: "Aléjese del perro. Si puede identificar al dueño de forma segura, obtenga su nombre, dirección e información de contacto antes de irse del lugar — y, si es posible, información sobre el perro (raza, color, placas, historial de vacunación).",
	},
	{
		icon: phoneCallIcon,
		title: "Reporte la Mordedura",
		text: "Llame al 911 si la lesión es seria, y reporte la mordedura a control de animales. En el Condado de Clark, se debe notificar a control de animales — el reporte de la mordedura pasa a formar parte del historial del perro, lo cual importa bajo el marco de negligencia de Nevada.",
	},
	{
		icon: cameraIcon,
		title: "Fotografíe Todo",
		text: "Fotografíe las heridas antes de que las limpien o venden, su ropa rasgada, el lugar de la mordedura y, si puede hacerlo con seguridad, al propio perro. Siga tomando fotos a medida que las heridas cambien en los días siguientes.",
	},
	{
		icon: stethoscopeIcon,
		title: "Vea a un Médico",
		text: "Las mordeduras de perro conllevan un serio riesgo de infección y a menudo requieren cuidado de seguimiento de las heridas, antibióticos y, en ocasiones, tratamiento reconstructivo. Hágase evaluar de inmediato y siga cada recomendación — los vacíos en el tratamiento se convierten en un problema para su reclamo.",
	},
	{
		icon: banIcon,
		title: "No Firme Nada",
		text: "El seguro de propietario de vivienda o de inquilino suele ser la fuente de pago en un caso de mordedura de perro. La aseguradora puede llamar rápido con una oferta baja o un formulario de liberación de responsabilidad — refiéralos a su abogado antes de firmar nada o dar una declaración grabada.",
	},
	{
		icon: scaleIcon,
		title: "Llame Primero a un Abogado",
		text: "Los casos de mordeduras de perro en Nevada dependen del historial del perro, el conocimiento del dueño y cualquier violación de ordenanzas. Un abogado puede actuar rápido para obtener los registros de control de animales y asegurar las declaraciones de los testigos antes de que desaparezcan.",
	},
];

const howWeHelp = [
	{
		icon: searchIcon,
		title: "Investigamos el Historial",
		text: "Los casos en Nevada dependen de lo que el dueño sabía. Obtenemos los registros de control de animales, el historial de mordeduras previas, las quejas del vecindario y los relatos de testigos para establecer la propensión peligrosa del perro — y el conocimiento que el dueño tenía de ella.",
	},
	{
		icon: clipboardListIcon,
		title: "Documentamos las Lesiones",
		text: "Las lesiones por mordedura de perro suelen tener varias capas: laceraciones, infecciones, daño a los nervios, cicatrices e impacto psicológico duradero — especialmente en los niños. Trabajamos con los médicos tratantes y, cuando hace falta, con cirujanos plásticos y profesionales de salud mental para documentar el panorama completo.",
	},
	{
		icon: handshakeIcon,
		title: "Negociamos con la Aseguradora",
		text: "La mayoría de los pagos en casos de mordeduras de perro provienen del seguro de propietario de vivienda o de inquilino. La experiencia de Eric Blank en la defensa de aseguradoras nos dice dónde recortan los ajustadores — y cómo contraatacar.",
	},
	{
		icon: gavelIcon,
		title: "Llevamos el Caso a Juicio si Hace Falta",
		text: "Preparamos cada caso de mordedura de perro como si fuera a presentarse ante un jurado. Es entonces cuando las ofertas de acuerdo mejoran.",
	},
];

const economicDamages = [
	"Gastos médicos — tratamiento pasado y futuro, incluida la cirugía reconstructiva",
	"Salarios perdidos y reducción de su capacidad futura de ingresos",
	"Terapia psicológica y tratamiento de salud mental",
	"Gastos de bolsillo — transporte, medicamentos y más",
];

const nonEconomicDamages = [
	"Dolor y sufrimiento",
	"Angustia emocional — a menudo significativa, especialmente en los niños",
	"Desfiguración y cicatrices permanentes",
	"Pérdida del disfrute de la vida",
	"Pérdida de consorcio",
];

const nevadaLaws = [
	{
		icon: calendarClockIcon,
		title: "Plazo de Prescripción",
		text: "Nevada le da 2 años desde la fecha de la mordedura para presentar una demanda por mordedura de perro (NRS 11.190). Si pasa ese plazo puede perder por completo el derecho a recuperar compensación — y los registros de control de animales y los recuerdos de los testigos se vuelven más difíciles de recuperar con el tiempo.",
	},
	{
		icon: scaleIcon,
		title: "Negligencia Comparativa",
		text: "Nevada aplica una regla de negligencia comparativa modificada en los casos de mordeduras de perro. Si usted tiene el 50% o menos de la culpa — por ejemplo, si un jurado lo encuentra parcialmente responsable de provocar al perro — aún puede recuperar compensación, pero sus daños se reducen según su porcentaje de culpa. Si tiene más del 50% de la culpa, generalmente no puede recuperar nada (NRS 41.141).",
	},
	{
		icon: shieldCheckIcon,
		title: "Cómo Asigna Nevada la Responsabilidad",
		text: "Nevada no tiene una ley amplia de responsabilidad estricta por mordeduras de perro, así que los dueños no son automáticamente responsables solo porque ocurra una mordedura. En cambio, la responsabilidad generalmente se basa en la negligencia — a menudo demostrada mediante el conocimiento que el dueño tenía de las tendencias peligrosas del perro o la violación de una ordenanza local de correa o de control de animales, como el código animal del Título 10 del Condado de Clark, que contribuyó al ataque. La ley NRS 202.500 de Nevada, parte del código penal, también define a los perros 'peligrosos' y 'viciosos' y puede aportar evidencia poderosa en un caso civil de mordedura de perro cuando un perro tiene un historial de agresión seria.",
	},
];

const faqs = [
	{
		q: "¿Es Nevada un estado de responsabilidad estricta para las mordeduras de perro?",
		a: "Generalmente no. Nevada no tiene una ley amplia de responsabilidad estricta por mordeduras de perro que haga a los dueños automáticamente responsables de cada mordedura. La responsabilidad generalmente depende de la negligencia — la mayoría de las veces, del conocimiento que el dueño tenía del comportamiento peligroso del perro, o de la violación de una ordenanza local de correa o de control de animales que causó la mordedura.",
	},
	{
		q: "¿Qué es la 'regla de una mordedura'?",
		a: "Es un enfoque del derecho común que basa la responsabilidad en el conocimiento que el dueño tiene del comportamiento de su perro. El nombre es un poco engañoso — un dueño puede ser responsable desde la primera mordedura si tenía razones para saber que el perro podía ser peligroso (comportamiento agresivo previo, quejas, señales de advertencia). Y la regla no anula las violaciones de las leyes de correa, que pueden sustentar la responsabilidad sin importar el historial de mordeduras.",
	},
	{
		q: "¿Quién paga por mis lesiones en un caso de mordedura de perro en Nevada?",
		a: "Lo más común es el seguro de propietario de vivienda o de inquilino del dueño del perro. Cuando la mordedura ocurre en la propiedad de un tercero — una vivienda de alquiler, un hotel, un complejo de apartamentos — pueden aplicarse pólizas adicionales. Perseguimos cada fuente de cobertura disponible.",
	},
	{
		q: "¿Qué pasa si el perro nunca había mordido a nadie?",
		a: "Aun así puede tener un caso. El comportamiento agresivo sin llegar a la mordedura — gruñir, abalanzarse, embestir a las personas — puede poner sobre aviso al dueño. Una violación de la ley de correa crea una vía separada hacia la responsabilidad. Y la ley de perros peligrosos/viciosos de Nevada (NRS 202.500) es otra pieza del análisis cuando la conducta previa está documentada.",
	},
	{
		q: "¿Cuánto tiempo tengo para presentar un reclamo por mordedura de perro en Nevada?",
		a: "Dos años desde la fecha de la mordedura, según NRS 11.190. No espere — los registros de control de animales, los testigos y el historial del perro son más fáciles de asegurar temprano. Los reclamos que involucran a entidades gubernamentales pueden tener plazos de notificación mucho más cortos.",
	},
	{
		q: "¿Cuánto cuesta contratar a un abogado de mordeduras de perro?",
		a: "Nuestros honorarios son de contingencia — sin costo inicial y sin cobro por hora. Solo nos pagan si ganamos, y el honorario es un porcentaje de su recuperación, pactado por escrito antes de empezar.",
	},
];

const contactReasons = [
	{ text: "Evaluación de caso gratuita y sin compromiso", icon: checkCircleIcon },
	{ text: "Sin honorarios a menos que ganemos su caso", icon: circleDollarSignIcon },
	{ text: "Disponibles 24/7 — noches, fines de semana y días festivos", icon: clockIcon },
];

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		firmNode,
		{
			"@type": "LegalService",
			"@id": "https://ericblanklaw.com/es/areas-de-practica/mordeduras-de-perro#service",
			name: "Eric Blank Injury Attorneys — Representación en Mordeduras de Perro",
			serviceType: "Servicios Legales de Mordeduras de Perro",
			url: "https://ericblanklaw.com/es/areas-de-practica/mordeduras-de-perro",
			image: "https://ericblanklaw.com/Eric_Blank_Injury_Attorneys_Logo.png",
			priceRange: "Honorarios de Contingencia — Sin Honorarios a Menos Que Ganemos",
			inLanguage: "es",
			provider: { "@id": "https://ericblanklaw.com/#legalservice" },
			employee: { "@id": "https://ericblanklaw.com/#attorney" },
		},
		attorneyNode,
		{
			"@type": "FAQPage",
			"@id": "https://ericblanklaw.com/es/areas-de-practica/mordeduras-de-perro#faq",
			inLanguage: "es",
			mainEntity: faqs.map((faq) => ({
				"@type": "Question",
				name: faq.q,
				acceptedAnswer: { "@type": "Answer", text: faq.a },
			})),
		},
	],
};
---

<html lang="es">
	<head>
		<BaseHead
			title={title}
			description={description}
			canonical="https://ericblanklaw.com/es/areas-de-practica/mordeduras-de-perro"
			lang="es"
		/>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body class="overflow-x-clip">
		<Header lang="es" />
		<main>
			<!-- SECTION 1 — Hero -->
			<section class="relative bg-brand-navy text-white">
				<div class="absolute inset-0 bg-cover bg-center" style="background-image:url('/dog-bites-hero.jpeg')" aria-hidden="true"></div>
				<div class="absolute inset-0 bg-brand-navy/75" aria-hidden="true"></div>
				<div class="relative mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:py-24">
					<p class="text-sm font-semibold tracking-wider text-brand-gold uppercase">
						Mordeduras de Perro en Las Vegas
					</p>
					<h1 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-5xl">
						Abogado de Mordeduras de Perro en Las Vegas
					</h1>
					<p class="mx-auto mt-4 max-w-2xl text-base text-pretty text-white/70 sm:text-lg">
						Nevada no hace a los dueños de perros automáticamente responsables solo porque su
						perro mordió a alguien — pero eso no significa que queden libres de culpa. La
						responsabilidad depende de si el dueño sabía que el perro podía ser peligroso, de
						si violó ordenanzas de correa o de control de animales, y de si fue negligente de
						alguna otra manera. Por más de 26 años, Eric Blank Injury Attorneys ha manejado
						casos de mordeduras de perro en todo el Condado de Clark. Consulta gratuita, y sin
						honorarios a menos que ganemos.
					</p>
					<div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
						<a
							href="#contact"
							class="inline-flex w-full items-center justify-center rounded-md bg-brand-gold px-8 py-4 text-base font-bold text-brand-navy transition-colors hover:bg-[#d1a63b] sm:w-auto sm:text-lg"
						>
							Evaluación Gratuita de su Caso
						</a>
						<a
							href="tel:7022222115"
							class="inline-flex w-full items-center justify-center gap-2 rounded-md border border-white/30 px-8 py-4 text-base font-semibold text-white transition-colors hover:border-white hover:bg-white/10 sm:w-auto sm:text-lg"
						>
							<span class="[&>svg]:size-5" set:html={phoneIcon} aria-hidden="true" />
							(702) 222-2115
						</a>
					</div>
					<ul class="mx-auto mt-8 flex max-w-xl flex-wrap items-center justify-center gap-y-1 text-xs font-medium text-white/60 sm:text-sm">
						{
							heroTrust.map((item, index) => (
								<li
									class:list={[
										index > 0 &&
											"before:mx-2 before:text-brand-gold before:content-['•'] sm:before:mx-3",
									]}
								>
									{item}
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<!-- SECTION 2 — Trust strip -->
			<section class="border-b border-gray-200 bg-white">
				<div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
					<dl class="grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-4">
						{
							stats.map((stat) => (
								<div class="text-center">
									<dd class="text-3xl font-extrabold text-brand-navy sm:text-4xl">
										{stat.value}
									</dd>
									<dt class="mt-1 text-sm font-semibold text-gray-600">{stat.label}</dt>
									{stat.note && <p class="mt-0.5 text-xs text-gray-500">{stat.note}</p>}
								</div>
							))
						}
					</dl>
				</div>
			</section>

			<!-- SECTION 3 — What to do after a bite -->
			<section class="bg-white" aria-labelledby="steps-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Primeros Pasos
						</p>
						<h2
							id="steps-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Qué Hacer Después de una Mordedura de Perro en Las Vegas
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							Las primeras horas después de una mordedura definen todo su reclamo. Así puede
							protegerse usted y proteger su caso.
						</p>
					</div>
					<ol class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3">
						{
							steps.map((step, index) => (
								<li class="rounded-lg border border-gray-200 bg-white p-6">
									<div class="flex items-center gap-3">
										<span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-navy text-sm font-bold text-brand-gold">
											{index + 1}
										</span>
										<span
											class="text-brand-navy [&>svg]:size-7"
											set:html={step.icon}
											aria-hidden="true"
										/>
									</div>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{step.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{step.text}
									</p>
								</li>
							))
						}
					</ol>
				</div>
			</section>

			<!-- SECTION 4 — How we help -->
			<section class="bg-gray-50" aria-labelledby="help-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Nuestro Enfoque
						</p>
						<h2
							id="help-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Cómo Eric Blank Injury Attorneys Maneja los Casos de Mordeduras de Perro
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							Eric Blank pasó los primeros años de su carrera defendiendo a compañías de
							seguros. Aplicamos ese conocimiento interno a cada caso de mordedura de
							perro — la misma ventaja que usamos en toda nuestra{" "}
							<a
								href="/es/areas-de-practica"
								class="font-semibold text-brand-navy underline decoration-brand-gold decoration-2 underline-offset-2 transition-colors hover:decoration-brand-navy"
							>
								práctica de lesiones personales
							</a>.
						</p>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
						{
							howWeHelp.map((item) => (
								<div class="rounded-lg border border-gray-200 bg-white p-6">
									<span
										class="block text-brand-navy [&>svg]:size-10"
										set:html={item.icon}
										aria-hidden="true"
									/>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{item.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{item.text}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- SECTION 5 — What you can recover -->
			<section class="bg-white" aria-labelledby="damages-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Daños y Perjuicios
						</p>
						<h2
							id="damages-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Lo Que las Víctimas de Mordeduras de Perro Pueden Recuperar en Nevada
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							La ley de Nevada permite a las víctimas de lesiones recuperar daños
							compensatorios — tanto las pérdidas económicas concretas como el costo humano
							del ataque. En casos poco comunes de conducta especialmente imprudente,
							también pueden aplicarse daños punitivos.
						</p>
					</div>
					<div class="mx-auto mt-12 grid max-w-4xl grid-cols-1 gap-6 md:grid-cols-2 lg:mt-16">
						<div class="rounded-lg border border-gray-200 bg-white p-8">
							<h3 class="text-xl font-bold text-brand-navy">Daños Económicos</h3>
							<ul class="mt-5 space-y-3">
								{
									economicDamages.map((item) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-5"
												set:html={circleCheckIcon}
												aria-hidden="true"
											/>
											<span class="text-base text-gray-700">{item}</span>
										</li>
									))
								}
							</ul>
						</div>
						<div class="rounded-lg border border-gray-200 bg-white p-8">
							<h3 class="text-xl font-bold text-brand-navy">Daños No Económicos</h3>
							<ul class="mt-5 space-y-3">
								{
									nonEconomicDamages.map((item) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-5"
												set:html={circleCheckIcon}
												aria-hidden="true"
											/>
											<span class="text-base text-gray-700">{item}</span>
										</li>
									))
								}
							</ul>
						</div>
					</div>
					<p class="mx-auto mt-8 max-w-2xl text-center text-sm text-pretty text-gray-500">
						Nevada limita los daños en casos de negligencia médica pero <strong>no</strong> en
						los reclamos generales de lesiones personales. La cantidad que puede recuperar
						depende de los detalles de su caso — una{" "}
						<a
							href="/es/contacto"
							class="font-semibold text-brand-navy underline decoration-brand-gold decoration-2 underline-offset-2 transition-colors hover:decoration-brand-navy"
						>
							consulta gratuita
						</a>{" "}
						es la mejor manera de obtener una respuesta real.
					</p>
				</div>
			</section>

			<!-- SECTION 6 — Nevada law -->
			<section class="bg-gray-50" aria-labelledby="law-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Ley de Nevada
						</p>
						<h2
							id="law-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Leyes Clave de Nevada Sobre Mordeduras de Perro
						</h2>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3 lg:mt-16">
						{
							nevadaLaws.map((law) => (
								<div class="rounded-lg border border-gray-200 bg-white p-6">
									<span
										class="block text-brand-navy [&>svg]:size-10"
										set:html={law.icon}
										aria-hidden="true"
									/>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{law.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{law.text}
									</p>
								</div>
							))
						}
					</div>
					<p class="mx-auto mt-8 max-w-2xl text-center text-sm text-pretty text-gray-500">
						Esta es información general, no asesoramiento legal para su caso específico. Hable
						con un abogado sobre los hechos de su situación.
					</p>
				</div>
			</section>

			<!-- SECTION 7 — FAQ -->
			<section class="bg-white" aria-labelledby="faq-heading">
				<div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
					<div class="text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Preguntas Frecuentes
						</p>
						<h2
							id="faq-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Preguntas Comunes Sobre Mordeduras de Perro
						</h2>
					</div>
					<div class="mt-10 space-y-8 lg:mt-12">
						{
							faqs.map((faq) => (
								<div>
									<h3 class="text-lg font-bold text-brand-navy sm:text-xl">{faq.q}</h3>
									<p class="mt-2 text-base leading-relaxed text-pretty text-gray-600">
										{faq.a}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- SECTION 8 — Featured testimonial -->
			<section class="bg-gray-50">
				<div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20">
					<figure>
						<span
							aria-hidden="true"
							class="mx-auto block w-fit text-brand-navy/60 [&>svg]:size-10"
							set:html={quoteIcon}
						/>
						<blockquote class="mt-5 text-xl font-medium text-balance text-brand-navy sm:text-2xl">
							I had terrible injuries as a result of the accident I had and hiring Eric
							Blank to be on my side during this difficult process was the best thing I did.
						</blockquote>
						<figcaption class="mt-5 text-base font-bold text-brand-navy">— Tami</figcaption>
					</figure>
					<p class="mt-3 text-xs text-gray-500">Reseña original en inglés.</p>
					<a
						href="/es/resenas"
						class="mt-6 inline-block text-sm font-semibold text-brand-navy transition-colors hover:text-brand-gold"
					>
						Lea más reseñas de clientes →
					</a>
				</div>
			</section>

			<!-- Video testimonial carousel -->
			<TestimonialCarousel lang="es" />

			<!-- SECTION 9 — Final CTA + contact form -->
			<section
				id="contact"
				class="scroll-mt-24 bg-brand-navy text-white"
				aria-labelledby="cta-heading"
			>
				<div class="mx-auto max-w-[1200px] px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<h2
							id="cta-heading"
							class="text-3xl font-bold tracking-tight text-balance sm:text-4xl"
						>
							Solicite su Evaluación Gratuita de Caso
						</h2>
						<p class="mt-3 text-base text-pretty text-white/70 sm:text-lg">
							Es gratis, confidencial y sin compromiso.
						</p>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-start lg:gap-16">
						<div>
							<p class="text-sm font-semibold tracking-wider text-brand-gold uppercase">
								Por Qué Llamar Ahora
							</p>
							<h3 class="mt-3 text-xl font-bold sm:text-2xl">
								Tres Razones Para Contactarnos Hoy
							</h3>
							<ul class="mt-6 space-y-4">
								{
									contactReasons.map((reason) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-6"
												set:html={reason.icon}
												aria-hidden="true"
											/>
											<span class="text-base text-white/90 sm:text-lg">{reason.text}</span>
										</li>
									))
								}
							</ul>
							<p class="mt-6 max-w-md text-base text-pretty text-white/70">
								Los casos de mordeduras de perro en Nevada dependen del historial del perro
								y del conocimiento del dueño — evidencia que es más fácil asegurar
								temprano. Cuanto antes nos contacte, más podremos hacer.
							</p>
						</div>
						<ContactForm lang="es" />
					</div>
				</div>
			</section>
		</main>
		<Footer lang="es" />
		<!-- Universal media lightbox (used by the carousel) -->
		<Lightbox />
	</body>
</html>
