---
import '../../../styles/global.css';
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ContactForm from '../../../components/ContactForm.astro';
import TestimonialCarousel from '../../../components/TestimonialCarousel.astro';
import Lightbox from '../../../components/Lightbox.astro';
import { firmNode, attorneyNode } from '../../../data/firm';

import phoneIcon from 'lucide-static/icons/phone.svg?raw';
import shieldIcon from 'lucide-static/icons/shield.svg?raw';
import phoneCallIcon from 'lucide-static/icons/phone-call.svg?raw';
import cameraIcon from 'lucide-static/icons/camera.svg?raw';
import stethoscopeIcon from 'lucide-static/icons/stethoscope.svg?raw';
import banIcon from 'lucide-static/icons/ban.svg?raw';
import scaleIcon from 'lucide-static/icons/scale.svg?raw';
import searchIcon from 'lucide-static/icons/search.svg?raw';
import clipboardListIcon from 'lucide-static/icons/clipboard-list.svg?raw';
import handshakeIcon from 'lucide-static/icons/handshake.svg?raw';
import gavelIcon from 'lucide-static/icons/gavel.svg?raw';
import circleCheckIcon from 'lucide-static/icons/circle-check.svg?raw';
import calendarClockIcon from 'lucide-static/icons/calendar-clock.svg?raw';
import shieldCheckIcon from 'lucide-static/icons/shield-check.svg?raw';
import quoteIcon from 'lucide-static/icons/quote.svg?raw';
import checkCircleIcon from 'lucide-static/icons/check-circle.svg?raw';
import circleDollarSignIcon from 'lucide-static/icons/circle-dollar-sign.svg?raw';
import clockIcon from 'lucide-static/icons/clock.svg?raw';

const title = "Abogado de Accidentes de Motocicleta en Las Vegas | Eric Blank Injury Attorneys | (702) 222-2115";
const description =
	"¿Lesionado en un accidente de motocicleta en Las Vegas? Eric Blank Injury Attorneys ha combatido el prejuicio de las aseguradoras contra los motociclistas por más de 26 años. Consulta gratuita. Sin honorarios a menos que ganemos. Llame al (702) 222-2115.";

const heroTrust = ["Más de 26 Años", "Millones Recuperados", "Disponibles 24/7", "Consulta Gratuita"];

const stats = [
	{ value: "Millones", label: "Recuperados para Motociclistas Lesionados" },
	{ value: "Miles", label: "de Casos de Motocicleta Manejados" },
	{ value: "$0", label: "de Su Bolsillo", note: "Solo honorarios de contingencia" },
	{ value: "24/7", label: "Consulta Gratuita" },
];

const steps = [
	{
		icon: shieldIcon,
		title: "Póngase a Salvo",
		text: "Si puede moverse, salga de la carretera. Las motocicletas pueden derramar combustible después de un choque, así que ponga distancia entre usted y la moto. No se quite el casco ni el equipo de protección — los paramédicos lo necesitan para evaluar las lesiones de cabeza y cuello.",
	},
	{
		icon: phoneCallIcon,
		title: "Llame al 911",
		text: "Siempre obtenga un informe policial. En las calles de Las Vegas responde la Policía Metropolitana; en la I-15 y las autopistas, la Patrulla de Carreteras de Nevada. Asegúrese de que los testigos den sus declaraciones — el prejuicio contra los motociclistas es real, y el informe policial es donde primero aparece.",
	},
	{
		icon: cameraIcon,
		title: "Documente Todo",
		text: "Fotografíe la moto, el vehículo que lo golpeó, la carretera, su equipo y cualquier lesión visible. Obtenga los datos del seguro y la licencia del conductor, además de los nombres y teléfonos de los testigos.",
	},
	{
		icon: stethoscopeIcon,
		title: "Vea a un Médico",
		text: "Hágase evaluar aunque se sienta bien. La adrenalina oculta lesiones de cabeza, columna e internas que aparecen horas o días después. Un vacío en el tratamiento es lo primero que las aseguradoras usan para rebajar su reclamo.",
	},
	{
		icon: banIcon,
		title: "No Hable con la Aseguradora del Otro",
		text: "La aseguradora del otro conductor llamará rápido y sonará amable. No están de su lado — buscan cualquier declaración que encaje en la narrativa del 'motociclista imprudente'. Envíelos con su abogado.",
	},
	{
		icon: scaleIcon,
		title: "Llame Primero a un Abogado",
		text: "Antes de firmar cualquier cosa, aceptar cualquier oferta o dar una declaración grabada, hable con un abogado. Una vez que llega a un acuerdo, no puede reabrir el reclamo — aunque las lesiones resulten peores.",
	},
];

const howWeHelp = [
	{
		icon: searchIcon,
		title: "Investigamos el Accidente",
		text: "Actuamos rápido para preservar la evidencia — videos de cámaras de tráfico, fotos de la escena, su moto y declaraciones de testigos. El prejuicio contra los motociclistas se incrusta temprano en la narrativa; nosotros lo contrarrestamos con los hechos.",
	},
	{
		icon: clipboardListIcon,
		title: "Construimos el Expediente Médico",
		text: "Las lesiones de motocicleta tienen varias capas — abrasiones por fricción con el pavimento, fracturas, lesión cerebral traumática (TBI), daño de tejidos blandos — y a menudo requieren varios especialistas. Trabajamos con sus médicos para documentarlo todo, presente y futuro.",
	},
	{
		icon: handshakeIcon,
		title: "Negociamos con la Aseguradora",
		text: "Eric Blank pasó años del lado de la defensa de las aseguradoras. Sabemos cómo los ajustadores valoran los reclamos de motocicleta — y cómo intentan rebajarlos. Usamos ese conocimiento para exigir una cifra real.",
	},
	{
		icon: gavelIcon,
		title: "Llevamos el Caso a Juicio si Hace Falta",
		text: "Las aseguradoras negocian más en serio cuando saben que su abogado pondrá un caso de motocicleta frente a un jurado. Preparamos cada caso como si fuera a juicio.",
	},
];

const economicDamages = [
	"Gastos médicos — tratamiento pasado y futuro",
	"Salarios perdidos y reducción de su capacidad futura de ingresos",
	"Daños materiales a su motocicleta y su equipo",
	"Gastos de bolsillo — transporte, medicamentos y más",
];

const nonEconomicDamages = [
	"Dolor y sufrimiento",
	"Angustia emocional",
	"Pérdida del disfrute de la vida",
	"Discapacidad o desfiguración permanente",
	"Pérdida de consorcio",
];

const nevadaLaws = [
	{
		icon: calendarClockIcon,
		title: "Plazo de Prescripción",
		text: "Nevada le da 2 años desde la fecha del accidente para presentar una demanda por accidente de motocicleta (NRS 11.190). Si pasa ese plazo, su reclamo se pierde — sin importar lo sólido que fuera.",
	},
	{
		icon: scaleIcon,
		title: "Negligencia Comparativa",
		text: "En Nevada, usted no pierde su caso solo por haber tenido parte de la culpa. Siempre que su grado de culpa sea del 50% o menos, aún puede presentar un reclamo, pero su recuperación se reducirá según su porcentaje de culpa. Sin embargo, cuando la otra parte logra llevar su responsabilidad por encima del 50%, la regla de negligencia comparativa modificada de Nevada generalmente le impide recuperar compensación alguna (NRS 41.141).",
	},
	{
		icon: shieldCheckIcon,
		title: "Ley de Casco y Seguro",
		text: "Nevada exige que todos los motociclistas y sus pasajeros usen cascos aprobados por el DOT (NRS 486.231). Los límites mínimos de responsabilidad del conductor culpable son 25/50/20 — $25,000 por persona, $50,000 por accidente y $20,000 por daños materiales — lo cual a menudo es muy poco para lesiones graves de motocicleta. Por eso es fundamental tener una cobertura sólida de motorista sin seguro y con seguro insuficiente en su propia póliza de motocicleta o de auto.",
	},
];

const faqs = [
	{
		q: "¿No usar casco perjudica mi reclamo por accidente de motocicleta en Nevada?",
		a: "Nevada exige que todos los motociclistas y sus pasajeros usen cascos aprobados por el DOT según NRS 486.231. No usar casco puede darle a la compañía de seguros el argumento de que algunas de sus lesiones de cabeza se agravaron y de que su compensación por esas lesiones debería reducirse. Pero no impide automáticamente su reclamo ni cambia quién causó el choque — usted aún puede presentar un caso por la negligencia de un conductor imprudente aunque no llevara casco. Nuestro despacho ha manejado casos de motocicleta donde el uso del casco fue un tema en disputa y aun así recuperó compensación para motociclistas lesionados.",
	},
	{
		q: "¿Qué pasa si el conductor alega que 'no me vio'?",
		a: "Esa excusa aparece en casi todos los casos de motocicleta. Los conductores de Nevada tienen un deber de cuidado razonable hacia todos en la carretera, incluidos los motociclistas. 'No los vi' no es una defensa — es evidencia de falta de atención. La usamos en su contra, con el respaldo de videos de cámaras de tráfico, testigos y reconstrucción del accidente cuando hace falta.",
	},
	{
		q: "¿Cuánto cuesta contratar a un abogado de accidentes de motocicleta?",
		a: "Nuestros honorarios son de contingencia — sin costo inicial y sin cobro por hora. Solo nos pagan si ganamos su caso, y el honorario es un porcentaje de su acuerdo, pactado por escrito antes de empezar.",
	},
	{
		q: "¿Cuánto tiempo tengo para presentar un reclamo por accidente de motocicleta en Nevada?",
		a: "Dos años desde la fecha del accidente, según NRS 11.190. Los reclamos por muerte injusta también corren generalmente por dos años. Hay muy pocas excepciones, así que no espere — la evidencia y los testigos se desvanecen rápido.",
	},
	{
		q: "¿Qué pasa si el conductor culpable no tiene suficiente seguro?",
		a: "Muchos conductores de Nevada solo tienen el mínimo de 25/50/20 — que rara vez cubre una lesión grave de motocicleta. Analizamos cada fuente disponible: la cobertura de motorista sin seguro / con seguro insuficiente de su póliza, pólizas paraguas, la cobertura del empleador si el conductor estaba trabajando, y otras partes potencialmente responsables.",
	},
	{
		q: "¿Mi caso tendrá que ir a juicio?",
		a: "La mayoría de los casos se resuelven sin llegar a juicio. Pero las compañías de seguros pagan más cuando saben que su abogado está dispuesto y es capaz de llevar el caso a juicio — y Eric Blank lo está.",
	},
];

const contactReasons = [
	{ text: "Evaluación de caso gratuita y sin compromiso", icon: checkCircleIcon },
	{ text: "Sin honorarios a menos que ganemos su caso", icon: circleDollarSignIcon },
	{ text: "Disponibles 24/7 — noches, fines de semana y días festivos", icon: clockIcon },
];

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		firmNode,
		{
			"@type": "LegalService",
			"@id": "https://ericblanklaw.com/es/areas-de-practica/accidentes-de-motocicleta#service",
			name: "Eric Blank Injury Attorneys — Representación en Accidentes de Motocicleta",
			serviceType: "Servicios Legales de Accidentes de Motocicleta",
			url: "https://ericblanklaw.com/es/areas-de-practica/accidentes-de-motocicleta",
			image: "https://ericblanklaw.com/Eric_Blank_Injury_Attorneys_Logo.png",
			priceRange: "Honorarios de Contingencia — Sin Honorarios a Menos Que Ganemos",
			inLanguage: "es",
			provider: { "@id": "https://ericblanklaw.com/#legalservice" },
			employee: { "@id": "https://ericblanklaw.com/#attorney" },
		},
		attorneyNode,
		{
			"@type": "FAQPage",
			"@id": "https://ericblanklaw.com/es/areas-de-practica/accidentes-de-motocicleta#faq",
			inLanguage: "es",
			mainEntity: faqs.map((faq) => ({
				"@type": "Question",
				name: faq.q,
				acceptedAnswer: { "@type": "Answer", text: faq.a },
			})),
		},
	],
};
---

<html lang="es">
	<head>
		<BaseHead
			title={title}
			description={description}
			canonical="https://ericblanklaw.com/es/areas-de-practica/accidentes-de-motocicleta"
			lang="es"
		/>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body class="overflow-x-clip">
		<Header lang="es" />
		<main>
			<!-- SECTION 1 — Hero -->
			<section class="relative bg-brand-navy text-white">
				<div class="absolute inset-0 bg-cover bg-center" style="background-image:url('/motorcycle-accidents-hero.jpeg')" aria-hidden="true"></div>
				<div class="absolute inset-0 bg-brand-navy/75" aria-hidden="true"></div>
				<div class="relative mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:py-24">
					<p class="text-sm font-semibold tracking-wider text-brand-gold uppercase">
						Accidentes de Motocicleta en Las Vegas
					</p>
					<h1 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-5xl">
						Abogado de Accidentes de Motocicleta en Las Vegas
					</h1>
					<p class="mx-auto mt-4 max-w-2xl text-base text-pretty text-white/70 sm:text-lg">
						Manejar moto en Las Vegas significa de todo, desde la hora pico junto al Strip
						hasta largos recorridos por las autopistas del desierto — y cuando un conductor no
						lo ve, las consecuencias recaen casi por completo sobre el motociclista. Las
						compañías de seguros lo saben, y muchas cuentan con el prejuicio contra los
						motociclistas para presionar con ofertas bajas. Por más de 26 años, Eric Blank
						Injury Attorneys ha plantado cara. Consulta gratuita, y sin honorarios a menos que
						ganemos.
					</p>
					<div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
						<a
							href="#contact"
							class="inline-flex w-full items-center justify-center rounded-md bg-brand-gold px-8 py-4 text-base font-bold text-brand-navy transition-colors hover:bg-[#d1a63b] sm:w-auto sm:text-lg"
						>
							Evaluación Gratuita de su Caso
						</a>
						<a
							href="tel:7022222115"
							class="inline-flex w-full items-center justify-center gap-2 rounded-md border border-white/30 px-8 py-4 text-base font-semibold text-white transition-colors hover:border-white hover:bg-white/10 sm:w-auto sm:text-lg"
						>
							<span class="[&>svg]:size-5" set:html={phoneIcon} aria-hidden="true" />
							(702) 222-2115
						</a>
					</div>
					<ul class="mx-auto mt-8 flex max-w-xl flex-wrap items-center justify-center gap-y-1 text-xs font-medium text-white/60 sm:text-sm">
						{
							heroTrust.map((item, index) => (
								<li
									class:list={[
										index > 0 &&
											"before:mx-2 before:text-brand-gold before:content-['•'] sm:before:mx-3",
									]}
								>
									{item}
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<!-- SECTION 2 — Trust strip -->
			<section class="border-b border-gray-200 bg-white">
				<div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
					<dl class="grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-4">
						{
							stats.map((stat) => (
								<div class="text-center">
									<dd class="text-3xl font-extrabold text-brand-navy sm:text-4xl">
										{stat.value}
									</dd>
									<dt class="mt-1 text-sm font-semibold text-gray-600">{stat.label}</dt>
									{stat.note && <p class="mt-0.5 text-xs text-gray-500">{stat.note}</p>}
								</div>
							))
						}
					</dl>
				</div>
			</section>

			<!-- SECTION 3 — What to do after a crash -->
			<section class="bg-white" aria-labelledby="steps-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Primeros Pasos
						</p>
						<h2
							id="steps-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Qué Hacer Después de un Accidente de Motocicleta en Las Vegas
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							Las primeras horas después de un choque definen todo su reclamo. Así puede
							protegerse usted y proteger su caso.
						</p>
					</div>
					<ol class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3">
						{
							steps.map((step, index) => (
								<li class="rounded-lg border border-gray-200 bg-white p-6">
									<div class="flex items-center gap-3">
										<span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-navy text-sm font-bold text-brand-gold">
											{index + 1}
										</span>
										<span
											class="text-brand-navy [&>svg]:size-7"
											set:html={step.icon}
											aria-hidden="true"
										/>
									</div>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{step.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{step.text}
									</p>
								</li>
							))
						}
					</ol>
				</div>
			</section>

			<!-- SECTION 4 — How we help -->
			<section class="bg-gray-50" aria-labelledby="help-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Nuestro Enfoque
						</p>
						<h2
							id="help-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Cómo Eric Blank Injury Attorneys Maneja los Casos de Motocicleta
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							Eric Blank pasó los primeros años de su carrera defendiendo a compañías de
							seguros. Aplicamos ese conocimiento interno a cada reclamo de motocicleta —
							la misma ventaja que usamos en toda nuestra{" "}
							<a
								href="/es/areas-de-practica"
								class="font-semibold text-brand-navy underline decoration-brand-gold decoration-2 underline-offset-2 transition-colors hover:decoration-brand-navy"
							>
								práctica de lesiones personales
							</a>.
						</p>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
						{
							howWeHelp.map((item) => (
								<div class="rounded-lg border border-gray-200 bg-white p-6">
									<span
										class="block text-brand-navy [&>svg]:size-10"
										set:html={item.icon}
										aria-hidden="true"
									/>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{item.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{item.text}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- SECTION 5 — What you can recover -->
			<section class="bg-white" aria-labelledby="damages-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Daños y Perjuicios
						</p>
						<h2
							id="damages-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Lo Que las Víctimas de Accidentes de Motocicleta Pueden Recuperar en Nevada
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							La ley de Nevada permite a las víctimas de lesiones recuperar daños
							compensatorios — tanto las pérdidas económicas concretas como el costo humano
							del accidente. En casos poco comunes de conducta especialmente imprudente,
							también pueden aplicarse daños punitivos.
						</p>
					</div>
					<div class="mx-auto mt-12 grid max-w-4xl grid-cols-1 gap-6 md:grid-cols-2 lg:mt-16">
						<div class="rounded-lg border border-gray-200 bg-white p-8">
							<h3 class="text-xl font-bold text-brand-navy">Daños Económicos</h3>
							<ul class="mt-5 space-y-3">
								{
									economicDamages.map((item) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-5"
												set:html={circleCheckIcon}
												aria-hidden="true"
											/>
											<span class="text-base text-gray-700">{item}</span>
										</li>
									))
								}
							</ul>
						</div>
						<div class="rounded-lg border border-gray-200 bg-white p-8">
							<h3 class="text-xl font-bold text-brand-navy">Daños No Económicos</h3>
							<ul class="mt-5 space-y-3">
								{
									nonEconomicDamages.map((item) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-5"
												set:html={circleCheckIcon}
												aria-hidden="true"
											/>
											<span class="text-base text-gray-700">{item}</span>
										</li>
									))
								}
							</ul>
						</div>
					</div>
					<p class="mx-auto mt-8 max-w-2xl text-center text-sm text-pretty text-gray-500">
						Nevada limita los daños en casos de negligencia médica pero <strong>no</strong> en
						los reclamos generales de lesiones personales. La cantidad que puede recuperar
						depende de los detalles de su caso — una{" "}
						<a
							href="/es/contacto"
							class="font-semibold text-brand-navy underline decoration-brand-gold decoration-2 underline-offset-2 transition-colors hover:decoration-brand-navy"
						>
							consulta gratuita
						</a>{" "}
						es la mejor manera de obtener una respuesta real.
					</p>
				</div>
			</section>

			<!-- SECTION 6 — Nevada law -->
			<section class="bg-gray-50" aria-labelledby="law-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Ley de Nevada
						</p>
						<h2
							id="law-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Leyes Clave de Nevada Sobre Accidentes de Motocicleta
						</h2>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3 lg:mt-16">
						{
							nevadaLaws.map((law) => (
								<div class="rounded-lg border border-gray-200 bg-white p-6">
									<span
										class="block text-brand-navy [&>svg]:size-10"
										set:html={law.icon}
										aria-hidden="true"
									/>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{law.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{law.text}
									</p>
								</div>
							))
						}
					</div>
					<p class="mx-auto mt-8 max-w-2xl text-center text-sm text-pretty text-gray-500">
						Esta es información general, no asesoramiento legal para su caso específico. Hable
						con un abogado sobre los hechos de su accidente.
					</p>
				</div>
			</section>

			<!-- SECTION 7 — FAQ -->
			<section class="bg-white" aria-labelledby="faq-heading">
				<div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
					<div class="text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Preguntas Frecuentes
						</p>
						<h2
							id="faq-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Preguntas Comunes Sobre Accidentes de Motocicleta
						</h2>
					</div>
					<div class="mt-10 space-y-8 lg:mt-12">
						{
							faqs.map((faq) => (
								<div>
									<h3 class="text-lg font-bold text-brand-navy sm:text-xl">{faq.q}</h3>
									<p class="mt-2 text-base leading-relaxed text-pretty text-gray-600">
										{faq.a}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- SECTION 8 — Featured testimonial -->
			<section class="bg-gray-50">
				<div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20">
					<figure>
						<span
							aria-hidden="true"
							class="mx-auto block w-fit text-brand-navy/60 [&>svg]:size-10"
							set:html={quoteIcon}
						/>
						<blockquote class="mt-5 text-xl font-medium text-balance text-brand-navy sm:text-2xl">
							I had terrible injuries as a result of the accident I had and hiring Eric
							Blank to be on my side during this difficult process was the best thing I did.
						</blockquote>
						<figcaption class="mt-5 text-base font-bold text-brand-navy">— Tami</figcaption>
					</figure>
					<p class="mt-3 text-xs text-gray-500">Reseña original en inglés.</p>
					<a
						href="/es/resenas"
						class="mt-6 inline-block text-sm font-semibold text-brand-navy transition-colors hover:text-brand-gold"
					>
						Lea más reseñas de clientes →
					</a>
				</div>
			</section>

			<!-- Video testimonial carousel -->
			<TestimonialCarousel lang="es" />

			<!-- SECTION 9 — Final CTA + contact form -->
			<section
				id="contact"
				class="scroll-mt-24 bg-brand-navy text-white"
				aria-labelledby="cta-heading"
			>
				<div class="mx-auto max-w-[1200px] px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<h2
							id="cta-heading"
							class="text-3xl font-bold tracking-tight text-balance sm:text-4xl"
						>
							Solicite su Evaluación Gratuita de Caso
						</h2>
						<p class="mt-3 text-base text-pretty text-white/70 sm:text-lg">
							Es gratis, confidencial y sin compromiso.
						</p>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-start lg:gap-16">
						<div>
							<p class="text-sm font-semibold tracking-wider text-brand-gold uppercase">
								Por Qué Llamar Ahora
							</p>
							<h3 class="mt-3 text-xl font-bold sm:text-2xl">
								Tres Razones Para Contactarnos Hoy
							</h3>
							<ul class="mt-6 space-y-4">
								{
									contactReasons.map((reason) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-6"
												set:html={reason.icon}
												aria-hidden="true"
											/>
											<span class="text-base text-white/90 sm:text-lg">{reason.text}</span>
										</li>
									))
								}
							</ul>
							<p class="mt-6 max-w-md text-base text-pretty text-white/70">
								La mayoría de los reclamos por accidentes de motocicleta en Nevada tienen
								plazos estrictos — y la evidencia que los gana desaparece rápido. Cuanto
								antes nos contacte, más podremos hacer.
							</p>
						</div>
						<ContactForm lang="es" />
					</div>
				</div>
			</section>
		</main>
		<Footer lang="es" />
		<!-- Universal media lightbox (used by the carousel) -->
		<Lightbox />
	</body>
</html>
