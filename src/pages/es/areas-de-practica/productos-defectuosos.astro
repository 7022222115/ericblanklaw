---
import '../../../styles/global.css';
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ContactForm from '../../../components/ContactForm.astro';
import TestimonialCarousel from '../../../components/TestimonialCarousel.astro';
import Lightbox from '../../../components/Lightbox.astro';
import { firmNode, attorneyNode } from '../../../data/firm';

import phoneIcon from 'lucide-static/icons/phone.svg?raw';
import shieldIcon from 'lucide-static/icons/shield.svg?raw';
import phoneCallIcon from 'lucide-static/icons/phone-call.svg?raw';
import cameraIcon from 'lucide-static/icons/camera.svg?raw';
import stethoscopeIcon from 'lucide-static/icons/stethoscope.svg?raw';
import banIcon from 'lucide-static/icons/ban.svg?raw';
import scaleIcon from 'lucide-static/icons/scale.svg?raw';
import searchIcon from 'lucide-static/icons/search.svg?raw';
import clipboardListIcon from 'lucide-static/icons/clipboard-list.svg?raw';
import handshakeIcon from 'lucide-static/icons/handshake.svg?raw';
import gavelIcon from 'lucide-static/icons/gavel.svg?raw';
import circleCheckIcon from 'lucide-static/icons/circle-check.svg?raw';
import calendarClockIcon from 'lucide-static/icons/calendar-clock.svg?raw';
import shieldCheckIcon from 'lucide-static/icons/shield-check.svg?raw';
import quoteIcon from 'lucide-static/icons/quote.svg?raw';
import checkCircleIcon from 'lucide-static/icons/check-circle.svg?raw';
import circleDollarSignIcon from 'lucide-static/icons/circle-dollar-sign.svg?raw';
import clockIcon from 'lucide-static/icons/clock.svg?raw';

const title = "Abogado de Productos Defectuosos en Las Vegas | Eric Blank Injury Attorneys | (702) 222-2115";
const description =
	"¿Lesionado por un producto defectuoso? Eric Blank Injury Attorneys ha enfrentado a fabricantes y aseguradoras por más de 26 años. En Nevada, no tiene que probar negligencia — solo que el producto era defectuoso. Consulta gratuita. Llame al (702) 222-2115.";

const heroTrust = ["Más de 26 Años", "Millones Recuperados", "Disponibles 24/7", "Consulta Gratuita"];

const stats = [
	{ value: "Millones", label: "Recuperados para Víctimas de Accidentes" },
	{ value: "Miles", label: "de Casos de Lesiones Manejados" },
	{ value: "$0", label: "de Su Bolsillo", note: "Solo honorarios de contingencia" },
	{ value: "24/7", label: "Consulta Gratuita" },
];

const steps = [
	{
		icon: stethoscopeIcon,
		title: "Reciba Atención Médica",
		text: "Trate sus lesiones primero, y asegúrese de que queden documentadas. El expediente médico es lo que vincula su lesión con el producto que la causó.",
	},
	{
		icon: shieldIcon,
		title: "Conserve el Producto",
		text: "No lo tire, no lo repare ni lo devuelva. El producto defectuoso en sí es la pieza de evidencia más importante de su caso. Consérvelo exactamente como quedó.",
	},
	{
		icon: cameraIcon,
		title: "Guarde Todo lo Que Venía con Él",
		text: "Guarde el empaque, los recibos, los manuales, las etiquetas de advertencia y cualquier comprobante de compra. Fotografíe el producto y sus lesiones desde varios ángulos.",
	},
	{
		icon: clipboardListIcon,
		title: "Escriba lo Que Pasó",
		text: "Mientras está fresco, anote cómo estaba usando el producto, qué salió mal y quién lo presenció. La memoria se desvanece; las notas escritas no.",
	},
	{
		icon: banIcon,
		title: "No Hable con la Aseguradora del Fabricante",
		text: "Pueden ofrecerle un reembolso o un acuerdo rápido a cambio del producto o de una liberación de responsabilidad firmada. No entregue la evidencia ni firme nada — refiéralos a su abogado.",
	},
	{
		icon: scaleIcon,
		title: "Llame a un Abogado",
		text: "Los casos de productos dependen mucho de documentos y peritos. Cuanto antes intervenga un abogado, mejor se puede preservar y analizar la evidencia.",
	},
];

const howWeHelp = [
	{
		icon: searchIcon,
		title: "Preservamos y Analizamos el Producto",
		text: "Aseguramos el producto defectuoso y trabajamos con peritos en ingeniería y seguridad para identificar exactamente qué falló y por qué.",
	},
	{
		icon: clipboardListIcon,
		title: "Identificamos el Tipo de Defecto",
		text: "Defecto de diseño, defecto de fabricación o falta de advertencia — cada uno se prueba de forma distinta. Construimos el caso sobre la teoría correcta.",
	},
	{
		icon: handshakeIcon,
		title: "Rastreamos la Cadena de Suministro",
		text: "La responsabilidad puede alcanzar al fabricante, al distribuidor y al minorista. Identificamos a cada parte que puso el producto defectuoso en sus manos.",
	},
	{
		icon: gavelIcon,
		title: "Llevamos el Caso a Juicio si Hace Falta",
		text: "Los fabricantes tienen bolsillos profundos y abogados defensores agresivos. Preparamos cada caso como si fuera a presentarse ante un jurado.",
	},
];

const economicDamages = [
	"Gastos médicos — tratamiento pasado y futuro",
	"Salarios perdidos y reducción de su capacidad futura de ingresos",
	"Daños materiales a su vehículo",
	"Gastos de bolsillo — transporte, medicamentos y más",
];

const nonEconomicDamages = [
	"Dolor y sufrimiento",
	"Angustia emocional",
	"Pérdida del disfrute de la vida",
	"Discapacidad o desfiguración permanente",
	"Pérdida de consorcio",
];

const nevadaLaws = [
	{
		icon: shieldCheckIcon,
		title: "Responsabilidad Estricta: No Hay Que Probar Negligencia",
		text: "Nevada sigue la doctrina de la responsabilidad estricta del producto. Usted no tiene que probar que el fabricante fue descuidado — solo que el producto era defectuoso, que el defecto existía cuando salió de las manos de la empresa, que usted usó el producto de una manera razonablemente previsible y que el defecto causó su lesión.",
	},
	{
		icon: scaleIcon,
		title: "Las Cuatro Teorías Legales",
		text: "Un reclamo por producto en Nevada puede basarse en cualquiera de cuatro teorías: responsabilidad estricta, negligencia, incumplimiento de garantía, o tergiversación/fraude. El mismo producto defectuoso puede sustentar más de una. Alegamos las teorías que le dan a su caso la base más sólida.",
	},
	{
		icon: clipboardListIcon,
		title: "Quién Puede Ser Responsable",
		text: "La responsabilidad no se limita al fabricante. Bajo la ley de Nevada, un distribuidor o un minorista dedicado a la venta del producto también puede ser responsable. Eso importa cuando el fabricante está en el extranjero, cerró o es difícil de localizar.",
	},
	{
		icon: calendarClockIcon,
		title: "Plazo de Prescripción",
		text: "Nevada generalmente aplica un plazo de 2 años a los reclamos de lesiones personales, incluidos muchos casos de productos (NRS 11.190). En algunas situaciones, el plazo puede comenzar más tarde bajo la regla del descubrimiento si el defecto o la lesión no fue evidente de inmediato, lo que puede ocurrir en casos de exposición tóxica o de daño gradual. Como el cálculo del plazo puede depender de los hechos, lo mejor es hablar con un abogado lo antes posible.",
	},
];

const faqs = [
	{
		q: "¿Cuánto cuesta contratar a un abogado de productos defectuosos?",
		a: "Nuestros honorarios son de contingencia — sin costo inicial y sin cobro por hora. Solo nos pagan si ganamos su caso, y el honorario es un porcentaje de su acuerdo, pactado por escrito antes de empezar.",
	},
	{
		q: "¿Tengo que probar que la empresa fue negligente?",
		a: "No. Eso es lo que hace tan poderosa la ley de productos de Nevada para las víctimas de lesiones. Bajo la responsabilidad estricta solo necesita demostrar que el producto era defectuoso y que el defecto causó su lesión — no que la empresa fue descuidada.",
	},
	{
		q: "¿Cuáles son los tipos de defectos de producto?",
		a: "Generalmente tres: defectos de diseño, cuando el producto es peligroso tal como fue diseñado; defectos de fabricación, cuando algo salió mal en la producción; y falta de advertencia, cuando el producto implicaba un riesgo no evidente sin advertencias o instrucciones adecuadas.",
	},
	{
		q: "¿Qué debo hacer con el producto que me lesionó?",
		a: "Consérvelo, y no lo altere, repare ni devuelva. El producto en sí es su evidencia más importante. Guárdelo en un lugar seguro y llévelo a su consulta si puede.",
	},
	{
		q: "¿Cuánto tiempo tengo para presentar un reclamo por producto defectuoso en Nevada?",
		a: "Generalmente dos años desde la fecha de la lesión según NRS 11.190, aunque el plazo puede depender de cómo se plantee el reclamo, y la regla del descubrimiento puede aplicar si el defecto no se conoció de inmediato. No espere para pedir asesoría.",
	},
	{
		q: "¿Debo aceptar la oferta de acuerdo de la compañía de seguros?",
		a: "Si resultó lesionado por un producto defectuoso, no se apresure a firmar un acuerdo o una liberación de responsabilidad antes de hablar con un abogado. Los acuerdos generalmente se consideran definitivos, lo que significa que quizá no pueda reabrir su caso ni pedir compensación adicional después si su dolor aumenta, necesita más tratamiento o aparecen nuevos problemas.",
	},
];

const contactReasons = [
	{ text: "Evaluación de caso gratuita y sin compromiso", icon: checkCircleIcon },
	{ text: "Sin honorarios a menos que ganemos su caso", icon: circleDollarSignIcon },
	{ text: "Disponibles 24/7 — noches, fines de semana y días festivos", icon: clockIcon },
];

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		firmNode,
		{
			"@type": "LegalService",
			"@id": "https://ericblanklaw.com/es/areas-de-practica/productos-defectuosos#service",
			name: "Eric Blank Injury Attorneys — Representación en Productos Defectuosos",
			serviceType: "Servicios Legales de Productos Defectuosos",
			url: "https://ericblanklaw.com/es/areas-de-practica/productos-defectuosos",
			image: "https://ericblanklaw.com/Eric_Blank_Injury_Attorneys_Logo.png",
			priceRange: "Honorarios de Contingencia — Sin Honorarios a Menos Que Ganemos",
			inLanguage: "es",
			provider: { "@id": "https://ericblanklaw.com/#legalservice" },
			employee: { "@id": "https://ericblanklaw.com/#attorney" },
		},
		attorneyNode,
		{
			"@type": "FAQPage",
			"@id": "https://ericblanklaw.com/es/areas-de-practica/productos-defectuosos#faq",
			inLanguage: "es",
			mainEntity: faqs.map((faq) => ({
				"@type": "Question",
				name: faq.q,
				acceptedAnswer: { "@type": "Answer", text: faq.a },
			})),
		},
	],
};
---

<html lang="es">
	<head>
		<BaseHead
			title={title}
			description={description}
			canonical="https://ericblanklaw.com/es/areas-de-practica/productos-defectuosos"
			lang="es"
		/>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body class="overflow-x-clip">
		<Header lang="es" />
		<main>
			<!-- SECTION 1 — Hero -->
			<section class="relative bg-brand-navy text-white">
				<div class="absolute inset-0 bg-cover bg-center" style="background-image:url('/products-liability-hero.jpeg')" aria-hidden="true"></div>
				<div class="absolute inset-0 bg-brand-navy/75" aria-hidden="true"></div>
				<div class="relative mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:py-24">
					<p class="text-sm font-semibold tracking-wider text-brand-gold uppercase">
						Productos Defectuosos en Nevada
					</p>
					<h1 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-5xl">
						Abogado de Productos Defectuosos en Las Vegas
					</h1>
					<p class="mx-auto mt-4 max-w-2xl text-base text-pretty text-white/70 sm:text-lg">
						Usted confió en que el producto era seguro — una pieza de vehículo, un dispositivo
						médico, una herramienta eléctrica, un electrodoméstico, un producto para niños.
						Cuando un defecto causa una lesión grave, el fabricante y sus aseguradoras
						gastarán mucho para evitar la responsabilidad. Aquí la ley de Nevada está de su
						lado: usted no tiene que probar que la empresa fue descuidada, solo que el
						producto era defectuoso y que lo lesionó. Por más de 26 años, Eric Blank Injury
						Attorneys ha enfrentado a los fabricantes para que las víctimas de lesiones
						obtengan una recuperación completa. Consulta gratuita, y sin honorarios a menos
						que ganemos.
					</p>
					<div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
						<a
							href="#contact"
							class="inline-flex w-full items-center justify-center rounded-md bg-brand-gold px-8 py-4 text-base font-bold text-brand-navy transition-colors hover:bg-[#d1a63b] sm:w-auto sm:text-lg"
						>
							Evaluación Gratuita de su Caso
						</a>
						<a
							href="tel:7022222115"
							class="inline-flex w-full items-center justify-center gap-2 rounded-md border border-white/30 px-8 py-4 text-base font-semibold text-white transition-colors hover:border-white hover:bg-white/10 sm:w-auto sm:text-lg"
						>
							<span class="[&>svg]:size-5" set:html={phoneIcon} aria-hidden="true" />
							(702) 222-2115
						</a>
					</div>
					<ul class="mx-auto mt-8 flex max-w-xl flex-wrap items-center justify-center gap-y-1 text-xs font-medium text-white/60 sm:text-sm">
						{
							heroTrust.map((item, index) => (
								<li
									class:list={[
										index > 0 &&
											"before:mx-2 before:text-brand-gold before:content-['•'] sm:before:mx-3",
									]}
								>
									{item}
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<!-- SECTION 2 — Trust strip -->
			<section class="border-b border-gray-200 bg-white">
				<div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
					<dl class="grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-4">
						{
							stats.map((stat) => (
								<div class="text-center">
									<dd class="text-3xl font-extrabold text-brand-navy sm:text-4xl">
										{stat.value}
									</dd>
									<dt class="mt-1 text-sm font-semibold text-gray-600">{stat.label}</dt>
									{stat.note && <p class="mt-0.5 text-xs text-gray-500">{stat.note}</p>}
								</div>
							))
						}
					</dl>
				</div>
			</section>

			<!-- SECTION 3 — What to do after a crash -->
			<section class="bg-white" aria-labelledby="steps-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Primeros Pasos
						</p>
						<h2
							id="steps-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Qué Hacer Después de una Lesión por Producto Defectuoso
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							Un reclamo por lesión de producto se construye sobre la evidencia — sobre todo,
							el producto mismo. Así puede proteger su salud y su caso.
						</p>
					</div>
					<ol class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3">
						{
							steps.map((step, index) => (
								<li class="rounded-lg border border-gray-200 bg-white p-6">
									<div class="flex items-center gap-3">
										<span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-navy text-sm font-bold text-brand-gold">
											{index + 1}
										</span>
										<span
											class="text-brand-navy [&>svg]:size-7"
											set:html={step.icon}
											aria-hidden="true"
										/>
									</div>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{step.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{step.text}
									</p>
								</li>
							))
						}
					</ol>
				</div>
			</section>

			<!-- SECTION 4 — How we help -->
			<section class="bg-gray-50" aria-labelledby="help-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Nuestro Enfoque
						</p>
						<h2
							id="help-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Cómo Eric Blank Injury Attorneys Maneja los Casos de Productos Defectuosos
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							Eric Blank pasó los primeros años de su carrera defendiendo a compañías de
							seguros. Aplicamos ese conocimiento interno a cada caso de productos
							defectuosos — la misma ventaja que usamos en toda nuestra{" "}
							<a
								href="/es/areas-de-practica"
								class="font-semibold text-brand-navy underline decoration-brand-gold decoration-2 underline-offset-2 transition-colors hover:decoration-brand-navy"
							>
								práctica de lesiones personales
							</a>.
						</p>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
						{
							howWeHelp.map((item) => (
								<div class="rounded-lg border border-gray-200 bg-white p-6">
									<span
										class="block text-brand-navy [&>svg]:size-10"
										set:html={item.icon}
										aria-hidden="true"
									/>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{item.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{item.text}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- SECTION 5 — What you can recover -->
			<section class="bg-white" aria-labelledby="damages-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Daños y Perjuicios
						</p>
						<h2
							id="damages-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Lo Que las Víctimas de Productos Defectuosos Pueden Recuperar en Nevada
						</h2>
						<p class="mt-4 text-base text-pretty text-gray-600 sm:text-lg">
							La ley de Nevada permite a las víctimas de lesiones recuperar daños
							compensatorios — tanto las pérdidas económicas concretas como el costo humano
							del accidente. En casos poco comunes de conducta especialmente imprudente,
							también pueden aplicarse daños punitivos.
						</p>
					</div>
					<div class="mx-auto mt-12 grid max-w-4xl grid-cols-1 gap-6 md:grid-cols-2 lg:mt-16">
						<div class="rounded-lg border border-gray-200 bg-white p-8">
							<h3 class="text-xl font-bold text-brand-navy">Daños Económicos</h3>
							<ul class="mt-5 space-y-3">
								{
									economicDamages.map((item) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-5"
												set:html={circleCheckIcon}
												aria-hidden="true"
											/>
											<span class="text-base text-gray-700">{item}</span>
										</li>
									))
								}
							</ul>
						</div>
						<div class="rounded-lg border border-gray-200 bg-white p-8">
							<h3 class="text-xl font-bold text-brand-navy">Daños No Económicos</h3>
							<ul class="mt-5 space-y-3">
								{
									nonEconomicDamages.map((item) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-5"
												set:html={circleCheckIcon}
												aria-hidden="true"
											/>
											<span class="text-base text-gray-700">{item}</span>
										</li>
									))
								}
							</ul>
						</div>
					</div>
					<p class="mx-auto mt-8 max-w-2xl text-center text-sm text-pretty text-gray-500">
						Nevada limita los daños en casos de negligencia médica pero no en los reclamos
						generales de lesiones personales. En casos de productos que involucran conducta
						especialmente grave — por ejemplo, un fabricante que conocía un peligro y vendió
						el producto de todos modos — también pueden estar disponibles los daños punitivos,
						y Nevada no aplica su límite habitual de daños punitivos a los reclamos de
						productos defectuosos. Una{" "}
						<a
							href="/es/contacto"
							class="font-semibold text-brand-navy underline decoration-brand-gold decoration-2 underline-offset-2 transition-colors hover:decoration-brand-navy"
						>
							consulta gratuita
						</a>{" "}
						es la mejor manera de entender lo que su caso puede valer.
					</p>
				</div>
			</section>

			<!-- SECTION 6 — Nevada law -->
			<section class="bg-gray-50" aria-labelledby="law-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Ley de Nevada
						</p>
						<h2
							id="law-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Leyes Clave de Nevada Sobre Productos Defectuosos
						</h2>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4 lg:mt-16">
						{
							nevadaLaws.map((law) => (
								<div class="rounded-lg border border-gray-200 bg-white p-6">
									<span
										class="block text-brand-navy [&>svg]:size-10"
										set:html={law.icon}
										aria-hidden="true"
									/>
									<h3 class="mt-4 text-lg font-bold text-brand-navy">{law.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-pretty text-gray-600">
										{law.text}
									</p>
								</div>
							))
						}
					</div>
					<p class="mx-auto mt-8 max-w-2xl text-center text-sm text-pretty text-gray-500">
						Esta es información general, no asesoramiento legal para su caso específico. Hable
						con un abogado sobre los hechos de su accidente.
					</p>
				</div>
			</section>

			<!-- SECTION 7 — FAQ -->
			<section class="bg-white" aria-labelledby="faq-heading">
				<div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
					<div class="text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Preguntas Frecuentes
						</p>
						<h2
							id="faq-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Preguntas Comunes Sobre Productos Defectuosos
						</h2>
					</div>
					<div class="mt-10 space-y-8 lg:mt-12">
						{
							faqs.map((faq) => (
								<div>
									<h3 class="text-lg font-bold text-brand-navy sm:text-xl">{faq.q}</h3>
									<p class="mt-2 text-base leading-relaxed text-pretty text-gray-600">
										{faq.a}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- SECTION 8 — Featured testimonial -->
			<section class="bg-gray-50">
				<div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20">
					<figure>
						<span
							aria-hidden="true"
							class="mx-auto block w-fit text-brand-navy/60 [&>svg]:size-10"
							set:html={quoteIcon}
						/>
						<blockquote class="mt-5 text-xl font-medium text-balance text-brand-navy sm:text-2xl">
							I had terrible injuries as a result of the accident I had and hiring Eric
							Blank to be on my side during this difficult process was the best thing I did.
						</blockquote>
						<figcaption class="mt-5 text-base font-bold text-brand-navy">— Tami</figcaption>
					</figure>
					<p class="mt-3 text-xs text-gray-500">Reseña original en inglés.</p>
					<a
						href="/es/resenas"
						class="mt-6 inline-block text-sm font-semibold text-brand-navy transition-colors hover:text-brand-gold"
					>
						Lea más reseñas de clientes →
					</a>
				</div>
			</section>

			<!-- Video testimonial carousel -->
			<TestimonialCarousel lang="es" />

			<!-- SECTION 9 — Final CTA + contact form -->
			<section
				id="contact"
				class="scroll-mt-24 bg-brand-navy text-white"
				aria-labelledby="cta-heading"
			>
				<div class="mx-auto max-w-[1200px] px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-2xl text-center">
						<h2
							id="cta-heading"
							class="text-3xl font-bold tracking-tight text-balance sm:text-4xl"
						>
							Solicite su Evaluación Gratuita de Caso
						</h2>
						<p class="mt-3 text-base text-pretty text-white/70 sm:text-lg">
							Es gratis, confidencial y sin compromiso.
						</p>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-start lg:gap-16">
						<div>
							<p class="text-sm font-semibold tracking-wider text-brand-gold uppercase">
								Por Qué Llamar Ahora
							</p>
							<h3 class="mt-3 text-xl font-bold sm:text-2xl">
								Tres Razones Para Contactarnos Hoy
							</h3>
							<ul class="mt-6 space-y-4">
								{
									contactReasons.map((reason) => (
										<li class="flex items-start gap-3">
											<span
												class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-6"
												set:html={reason.icon}
												aria-hidden="true"
											/>
											<span class="text-base text-white/90 sm:text-lg">{reason.text}</span>
										</li>
									))
								}
							</ul>
							<p class="mt-6 max-w-md text-base text-pretty text-white/70">
								La mayoría de los reclamos por productos defectuosos en Nevada tienen plazos
								estrictos — y la evidencia que los gana desaparece rápido. Cuanto antes nos
								contacte, más podremos hacer.
							</p>
						</div>
						<ContactForm lang="es" />
					</div>
				</div>
			</section>
		</main>
		<Footer lang="es" />
		<!-- Universal media lightbox (used by the carousel) -->
		<Lightbox />
	</body>
</html>
