---
import '../../styles/global.css';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Contact from '../../components/Contact.astro';
import TestimonialCarousel from '../../components/TestimonialCarousel.astro';
import Lightbox from '../../components/Lightbox.astro';
import PracticeAreaGrid from '../../components/PracticeAreaGrid.astro';
---

<html lang="es">
	<head>
		<BaseHead
			title="Áreas de Práctica de Lesiones Personales en Las Vegas | Eric Blank Injury Attorneys"
			description="Eric Blank Injury Attorneys maneja accidentes de auto, accidentes de motocicleta, resbalones y caídas, mordeduras de perro, compensación laboral y más en todo Las Vegas y el Condado de Clark. Consulta gratuita. (702) 222-2115."
			canonical="https://ericblanklaw.com/es/areas-de-practica"
			lang="es"
		/>
	</head>
	<body class="overflow-x-clip">
		<Header lang="es" />
		<main>
			<!-- A: page hero -->
			<section class="relative bg-brand-navy text-white">
				<div class="absolute inset-0 bg-cover bg-center" style="background-image:url('/practice-areas-hero.jpg')" aria-hidden="true"></div>
				<div class="absolute inset-0 bg-brand-navy/75" aria-hidden="true"></div>
				<div class="relative mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:py-24">
					<p class="text-sm font-semibold tracking-wider text-brand-gold uppercase">
						Áreas de Práctica
					</p>
					<h1 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-5xl">
						Cómo Ayudamos a las Personas Lesionadas en Las Vegas
					</h1>
					<p class="mx-auto mt-4 max-w-2xl text-base text-pretty text-white/70 sm:text-lg">
						Desde accidentes de auto hasta casos de muerte injusta, nuestra firma maneja una
						amplia gama de asuntos de lesiones personales en todo el Condado de Clark. Si
						usted resultó lesionado, le ayudaremos a entender sus opciones.
					</p>
				</div>
			</section>

			<!-- B: full practice areas grid -->
			<section class="bg-gray-50">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-28">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							12 Áreas de Enfoque
						</p>
						<h2 class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl">
							Casos de Lesiones Personales Que Manejamos
						</h2>
					</div>
					<div class="mt-12 lg:mt-16">
						<PracticeAreaGrid lang="es" gridClass="grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4" />
					</div>
				</div>
			</section>

			<!-- C: don't see your case -->
			<section class="bg-white">
				<div class="mx-auto max-w-2xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:py-24">
					<h2 class="text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl">
						¿No Ve Su Tipo de Caso?
					</h2>
					<p class="mt-4 text-base leading-relaxed text-pretty text-gray-600 sm:text-lg">
						Manejamos muchos tipos de casos de lesiones personales más allá de los que
						aparecen aquí — incluyendo productos defectuosos, litigios masivos, acoso escolar
						y reclamos por productos peligrosos. Si no está seguro de tener un caso, lo más
						fácil es preguntar. Las consultas iniciales siempre son gratuitas.
					</p>
					<div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
						<a
							href="tel:7022222115"
							class="inline-flex w-full items-center justify-center rounded-md bg-brand-gold px-8 py-4 text-base font-bold text-brand-navy transition-colors hover:bg-[#d1a63b] sm:w-auto sm:text-lg"
						>
							Llame al (702) 222-2115
						</a>
						<a
							href="mailto:intake@ericblanklaw.com"
							class="font-semibold text-brand-navy underline decoration-brand-gold decoration-2 underline-offset-4 transition-colors hover:decoration-brand-navy"
						>
							intake@ericblanklaw.com
						</a>
					</div>
				</div>
			</section>

			<!-- D: contact form -->
			<!-- Video testimonial carousel -->
			<TestimonialCarousel lang="es" />

			<Contact lang="es" />
		</main>
		<Footer lang="es" />
		<!-- Universal media lightbox (used by the carousel) -->
		<Lightbox />
	</body>
</html>
