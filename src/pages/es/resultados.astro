---
import '../../styles/global.css';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Contact from '../../components/Contact.astro';
import TestimonialGallery from '../../components/TestimonialGallery.astro';
import Lightbox from '../../components/Lightbox.astro';
import shieldCheckIcon from 'lucide-static/icons/shield-check.svg?raw';
import gavelIcon from 'lucide-static/icons/gavel.svg?raw';
import heartHandshakeIcon from 'lucide-static/icons/heart-handshake.svg?raw';

const stats = [
	{ value: "Millones", label: "Recuperados para Víctimas de Accidentes" },
	{ value: "1,000+", label: "Casos Manejados" },
	{ value: "26+", label: "Años de Experiencia" },
	{ value: "98%", label: "Satisfacción de Clientes" },
];

const approach = [
	{
		title: "Conocimiento de las Aseguradoras",
		icon: shieldCheckIcon,
		text: "La trayectoria de Eric del lado de la defensa de las aseguradoras significa que sabemos cómo las compañías de seguros evalúan los reclamos — y exactamente dónde van a resistirse.",
	},
	{
		title: "Preparados para Llevar Cualquier Caso a Juicio",
		icon: gavelIcon,
		text: "Las compañías de seguros negocian más agresivamente cuando saben que su abogado está listo para el juicio. Nosotros siempre lo estamos.",
	},
	{
		title: "Atención Personalizada",
		icon: heartHandshakeIcon,
		text: "Cada cliente tiene acceso directo a su abogado. Sin centros de llamadas, sin evasivas, sin \"le respondemos la próxima semana.\"",
	},
];
---

<html lang="es">
	<head>
		<BaseHead
			title="Resultados y Enfoque | Eric Blank Injury Attorneys Las Vegas"
			description="Eric Blank Injury Attorneys ha recuperado millones en veredictos y acuerdos para clientes lesionados de Las Vegas durante más de 26 años. Conozca nuestro enfoque. Llame al (702) 222-2115 para una evaluación gratuita de su caso."
			canonical="https://ericblanklaw.com/es/resultados"
			lang="es"
		/>
	</head>
	<body class="overflow-x-clip">
		<Header lang="es" />
		<main>
			<!-- A + B: hero with track-record stats -->
			<section class="relative bg-brand-navy text-white">
				<div class="absolute inset-0 bg-cover bg-center" style="background-image:url('/results-hero.jpg')" aria-hidden="true"></div>
				<div class="absolute inset-0 bg-brand-navy/75" aria-hidden="true"></div>
				<div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
					<div class="mx-auto max-w-3xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-gold uppercase">
							Trayectoria
						</p>
						<h1 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-5xl">
							Décadas de Resultados para las Víctimas de Accidentes en Las Vegas
						</h1>
						<p class="mx-auto mt-4 max-w-2xl text-base text-pretty text-white/70 sm:text-lg">
							Por más de 26 años, Eric Blank Injury Attorneys ha luchado para maximizar la
							recuperación de los clientes lesionados por negligencia. Así abordamos cada
							caso — y esto es lo que hace posibles nuestros resultados.
						</p>
					</div>
					<dl class="mx-auto mt-12 grid max-w-4xl grid-cols-2 gap-x-8 gap-y-10 lg:mt-16 lg:max-w-none lg:grid-cols-4">
						{
							stats.map((stat) => (
								<div class="flex flex-col-reverse gap-2 text-center">
									<dt class="text-xs font-semibold tracking-wider text-white uppercase sm:text-sm">
										{stat.label}
									</dt>
									<dd class="text-4xl font-extrabold text-brand-gold sm:text-5xl lg:text-6xl">
										{stat.value}
									</dd>
								</div>
							))
						}
					</dl>
					<p class="mx-auto mt-12 max-w-2xl text-center text-sm text-pretty text-white/60">
						Los resultados pasados no garantizan resultados similares en casos futuros. Cada
						caso es único.
					</p>
				</div>
			</section>

			<!-- C: our approach -->
			<section class="bg-white" aria-labelledby="approach-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-28">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Cómo Ganamos
						</p>
						<h2
							id="approach-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Nuestro Enfoque
						</h2>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3 lg:mt-16">
						{
							approach.map((item) => (
								<div>
									<span
										class="block text-brand-navy [&>svg]:size-12"
										set:html={item.icon}
										aria-hidden="true"
									/>
									<h3 class="mt-5 text-xl font-bold text-brand-navy">{item.title}</h3>
									<p class="mt-2 text-base leading-relaxed text-pretty text-gray-600">
										{item.text}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- Video testimonial gallery -->
			<TestimonialGallery />

			<!-- D: small CTA -->
			<section class="bg-brand-navy text-white">
				<div class="mx-auto max-w-3xl px-4 py-14 text-center sm:px-6 sm:py-16">
					<h2 class="text-2xl font-bold tracking-tight text-balance sm:text-3xl">
						¿Se pregunta si tiene un caso? Hable con nosotros — es gratis.
					</h2>
					<div class="mt-7 flex flex-col items-center justify-center gap-4 sm:flex-row">
						<a
							href="tel:7022222115"
							class="inline-flex w-full items-center justify-center rounded-md bg-brand-gold px-8 py-4 text-base font-bold text-brand-navy transition-colors hover:bg-[#d1a63b] sm:w-auto sm:text-lg"
						>
							Llame al (702) 222-2115
						</a>
						<a
							href="mailto:intake@ericblanklaw.com"
							class="font-semibold text-white underline decoration-brand-gold decoration-2 underline-offset-4 transition-colors hover:text-brand-gold"
						>
							Escriba a intake@ericblanklaw.com
						</a>
					</div>
				</div>
			</section>

			<!-- E: contact form -->
			<Contact lang="es" />
		</main>
		<Footer lang="es" />

		<!-- Universal media lightbox (used by the video gallery) -->
		<Lightbox />
	</body>
</html>
