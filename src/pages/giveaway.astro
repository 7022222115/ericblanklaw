---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Giveaway rules template. Structure mirrors the legacy WordPress /chayannegiveaway/ page
// (2024, expired). Fill in `giveaway` + each section's `text` when a new giveaway runs,
// then set `active = true` (drops noindex; also remove '/giveaway' from the sitemap filter
// in astro.config.mjs).

const active = false;

const giveaway = {
  name: 'Giveaway',
  eyebrow: 'Eric Blank Injury Attorneys',
  intro:
    'There is no giveaway running right now. Follow us on Facebook and Instagram to hear about the next one first.',
};

const title = `${giveaway.name} | Eric Blank Injury Attorneys`;
const description = `Official rules, terms, and conditions for Eric Blank Injury Attorneys giveaways. Call (702) 222-2115 with questions.`;

const TBA = 'To be announced.';

const rules = [
  { heading: 'Eligibility', text: TBA },
  { heading: 'How to Enter', text: TBA },
  { heading: 'Entry Period', text: TBA },
  { heading: 'Prize', text: TBA },
  { heading: 'Winner Selection', text: TBA },
  { heading: 'Publicity', text: TBA },
  { heading: 'General Conditions', text: TBA },
  { heading: 'Release of Liability', text: TBA },
  { heading: 'Social Media Disclaimer', text: TBA },
  { heading: 'Privacy', text: TBA },
];
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} noindex={!active} />
  </head>
  <body class="overflow-x-clip">
    <Header />
    <main>
      <section class="bg-brand-navy text-white">
        <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20">
          <p class="text-sm font-semibold uppercase tracking-wide text-brand-gold">{giveaway.eyebrow}</p>
          <h1 class="mt-3 text-3xl font-bold sm:text-4xl">{giveaway.name}</h1>
          <p class="mx-auto mt-4 max-w-2xl text-base text-white/70 sm:text-lg">{giveaway.intro}</p>
          <div class="mt-6 flex flex-wrap justify-center gap-3">
            <a href="https://www.facebook.com/blanklawoffices/" target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/30 px-5 py-2 text-sm font-semibold transition-colors hover:border-brand-gold hover:text-brand-gold">Facebook</a>
            <a href="https://www.instagram.com/ericblankinjuryattorneys/" target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/30 px-5 py-2 text-sm font-semibold transition-colors hover:border-brand-gold hover:text-brand-gold">Instagram</a>
          </div>
        </div>
      </section>
      <section class="bg-white">
        <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
          <h2 class="text-2xl font-bold text-brand-navy">Official Rules, Terms &amp; Conditions</h2>
          <div class="mt-8 space-y-8 text-gray-600 leading-relaxed">
            {rules.map((r) => (
              <div>
                <h3 class="text-lg font-bold text-brand-navy">{r.heading}</h3>
                <p class="mt-2">{r.text}</p>
              </div>
            ))}
          </div>
          <p class="mt-12 text-sm text-gray-500">
            Questions about a giveaway? Call <a href="tel:+17022222115" class="font-semibold text-brand-navy underline">(702) 222-2115</a> or <a href="/contact/" class="font-semibold text-brand-navy underline">contact us</a>.
          </p>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
