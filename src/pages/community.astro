---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import heartHandshakeIcon from 'lucide-static/icons/heart-handshake.svg?raw';
import bikeIcon from 'lucide-static/icons/bike.svg?raw';
import shieldIcon from 'lucide-static/icons/shield.svg?raw';
// Brand icons (lucide-static carries no brand logos — same approach as Footer.astro)
const instagramIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077"/></svg>`;
const linkedinIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>`;

const title = 'Community Involvement | Eric Blank Injury Attorneys';
const description =
	'From Boys & Girls Club stages to Fremont Street fundraisers, the Eric Blank Injury Attorneys team shows up for Las Vegas — local kids, families, riders and first responders.';

const commitments = [
	{
		icon: heartHandshakeIcon,
		title: 'Las Vegas Kids & Families',
		text: 'We support the organizations helping Las Vegas kids grow up healthy, creative and cared for, including the Boys & Girls Clubs of Southern Nevada, the Nevada Childhood Cancer Foundation and Sunrise Children’s Hospital.',
	},
	{
		icon: bikeIcon,
		title: 'Riders & Road Safety',
		text: 'Many of the people we meet ride motorcycles and bikes, so we try to make the road a little safer — practical safety resources and a real presence in the local riding community.',
	},
	{
		icon: shieldIcon,
		title: 'Honoring Those Who Serve',
		text: 'We stand with the first responders who protect our city, and we’re proud to come together with our community to honor them.',
	},
];

const initiatives = [
	{
		title: 'A Song by Boys & Girls Club Members',
		meta: 'October 2026 · Boys & Girls Clubs of Southern Nevada',
		image: '/community/bgc-jingle-2026.webp',
		alt: 'Navy and gold announcement graphic: Eric Blank Injury Attorneys has a jingle, thanking the Boys & Girls Clubs of Southern Nevada',
		width: 1080,
		height: 1080,
		text: 'Four young members of the Boys & Girls Clubs of Southern Nevada wrote and performed an original jingle for our firm. Supporting groups that invest in the next generation has always mattered to us, and this project showed why: given room to create, these kids delivered. Thank you to the Clubs’ team for the partnership.',
		link: {
			href: 'https://www.instagram.com/reel/DeKbNiEAhVF/',
			label: 'Watch the reel on Instagram',
		},
	},
	{
		title: '“Rider Down” Safety Cards',
		meta: 'September 2026 · Humpday Rides, Main Street',
		image: '/community/rider-down-humpday-2026.webp',
		alt: 'Wallet-sized Rider Down bicycle and e-bike crash guide card, and two riders at the nighttime Humpday Rides meetup on Main Street',
		width: 1000,
		height: 1063,
		text: 'Riders kept telling us they weren’t sure what to do right after a crash with a vehicle. So we created wallet-sized “Rider Down” cards with general steps to consider, and handed them out at the weekly Humpday Rides on Main Street.',
	},
	{
		title: 'Honoring First Responders on 9/11’s 25th Anniversary',
		meta: 'September 2026 · Hogs & Heifers',
		image: '/community/first-responders-911-2026.webp',
		alt: 'Two smiling attendees at the indoor 9/11 tribute gathering, with a memorial wall of first responder portraits behind them',
		width: 1000,
		height: 1294,
		text: 'As proud sponsors of Hogs & Heifers, our team joined the community after the downtown tribute march marking 25 years since 9/11. It was a moving day spent alongside the first responders who risk their lives for others.',
	},
	{
		title: 'Boys & Girls Club Sneaker Ball',
		meta: 'September 2026 · Boys & Girls Club',
		image: '/community/sneaker-ball-2026.webp',
		alt: 'Three attendees in dress clothes and sneakers on a Boys & Girls Club gym floor at the annual Sneaker Ball',
		width: 1000,
		height: 1175,
		text: 'We joined community leaders at the annual Sneaker Ball, an evening that raises support for the Boys & Girls Club and opportunities for local youth. Thank you to the Club’s leadership and team for hosting — and for the work they do every day.',
	},
	{
		title: 'Holiday Support for Local Families',
		meta: 'December 2025 · Hogs & Heifers · Nevada Childhood Cancer Foundation · Sunrise Children’s Hospital',
		image: '/community/holiday-families-2025.webp',
		alt: 'Eric Blank Injury Attorneys team member at the firm’s outdoor event table stocked with gifts and giveaways',
		width: 893,
		height: 1192,
		text: 'Through our partnership with Hogs & Heifers, we spent a holiday weekend benefiting the Nevada Childhood Cancer Foundation and Sunrise Children’s Hospital. Our team greeted families and handed out gift cards and holiday goodies to local families in need.',
	},
	{
		title: 'East Las Vegas Back to School Event',
		meta: 'July 2025 · 96.7 La Campesina',
		image: '/community/back-to-school-2025.webp',
		alt: 'A family with a young child in a paper crown at the Eric Blank Injury Attorneys table during the East Las Vegas Back to School event',
		width: 985,
		height: 1178,
		text: 'We joined 96.7 La Campesina at its East Las Vegas Back to School event to help families start the school year ready. The turnout was incredible, and we loved spending the day with our neighbors.',
	},
];

const socials = [
	{
		label: 'Instagram',
		href: 'https://www.instagram.com/ericblankinjuryattorneys/',
		icon: instagramIcon,
	},
	{
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/company/eric-blank-injury-attorneys',
		icon: linkedinIcon,
	},
];
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body class="overflow-x-clip">
		<Header />
		<main>
			<!-- A: page hero -->
			<!-- Placeholder hero image (Dec 2025 Hogs & Heifers table photo) — swap for a wide team event photo when one exists. -->
			<section class="relative bg-brand-navy text-white">
				<div
					class="absolute inset-0 bg-cover bg-[center_30%]"
					style="background-image:url('/community/holiday-families-2025.webp')"
					aria-hidden="true"
				>
				</div>
				<div class="absolute inset-0 bg-brand-navy/80" aria-hidden="true"></div>
				<div class="relative mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:py-24">
					<p class="text-sm font-semibold tracking-wider text-brand-gold uppercase">
						In The Community
					</p>
					<h1 class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-5xl">
						Where You'll Find Us When We're Not in the Office
					</h1>
					<p class="mx-auto mt-4 max-w-2xl text-base text-pretty text-white/70 sm:text-lg">
						From Boys &amp; Girls Club stages to Fremont Street fundraisers, the Eric Blank
						Injury Attorneys team spends time where our neighbors are: with local kids,
						families, riders and first responders.
					</p>
				</div>
			</section>

			<!-- B: our commitment -->
			<section class="bg-white">
				<div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20">
					<h2 class="text-3xl font-bold tracking-tight text-brand-navy sm:text-4xl">
						Our Commitment
					</h2>
					<blockquote class="mt-6 border-l-4 border-brand-gold pl-6 text-left">
						<p class="text-lg leading-relaxed text-pretty text-gray-600 sm:text-xl">
							When our community does well, we all do. That's why our team keeps showing up.
							We practice law and fight for what our clients deserve &mdash; but being active in
							our community is something we always make time for.
						</p>
					</blockquote>
				</div>
			</section>

			<!-- C: where we show up -->
			<section class="bg-gray-50" aria-labelledby="showup-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
					<div class="mx-auto max-w-2xl text-center">
						<h2
							id="showup-heading"
							class="text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							Where We Show Up
						</h2>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
						{
							commitments.map((item) => (
								<div class="rounded-lg border border-gray-200 bg-white p-6">
									<span
										class="inline-flex text-brand-gold [&>svg]:size-8"
										set:html={item.icon}
										aria-hidden="true"
									/>
									<h3 class="mt-4 text-xl font-bold text-brand-navy">{item.title}</h3>
									<p class="mt-3 text-base leading-relaxed text-pretty text-gray-600">
										{item.text}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- D: featured initiatives -->
			<section class="bg-white" aria-labelledby="initiatives-heading">
				<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-28">
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-sm font-semibold tracking-wider text-brand-navy uppercase">
							Featured Initiatives
						</p>
						<h2
							id="initiatives-heading"
							class="mt-3 text-3xl font-bold tracking-tight text-balance text-brand-navy sm:text-4xl"
						>
							What We've Been Up To
						</h2>
					</div>
					<div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3">
						{
							initiatives.map((item) => (
								<article class="flex flex-col overflow-hidden rounded-lg border border-gray-200 bg-white">
									<img
										src={item.image}
										alt={item.alt}
										width={item.width}
										height={item.height}
										loading="lazy"
										class="aspect-[4/5] w-full bg-brand-navy object-cover object-top"
									/>
									<div class="flex flex-1 flex-col p-6">
										<p class="text-xs font-semibold tracking-wide text-brand-gold uppercase">
											{item.meta}
										</p>
										<h3 class="mt-2 text-xl font-bold text-brand-navy">{item.title}</h3>
										<p class="mt-3 text-base leading-relaxed text-pretty text-gray-600">
											{item.text}
										</p>
										{item.link && (
											<a
												href={item.link.href}
												target="_blank"
												rel="noopener"
												class="mt-auto inline-flex items-center gap-1 pt-5 text-sm font-bold text-brand-navy transition-colors hover:text-brand-gold"
											>
												{item.link.label}
												<svg
													class="size-4"
													viewBox="0 0 24 24"
													fill="none"
													stroke="currentColor"
													stroke-width="2"
													stroke-linecap="round"
													stroke-linejoin="round"
													aria-hidden="true"
												>
													<path d="M5 12h14" />
													<path d="m13 6 6 6-6 6" />
												</svg>
											</a>
										)}
									</div>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<!-- E: closing CTA -->
			<section class="bg-brand-navy text-white">
				<div class="mx-auto max-w-3xl px-4 py-14 text-center sm:px-6 sm:py-16">
					<h2 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">
						Let's Do More Good Together
					</h2>
					<p class="mt-3 text-base text-white/70 sm:text-lg">
						Follow along as we keep showing up for Las Vegas.
					</p>
					<div class="mt-7 flex flex-wrap items-center justify-center gap-4">
						{
							socials.map((social) => (
								<a
									href={social.href}
									target="_blank"
									rel="noopener"
									class="inline-flex items-center gap-2 rounded-lg bg-brand-gold px-6 py-3 text-base font-extrabold text-brand-navy transition-colors hover:bg-[#d1a63b]"
								>
									<span class="[&>svg]:size-5" set:html={social.icon} aria-hidden="true" />
									{social.label}
								</a>
							))
						}
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
