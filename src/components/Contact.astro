---
import checkCircleIcon from "lucide-static/icons/check-circle.svg?raw";
import circleDollarSignIcon from "lucide-static/icons/circle-dollar-sign.svg?raw";
import clockIcon from "lucide-static/icons/clock.svg?raw";
import ContactForm from "./ContactForm.astro";

interface Props {
	lang?: "en" | "es";
}

const { lang = "en" } = Astro.props as Props;

const reasons =
	lang === "es"
		? [
				{ text: "Evaluación de caso gratuita y sin compromiso", icon: checkCircleIcon },
				{ text: "Sin honorarios a menos que ganemos su caso", icon: circleDollarSignIcon },
				{ text: "Disponibles 24/7 — noches, fines de semana y días festivos", icon: clockIcon },
			]
		: [
				{ text: "Free, no-obligation case review", icon: checkCircleIcon },
				{ text: "No fees unless we win your case", icon: circleDollarSignIcon },
				{ text: "Available 24/7 — nights, weekends, holidays", icon: clockIcon },
			];

const t =
	lang === "es"
		? {
				h2: "Solicite su Evaluación Gratuita de Caso",
				sub: "Es gratis, confidencial y sin compromiso.",
				eyebrow: "Por Qué Llamar Ahora",
				h3: "Tres Razones Para Contactarnos Hoy",
				deadline: "La mayoría de los casos de lesiones personales tienen plazos estrictos. Cuanto antes nos contacte, más opciones tendremos para luchar por lo que le corresponde.",
			}
		: {
				h2: "Request Your Free Case Review",
				sub: "It's free, confidential, and there's no obligation.",
				eyebrow: "Why Call Now",
				h3: "Three Reasons To Reach Out Today",
				deadline: "Most personal injury cases have strict deadlines. The sooner we hear from you, the more options we have to fight for what you're owed.",
			};
---

<section
	id="contact"
	class="scroll-mt-24 bg-brand-navy text-white"
	aria-labelledby="contact-heading"
>
	<div class="mx-auto max-w-[1200px] px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
		<div class="mx-auto max-w-2xl text-center">
			<h2
				id="contact-heading"
				class="text-3xl font-bold tracking-tight text-balance sm:text-4xl"
			>
				{t.h2}
			</h2>
			<p class="mt-3 text-base text-pretty text-white/70 sm:text-lg">
				{t.sub}
			</p>
		</div>

		<div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-start lg:gap-16">
			<!-- LEFT: why call now -->
			<div>
				<p class="text-sm font-semibold tracking-wider text-brand-gold uppercase">
					{t.eyebrow}
				</p>
				<h3 class="mt-3 text-xl font-bold sm:text-2xl">
					{t.h3}
				</h3>
				<ul class="mt-6 space-y-4">
					{
						reasons.map((reason) => (
							<li class="flex items-start gap-3">
								<span
									class="mt-0.5 shrink-0 text-brand-gold [&>svg]:size-6"
									set:html={reason.icon}
									aria-hidden="true"
								/>
								<span class="text-base text-white/90 sm:text-lg">{reason.text}</span>
							</li>
						))
					}
				</ul>
				<p class="mt-6 max-w-md text-base text-pretty text-white/70">
					{t.deadline}
				</p>
			</div>

			<!-- RIGHT: call-back form -->
			<ContactForm lang={lang} />
		</div>
	</div>
</section>
