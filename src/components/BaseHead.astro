---
import { altFor } from "../data/i18n";

interface Props {
	title: string;
	description: string;
	canonical?: string;
	ogImage?: string;
	ogType?: string;
	noindex?: boolean;
	lang?: "en" | "es";
}

const {
	title,
	description,
	canonical,
	ogImage = "/og-default.jpg",
	ogType = "website",
	noindex = false,
	lang = "en",
} = Astro.props;

let canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
// Directory-format build: the trailing-slash URL is the 200-status canonical.
// Add a trailing slash unless the path already ends in "/" or in a file
// extension (e.g. .xml, .pdf).
const canonicalParsed = new URL(canonicalURL);
const canonicalLastSegment = canonicalParsed.pathname.split("/").pop() ?? "";
if (!canonicalParsed.pathname.endsWith("/") && !canonicalLastSegment.includes(".")) {
	canonicalParsed.pathname += "/";
	canonicalURL = canonicalParsed.href;
}
const ogImageURL = new URL(ogImage, Astro.site).href;
const siteName = "Eric Blank Injury Attorneys";
const ogLocale = lang === "es" ? "es_US" : "en_US";

// Bidirectional hreflang pair — emitted automatically on any page (either
// language) whose path is in the i18n route map. x-default points at English.
const alt = altFor(Astro.url.pathname);
const hreflangEn = alt ? new URL(alt.en, Astro.site).href : null;
const hreflangEs = alt ? new URL(alt.es, Astro.site).href : null;
const robotsContent = noindex
	? "noindex, nofollow"
	: "index, follow, max-snippet:-1, max-video-preview:-1, max-image-preview:large";
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{hreflangEn && <link rel="alternate" hreflang="en" href={hreflangEn} />}
{hreflangEs && <link rel="alternate" hreflang="es" href={hreflangEs} />}
{hreflangEn && <link rel="alternate" hreflang="x-default" href={hreflangEn} />}
<meta name="robots" content={robotsContent} />
<meta name="theme-color" content="#0F1E3D" />

<!-- Favicon -->
<link rel="icon" type="image/png" href="/Eric_Blank_Injury_Attorneys_Logo.png" />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={ogLocale} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

<!-- Meta Pixel -->
<script is:inline>
!function(f,b,e,v,n,t,s)
{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
n.callMethod.apply(n,arguments):n.queue.push(arguments)};
if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
n.queue=[];t=b.createElement(e);t.async=!0;
t.src=v;s=b.getElementsByTagName(e)[0];
s.parentNode.insertBefore(t,s)}(window, document,'script',
'https://connect.facebook.net/en_US/fbevents.js');
fbq('init', '302011373727563');
fbq('track', 'PageView');
</script>
<noscript><img height="1" width="1" style="display:none"
src="https://www.facebook.com/tr?id=302011373727563&ev=PageView&noscript=1"
/></noscript>
